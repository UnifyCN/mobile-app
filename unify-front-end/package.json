{
  "name": "unify-front-end",
  "main": "expo-router/entry",
  "version": "1.6.0",
  "scripts": {
    "eas-build-pre-install": "if [ -n \"$GOOGLE_SERVICES_JSON\" ]; then cp \"$GOOGLE_SERVICES_JSON\" android/app/google-services.json; fi",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "test:ci": "jest __tests__ --runInBand --watchAll=false",
    "lint": "expo lint",
    "check-i18n": "node ./scripts/check-i18n-parity.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx}\"",
    "sync-sanity-modules": "npx tsx scripts/sync-sanity-modules.ts"
  },
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "^@react-native-async-storage/async-storage$": "<rootDir>/node_modules/@react-native-async-storage/async-storage/jest/async-storage-mock.js"
    }
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-get-random-values"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-month-year-picker"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "dependencies": {
    "@expo-google-fonts/funnel-sans": "^0.4.2",
    "@expo/vector-icons": "^15.1.1",
    "@legendapp/list": "^2.0.19",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.0.0",
    "@sanity/client": "7.22.0",
    "@supabase/supabase-js": "^2.50.4",
    "@tanstack/react-query": "^5.83.0",
    "dayjs": "^1.11.19",
    "expo": "~55.0.17",
    "expo-apple-authentication": "~55.0.13",
    "expo-application": "~55.0.14",
    "expo-build-properties": "~55.0.18",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.14",
    "expo-dev-client": "~55.0.28",
    "expo-device": "~55.0.15",
    "expo-file-system": "~55.0.16",
    "expo-font": "~55.0.6",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.9",
    "expo-image-picker": "~55.0.19",
    "expo-linear-gradient": "~55.0.13",
    "expo-linking": "~55.0.14",
    "expo-localization": "~55.0.13",
    "expo-notifications": "~55.0.20",
    "expo-router": "~55.0.13",
    "expo-secure-store": "~55.0.13",
    "expo-splash-screen": "~55.0.19",
    "expo-status-bar": "~55.0.5",
    "expo-store-review": "~55.0.13",
    "expo-system-ui": "~55.0.16",
    "expo-tracking-transparency": "~55.0.13",
    "expo-updates": "~55.0.21",
    "expo-web-browser": "~55.0.16",
    "generate-random-username": "^2.0.1",
    "i18next": "^23.16.8",
    "lucide-react-native": "^1.8.0",
    "or": "^0.2.0",
    "posthog-react-native": "^4.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "^7.67.0",
    "react-i18next": "^14.1.3",
    "react-native": "0.83.6",
    "react-native-circular-progress-indicator": "^4.4.2",
    "react-native-confetti-cannon": "^1.5.2",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-elements": "^3.4.3",
    "react-native-enriched": "^0.6.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-get-random-values": "~2.0.0",
    "react-native-keyboard-controller": "1.20.7",
    "react-native-month-year-picker": "^1.9.0",
    "react-native-paper": "^5.15.1",
    "react-native-reanimated": "4.2.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.2",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "^0.7.4",
    "supabase": "^2.84.10"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "@tootallnate/once": "^3.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@tsconfig/node18": "^18.2.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.12.3",
    "@types/react": "~19.2.10",
    "@types/react-dom": "~19.2.0",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~55.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~55.0.16",
    "prettier": "^3.6.2",
    "promptfoo": "^0.121.11",
    "react-native-svg-transformer": "^1.5.1",
    "react-test-renderer": "^19.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
