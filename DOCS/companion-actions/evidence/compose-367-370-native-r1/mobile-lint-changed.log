/ would re-run the screen's effects without end.\nconst mockRefreshStage = jest.fn().mockResolvedValue(undefined);\nconst mockApplyConfirmedArrival = jest.fn();\njest.mock('@/hooks/onboarding/useUserStage', () => ({\n  useUserStage: () => ({\n    currentStage: 1,\n    stageChanged: false,\n    arrivalDate: null,\n    userId: mockUserId,\n    refreshStage: mockRefreshStage,\n    applyConfirmedArrival: mockApplyConfirmedArrival,\n    isLoading: false,\n  }),\n}));\njest.mock('@/hooks/checklist/useRefreshingToday', () => ({\n  useRefreshingToday: () => new Date(2026, 9, 23, 12, 0, 0),\n}));\nconst mockRefreshUser = jest.fn();\njest.mock('@/context/UserContext', () => ({\n  useCurrentUser: () => ({\n    currentUser: { id: mockUserId, isPremium: false },\n    refreshUser: mockRefreshUser,\n  }),\n}));\n// Conversation, generation and allowance hooks are not under test here.\nlet mockMessageCount = 0;\njest.mock('@/hooks/companion/useConversationMessages', () => ({\n  useConversationMessages: () => ({ data: [], isLoading: false }),\n}));\njest.mock('@/hooks/companion/useChatbotUsage', () => ({\n  useChatbotUsage: () => ({ data: { message_count: mockMessageCount } }),\n}));\njest.mock('@/hooks/companion/useCompanionReviewPrompt', () => ({\n  useCompanionReviewPrompt: () => {},\n}));\njest.mock('@/hooks/companion/usePersonalizedStarters', () => ({\n  usePersonalizedStarters: () => ({ data: undefined }),\n}));\nconst mockSendMessage = jest.fn();\njest.mock('@/hooks/companion/useSendMessage', () => ({\n  useSendMessage: () => ({\n    sendMessage: mockSendMessage,\n    isLoading: false,\n    isWaitingForBot: false,\n    lastSuggestedNextSteps: [],\n    lastVerified: null,\n    streamingBotMessage: null,\n  }),\n}));\njest.mock('@/utils/gemini', () => ({\n  AICompanionBusyError: class extends Error {},\n  AICompanionLimitError: class extends Error {},\n}));\njest.mock('@/context/ToastContext', () => ({\n  useToast: () => ({ showToast: jest.fn() }),\n}));\njest.mock('@/components/companion/AnimatedDottedBackground', () => ({\n  AnimatedDottedBackground: () => null,\n}));\njest.mock('@/components/companion/StarterPrompts', () => ({\n  StarterPrompts: () => null,\n}));\njest.mock('@/components/companion/PartnerSpotlightBanner', () => () => null);\njest.mock('@/components/icons/SendIcon.svg', () => () => null);\njest.mock('lucide-react-native', () => ({ History: () => null, Plus: () => null }));\njest.mock('@/components/common/BottomSheet', () => ({\n  __esModule: true,\n  default: () => null,\n}));\njest.mock('react-native-safe-area-context', () => ({\n  useSafeAreaInsets: () => ({ top: 0, bottom: 0, left: 0, right: 0 }),\n}));\njest.mock('@/hooks/sanity/useSanityLanguage', () => ({\n  useSanityLanguage: () => 'en',\n}));\njest.mock('@/lib/supabase', () => ({\n  supabase: {\n    auth: {\n      getUser: async () => ({ data: { user: { id: mockUserId } } }),\n      getSession: async () => ({\n        data: {\n          session: {\n            user: { id: mockUserId },\n            access_token: mockJwts.get(mockUserId),\n          },\n        },\n      }),\n      onAuthStateChange: (listener: (event: string, session: unknown) => void) => {\n        mockAuthListeners.add(listener);\n        return {\n          data: { subscription: { unsubscribe: () => mockAuthListeners.delete(listener) } },\n        };\n      },\n    },\n  },\n}));\njest.mock('@/services/onboarding/getOnboardingProfile', () => ({\n  getOnboardingProfile: jest.fn(async () => ({\n    persona: 'international_student',\n    province: 'British Columbia',\n  })),\n}));\njest.mock('@/sanity-custom', () => ({\n  sanityClient: {\n    fetch: jest.fn(async () => [\n      {\n        _id: 'sin',\n        _type: 'checklist',\n        title: 'Get a SIN',\n        class: 'do_now',\n        class_order: 1,\n      },\n    ]),\n  },\n}));\njest.mock('@/services/checklist/getUserTasks', () => ({\n  getUserTasks: jest.fn().mockResolvedValue([]),\n}));\njest.mock('@/services/checklist/customChecklistTasks', () => ({\n  getCustomChecklistTasks: jest.fn().mockResolvedValue([]),\n  deleteCustomChecklistTask: jest.fn(),\n  setCustomChecklistTaskCompletion: jest.fn(),\n}));\njest.mock('@/services/checklist/checklistTaskOrder', () => ({\n  getChecklistTaskOrders: jest.fn().mockResolvedValue([]),\n  upsertChecklistTaskOrder: jest.fn(),\n}));\njest.mock('@/services/checklist/setChecklistItemCompletion', () => ({\n  setChecklistItemCompletion: jest.fn(),\n}));\njest.mock('@/services/checklist/setChecklistItemDismissed', () => ({\n  setChecklistItemDismissed: jest.fn(),\n}));\njest.mock('@/components/home/HomeHeader', () => () => null);\njest.mock('@/components/LoadingScreen', () => () => null);\njest.mock('@/components/partners/SpotlightRow', () => () => null);\n\nimport ChecklistScreen from '@/app/(tabs)/Checklist/index';\nimport CompanionScreen from '@/app/(tabs)/companion/index';\nimport { TaskActionsSheet } from '@/components/companion/tasks/TaskActionsSheet';\n\nfunction testI18n() {\n  const i18n = createInstance();\n  void i18n.use(initReactI18next).init({\n    lng: 'en',\n    resources: { en: { translation: en } },\n    interpolation: { escapeValue: false },\n    initImmediate: false,\n  });\n  return i18n;\n}\n\nconst clients: QueryClient[] = [];\nfunction mount(node: React.ReactElement) {\n  // A new query client per mount: nothing is shared but the server.\n  const client = createTestQueryClient({\n    defaultOptions: { queries: { retry: false, gcTime: Infinity } },\n  });\n  clients.push(client);\n  return render(\n    <QueryClientProvider client={client}>\n      <I18nextProvider i18n={testI18n()}>{node}</I18nextProvider>\n    </QueryClientProvider>\n  );\n}\n\nconst realFetch: typeof fetch = (globalThis as any).__realFetch ?? global.fetch;\n\nasync function http(pathname: string, init: RequestInit & { key?: string; jwt?: string }) {\n  const res = await realFetch(`${API_URL}${pathname}`, {\n    ...init,\n    headers: {\n      'content-type': 'application/json',\n      apikey: init.key ?? ANON_KEY,\n      authorization: `Bearer ${init.jwt ?? init.key ?? ANON_KEY}`,\n      ...(init.headers as Record<string, string> | undefined),\n    },\n  });\n  const text = await res.text();\n  return { status: res.status, json: text ? JSON.parse(text) : null };\n}\n\nfunction psql(sqlText: string) {\n  execFileSync(\n    'docker',\n    ['exec', '-i', DB_CONTAINER, 'psql', '-v', 'ON_ERROR_STOP=1', '-q', '-U', 'postgres', '-d', 'postgres'],\n    { input: sqlText, stdio: ['pipe', 'pipe', 'pipe'] }\n  );\n}\n\nasync function newAccount(label: string) {\n  const email = `${label}-${Date.now()}@mobile361.invalid`;\n  const password = 'mobile-actions-1';\n  const created = await http('/auth/v1/admin/users', {\n    method: 'POST',\n    key: SERVICE_KEY,\n    body: JSON.stringify({ email, password, email_confirm: true }),\n  });\n  if (created.status !== 200) throw new Error(`createUser ${created.status}`);\n  const token = await http('/auth/v1/token?grant_type=password', {\n    method: 'POST',\n    body: JSON.stringify({ email, password }),\n  });\n  if (token.status !== 200) throw new Error(`signIn ${token.status}`);\n  mockJwts.set(created.json.id, token.json.access_token);\n  return { id: created.json.id as string, jwt: token.json.access_token as string };\n}\n\nconst actions = (jwt: string, body: Record<string, unknown>, platform = 'web') =>\n  http('/functions/v1/companion-actions', {\n    method: 'POST',\n    jwt,\n    body: JSON.stringify({\n      contract_version: 1,\n      client: { platform, app_version: 'test' },\n      ...body,\n    }),\n  });\n\nconst describeStack = enabled ? describe : describe.skip;\n\ndescribeStack('Task progress against the real local stack (mobile)', () => {\n  beforeAll(async () => {\n    const gate = await http('/rest/v1/companion_feature_gate?select=enabled', {\n      method: 'GET',\n      key: SERVICE_KEY,\n    });\n    // This repo's migration files, exactly as they ship, in timestamp order (#361, #363,\n    // #364, #366, #365, #370, #367), each only when the stack does not have it yet.\n    const migration = (file: string) =>\n      psql(fs.readFileSync(path.resolve(__dirname, '../../supabase/migrations', file), 'utf8'));\n    const hasFunction = (signature: string) =>\n      execFileSync(\n        'docker',\n        ['exec', '-i', DB_CONTAINER, 'psql', '-tA', '-U', 'postgres', '-d', 'postgres', '-c',\n          `select to_regprocedure('${signature}') is not null`],\n        { stdio: ['pipe', 'pipe', 'pipe'] }\n      ).toString().trim() === 't';\n    if (gate.status !== 200) migration('20261025235536_companion_task_actions.sql');\n    if (!hasFunction('public.companion_prepare_proposal(uuid,jsonb,jsonb)'))\n      migration('20261026165156_companion_task_create.sql');\n    if (!hasFunction('public.companion_plans_read(uuid)'))\n      migration('20261027183338_companion_settlement_plan.sql');\n    if (!hasFunction('public.companion_read_steps(uuid)'))\n      migration('20261027183644_companion_task_steps.sql');\n    if (!hasFunction('public.companion_prepare_edit(uuid,jsonb,jsonb,text)'))\n      migration('20261028001530_companion_task_edit.sql');\n    if (!hasFunction('public.companion_read_details(uuid)'))\n      migration('20261028004902_companion_saved_details.sql');\n    if (!hasFunction('public.companion_remove_prepare(uuid,text,jsonb)'))\n      migration('20261028025026_companion_task_remove.sql');\n    psql(`update public.companion_feature_gate set enabled = true, min_contract_version = 1,\n            max_contract_version = 1, allowed_platforms = '{ios,android,web}';`);\n    execFileSync('docker', ['kill', '--signal=SIGUSR1', REST_CONTAINER], { stdio: 'ignore' });\n    for (let i = 0; i < 50; i++) {\n      const ready = await http('/rest/v1/rpc/companion_read_tasks', {\n        method: 'POST',\n        key: SERVICE_KEY,\n        body: JSON.stringify({ p_user_id: '00000000-0000-0000-0000-000000000000' }),\n      });\n      if (ready.status === 200) break;\n      await new Promise(resolve => setTimeout(resolve, 200));\n    }\n    global.fetch = realFetch;\n  }, 60_000);\n\n  afterEach(() => {\n    clients.splice(0).forEach(client => client.clear());\n  });\n\n  it('a state and waiting reason saved in the mobile Checklist are the same record in Companion, on web and in the legacy table; another account sees nothing', async () => {\n    const owner = await newAccount('owner');\n    const stranger = await newAccount('stranger');\n    mockUserId = owner.id;\n    mockCapture = jest.fn();\n\n    const checklist = mount(<ChecklistScreen />);\n    fireEvent.press(await screen.findByText('Get a SIN'));\n    fireEvent.press(await screen.findByRole('button', { name: 'Track progress' }));\n    const notStarted = await screen.findByRole('radio', { name: 'Not started' });\n    await waitFor(() => expect(notStarted).toBeSelected());\n    await waitFor(() =>\n      expect(screen.getByRole('radio', { name: 'Waiting' })).not.toBeDisabled()\n    );\n    fireEvent.press(screen.getByRole('radio', { name: 'Waiting' }));\n    expect(\n      await screen.findByText('Changed from Not started to Waiting', {}, { timeout: 10_000 })\n    ).toBeTruthy();\n    fireEvent.changeText(\n      await screen.findByLabelText('What are you waiting for?'),\n      'A letter from Service Canada'\n    );\n    await waitFor(() =>\n      expect(screen.getByRole('button', { name: 'Save waiting reason' })).not.toBeDisabled()\n    );\n    fireEvent.press(screen.getByRole('button', { name: 'Save waiting reason' }));\n    await waitFor(\n      () => expect(screen.queryByText('Saving…')).toBeNull(),\n      { timeout: 10_000 }\n    );\n    checklist.unmount();\n\n    // The web client reads the same saved record through the same boundary.\n    const web = await actions(owner.jwt, { action: 'read' });\n    expect(web.status).toBe(200);\n    const sin = web.json.tasks.find((t: any) => t.task_ref === 'sanity:sin');\n    expect(sin).toMatchObject({\n      state: 'waiting',\n      waiting_reason: 'A letter from Service Canada',\n      removed: false,\n    });\n    expect(sin.last_receipt).toMatchObject({ before_state: 'waiting', after_state: 'waiting', current: true });\n\n    // The legacy Checklist row an older client reads: still open, same identity.\n    const legacy = await http(\n      `/rest/v1/user_tasks?select=sanity_checklist_id,completed,dismissed_at&sanity_checklist_id=eq.sin`,\n      { method: 'GET', jwt: owner.jwt }\n    );\n    expect(legacy.json).toEqual([{ sanity_checklist_id: 'sin', completed: false, dismissed_at: null }]);\n\n    // Another account sees none of it.\n    const other = await actions(stranger.jwt, { action: 'read' });\n    expect(other.status).toBe(200);\n    expect(other.json.tasks).toEqual([]);\n\n    // A new Companion mount (a later conversation) shows the saved progress.\n    mount(<CompanionScreen />);\n    const entry = await screen.findByRole('button', { name: /Your tasks/ });\n    await waitFor(\n      () => expect(within(entry).getByText('In progress: 0 · Waiting: 1')).toBeTruthy(),\n      { timeout: 10_000 }\n    );\n    fireEvent.press(entry);\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await within(sheet).findByRole('button', { name: /Get a SIN/ }));\n    const reason = await within(sheet).findByLabelText('What are you waiting for?');\n    expect(reason.props.value).toBe('A letter from Service Canada');\n\n    // Undo of the newest receipt restores Waiting with no reason, through the real service.\n    await waitFor(() =>\n      expect(within(sheet).getByRole('button', { name: 'Undo this change' })).not.toBeDisabled()\n    );\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Undo this change' }));\n    expect(\n      await within(sheet).findByText(\n        'Undid a change. The task is back to Waiting.',\n        {},\n        { timeout: 10_000 }\n      )\n    ).toBeTruthy();\n    const after = await actions(owner.jwt, { action: 'read' });\n    expect(after.json.tasks.find((t: any) => t.task_ref === 'sanity:sin')).toMatchObject({\n      state: 'waiting',\n      waiting_reason: null,\n    });\n  }, 60_000);\n});\n\n// ------------------------------------------------------------------ #366 task steps\n// The same real stack with the #363 and #366 migrations of this repo applied. A new step\n// under a content-backed task needs its published document: the edge runtime asks the\n// content stand-in below (ACTIONS_CONTENT_PORT, see the web repo's run.sh).\nconst CONTENT_PORT = Number(process.env.ACTIONS_CONTENT_PORT ?? '60675');\n\nfunction startContentStandIn(published: string[]) {\n  const server = require('http').createServer((req: any, res: any) => {\n    const url = new URL(req.url, 'http://stand-in');\n    let id: unknown = null;\n    try {\n      id = JSON.parse(url.searchParams.get('$id') ?? 'null');\n    } catch {\n      id = null;\n    }\n    res.setHeader('content-type', 'application/json');\n    res.end(JSON.stringify({ result: typeof id === 'string' && published.includes(id) ? id : null }));\n  });\n  return new Promise<{ close: () => Promise<void> }>(resolve =>\n    server.listen(CONTENT_PORT, '127.0.0.1', () =>\n      resolve({ close: () => new Promise<void>(done => server.close(() => done())) })\n    )\n  );\n}\n\nconst SIN_STEPS = [\n  'Review the official requirements',\n  'Prepare the required documents',\n  'Submit the application yourself',\n];\n\nasync function openChecklistTask() {\n  fireEvent.press(await screen.findByText('Get a SIN'));\n  fireEvent.press(await screen.findByRole('button', { name: 'Track progress' }));\n  const input = await screen.findByLabelText('New step');\n  await waitFor(() => expect(screen.getByRole('button', { name: 'Add step' })).toBeTruthy());\n  return input;\n}\n\nasync function addStepThroughControl(title: string) {\n  fireEvent.changeText(screen.getByLabelText('New step'), title);\n  await waitFor(() => expect(screen.getByRole('button', { name: 'Add step' })).not.toBeDisabled(), {\n    timeout: 10_000,\n  });\n  fireEvent.press(screen.getByRole('button', { name: 'Add step' }));\n  return screen.findByRole('checkbox', { name: title }, { timeout: 10_000 });\n}\n\nasync function toggle(title: string, checked: boolean) {\n  await waitFor(() => expect(screen.getByRole('checkbox', { name: title })).not.toBeDisabled(), {\n    timeout: 10_000,\n  });\n  fireEvent.press(screen.getByRole('checkbox', { name: title }));\n  await waitFor(\n    () =>\n      checked\n        ? expect(screen.getByRole('checkbox', { name: title })).toBeChecked()\n        : expect(screen.getByRole('checkbox', { name: title })).not.toBeChecked(),\n    { timeout: 10_000 }\n  );\n}\n\nconst stepsOf = (json: any, ref: string) =>\n  (json.steps ?? []).filter((s: any) => s.task_ref === ref).map((s: any) => [s.title, s.done]);\n\ndescribeStack('Task steps against the real local stack (mobile, #366)', () => {\n  let content: { close: () => Promise<void> };\n  beforeAll(async () => {\n    const steps = await http('/rest/v1/rpc/companion_read_steps', {\n      method: 'POST',\n      key: SERVICE_KEY,\n      body: JSON.stringify({ p_user_id: '00000000-0000-0000-0000-000000000000' }),\n    });\n    if (steps.status !== 200) {\n      // This repo's migrations, exactly as they ship.\n      for (const file of ['20261026165156_companion_task_create.sql', '20261027183644_companion_task_steps.sql']) {\n        psql(fs.readFileSync(path.resolve(__dirname, '../../supabase/migrations', file), 'utf8'));\n      }\n      execFileSync('docker', ['kill', '--signal=SIGUSR1', REST_CONTAINER], { stdio: 'ignore' });\n      for (let i = 0; i < 50; i++) {\n        const ready = await http('/rest/v1/rpc/companion_read_steps', {\n          method: 'POST',\n          key: SERVICE_KEY,\n          body: JSON.stringify({ p_user_id: '00000000-0000-0000-0000-000000000000' }),\n        });\n        if (ready.status === 200) break;\n        await new Promise(resolve => setTimeout(resolve, 200));\n      }\n    }\n    content = await startContentStandIn(['sin']);\n  }, 60_000);\n\n  afterAll(async () => {\n    await content?.close();\n  });\n\n  afterEach(() => {\n    clients.splice(0).forEach(client => client.clear());\n  });\n\n  it('steps added and checked in the mobile Checklist never complete the task; explicit completion keeps the unfinished step; Companion, web and a new mount read the same steps; another account sees none', async () => {\n    // Wrong if: a step is missing from another surface, checking every step changes the\n    // task, completion marks the unfinished step done, or another account reads a step.\n    const owner = await newAccount('steps-owner');\n    const stranger = await newAccount('steps-stranger');\n    mockUserId = owner.id;\n    mockCapture = jest.fn();\n\n    const checklist = mount(<ChecklistScreen />);\n    await openChecklistTask();\n    for (const title of SIN_STEPS) await addStepThroughControl(title);\n    expect(screen.getByLabelText('New step').props.value).toBe('');\n    for (const title of SIN_STEPS) await toggle(title, true);\n    expect(\n      await screen.findByText('All steps are done. This task stays Not started until you mark it complete.')\n    ).toBeTruthy();\n    expect(screen.getByRole('button', { name: 'Mark task complete' })).toBeTruthy();\n    expect(screen.getByRole('radio', { name: 'Not started' })).toBeSelected();\n\n    await toggle(SIN_STEPS[2], false);\n    expect(screen.queryByRole('button', { name: 'Mark task complete' })).toBeNull();\n    await waitFor(() => expect(screen.getByRole('radio', { name: 'Completed' })).not.toBeDisabled(), {\n      timeout: 10_000,\n    });\n    fireEvent.press(screen.getByRole('radio', { name: 'Completed' }));\n    expect(await screen.findByText('Completed with 2 of 3 steps done.', {}, { timeout: 10_000 })).toBeTruthy();\n    await waitFor(() => expect(screen.getByRole('checkbox', { name: SIN_STEPS[2] })).toBeDisabled());\n    checklist.unmount();\n\n    const web = await actions(owner.jwt, { action: 'read' });\n    expect(web.json.tasks.find((t: any) => t.task_ref === 'sanity:sin')).toMatchObject({ state: 'completed' });\n    expect(stepsOf(web.json, 'sanity:sin')).toEqual([\n      [SIN_STEPS[0], true],\n      [SIN_STEPS[1], true],\n      [SIN_STEPS[2], false],\n    ]);\n    const other = await actions(stranger.jwt, { action: 'read' });\n    expect(other.json.steps).toEqual([]);\n\n    // A later Companion mount (another conversation) reads the same saved steps.\n    mount(<CompanionScreen />);\n    fireEvent.press(await screen.findByRole('button', { name: /Your tasks/ }));\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await within(sheet).findByRole('button', { name: /Get a SIN/ }));\n    expect(await within(sheet).findByText('Completed with 2 of 3 steps done.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(within(sheet).getByRole('checkbox', { name: SIN_STEPS[0] })).toBeChecked();\n    expect(within(sheet).getByRole('checkbox', { name: SIN_STEPS[2] })).not.toBeChecked();\n  }, 90_000);\n\n  it('removing a step asks first; Keep changes nothing; Remove and its Undo go through the real service; the offered completion completes the task', async () => {\n    // Wrong if: a step is removed without confirmation, Keep sends a write, the Undo does\n    // not restore the step, or the offered completion does not save Completed.\n    const owner = await newAccount('steps-remove');\n    mockUserId = owner.id;\n    mockCapture = jest.fn();\n    mount(<ChecklistScreen />);\n    await openChecklistTask();\n    await addStepThroughControl('Bring two IDs');\n    await addStepThroughControl('Choose a bank');\n\n    fireEvent.press(screen.getByRole('button', { name: 'Remove step: Bring two IDs' }));\n    expect(await screen.findByText('Remove “Bring two IDs”?')).toBeTruthy();\n    fireEvent.press(screen.getByRole('button', { name: 'Keep step' }));\n    expect(screen.getByRole('checkbox', { name: 'Bring two IDs' })).toBeTruthy();\n    expect(stepsOf((await actions(owner.jwt, { action: 'read' })).json, 'sanity:sin')).toHaveLength(2);\n\n    fireEvent.press(screen.getByRole('button', { name: 'Remove step: Bring two IDs' }));\n    fireEvent.press(await screen.findByRole('button', { name: 'Remove step' }));\n    expect(await screen.findByText('Removed step: Bring two IDs', {}, { timeout: 10_000 })).toBeTruthy();\n    await waitFor(() => expect(screen.queryByRole('checkbox', { name: 'Bring two IDs' })).toBeNull(), {\n      timeout: 10_000,\n    });\n    await waitFor(() => expect(screen.getByRole('button', { name: 'Undo “Removed step: Bring two IDs”' })).not.toBeDisabled(), {\n      timeout: 10_000,\n    });\n    fireEvent.press(screen.getByRole('button', { name: 'Undo “Removed step: Bring two IDs”' }));\n    expect(await screen.findByRole('checkbox', { name: 'Bring two IDs' }, { timeout: 10_000 })).toBeTruthy();\n\n    await toggle('Bring two IDs', true);\n    await toggle('Choose a bank', true);\n    await waitFor(() => expect(screen.getByRole('button', { name: 'Mark task complete' })).not.toBeDisabled(), {\n      timeout: 10_000,\n    });\n    fireEvent.press(screen.getByRole('button', { name: 'Mark task complete' }));\n    await waitFor(() => expect(screen.getByRole('radio', { name: 'Completed' })).toBeSelected(), { timeout: 10_000 });\n    const after = await actions(owner.jwt, { action: 'read' });\n    expect(after.json.tasks.find((t: any) => t.task_ref === 'sanity:sin')).toMatchObject({ state: 'completed' });\n    expect(stepsOf(after.json, 'sanity:sin')).toEqual([\n      ['Bring two IDs', true],\n      ['Choose a bank', true],\n    ]);\n  }, 90_000);\n});\n\ndescribeStack('Task edits against the real local stack (mobile, #365)', () => {\n  afterEach(() => {\n    clients.splice(0).forEach(client => client.clear());\n  });\n\n  it('an edit draft approved in the mobile sheet and a clear command change the same custom task in the table every Checklist reads; another account can use neither', async () => {\n    const owner = await newAccount('editor');\n    const stranger = await newAccount('stranger');\n    mockUserId = owner.id;\n    mockCapture = jest.fn();\n    const rest = (table: string, body: Record<string, unknown>, select: string) =>\n      http(`/rest/v1/${table}?select=${select}`, {\n        method: 'POST',\n        jwt: owner.jwt,\n        headers: { Prefer: 'return=representation' },\n        body: JSON.stringify(body),\n      });\n    // A custom task, created the way today's Checklist does (direct insert, user JWT).\n    const task = await rest('custom_checklist_tasks', { user_id: owner.id, title: 'Get a phone plan', description: '', priority: 'Do soon' }, 'id');\n    expect(task.status).toBe(201);\n    const ref = `custom:${task.json[0].id}`;\n    const conversation = await rest('conversations', { user_id: owner.id, title: 't' }, 'id,conversation_identifier');\n    const answer = await rest('messages', { conversation_id: conversation.json[0].id, role: 'assistant', content: 'A prepaid plan needs no credit check.' }, 'id');\n    // What the send hook asks for after an answer that suggests this change.\n    const prepared = await actions(owner.jwt, {\n      action: 'prepare',\n      operation: { type: 'task.edit_details', task_ref: ref, title: 'Get a prepaid phone plan' },\n      source: { conversation_id: conversation.json[0].conversation_identifier, message_id: answer.json[0].id },\n    }, 'ios');\n    expect(prepared.status).toBe(200);\n    const proposalId = prepared.json.proposal.proposal_id;\n    expect((await actions(stranger.jwt, { action: 'proposal', proposal_id: proposalId })).status).toBe(404);\n\n    mount(<TaskActionsSheet visible proposalId={proposalId} proposalKind='task_edit' onClose={() => {}} />);\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    expect(await within(sheet).findByText('Now: “Get a phone plan”', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(within(sheet).getByText('After you save: “Get a prepaid phone plan”')).toBeTruthy();\n    const approve = await within(sheet).findByRole('button', { name: 'Save this change to Get a phone plan' });\n    await waitFor(() => expect(approve).not.toBeDisabled(), { timeout: 10_000 });\n    fireEvent.press(approve);\n    expect(\n      await within(sheet).findByText('Changed in Checklist: Get a prepaid phone plan', {}, { timeout: 10_000 })\n    ).toBeTruthy();\n    expect(within(sheet).getByText('Title: “Get a phone plan” → “Get a prepaid phone plan”')).toBeTruthy();\n\n    // A clear command in the owner's own saved message, through the same boundary.\n    const command = await rest('messages', {\n      conversation_id: conversation.json[0].id, role: 'user',\n      content: 'Set priority of task \"Get a prepaid phone plan\" to Do now',\n    }, 'id');\n    const messageId = command.json[0].id;\n    expect((await actions(stranger.jwt, { action: 'interpret', message_id: messageId })).status).toBe(404);\n    const interpreted = await actions(owner.jwt, { action: 'interpret', message_id: messageId }, 'ios');\n    expect(interpreted.json.command.kind).toBe('edit');\n    const forged = await actions(stranger.jwt, {\n      action: 'apply', operation_id: '00000000-0000-4000-8000-000000000365',\n      operations: [interpreted.json.command.operation], authorization: { kind: 'direct_command', message_id: messageId },\n    });\n    expect(forged.status).toBe(403);\n    const applied = await actions(owner.jwt, {\n      action: 'apply', operation_id: '00000000-0000-4000-8000-000000000366',\n      operations: [interpreted.json.command.operation], authorization: { kind: 'direct_command', message_id: messageId },\n    }, 'ios');\n    expect(applied.status).toBe(200);\n\n    // The row every Checklist (this app, web, released v1.6.0) reads with select('*').\n    const legacy = await http(`/rest/v1/custom_checklist_tasks?select=title,priority,description&id=eq.${task.json[0].id}`, {\n      method: 'GET', jwt: owner.jwt,\n    });\n    expect(legacy.json).toEqual([{ title: 'Get a prepaid phone plan', priority: 'Do now', description: '' }]);\n    const theirs = await http(`/rest/v1/custom_checklist_tasks?select=id&id=eq.${task.json[0].id}`, { method: 'GET', jwt: stranger.jwt });\n    expect(theirs.json).toEqual([]);\n  }, 60_000);\n});\n\n// ------------------------------------------------------------------ #370 saved details\n// The same real stack with this repo's #370 migration applied. A detail is saved through\n// the real service from a real user message (the clear remember command), then viewed,\n// edited and removed through the real mobile sheet.\nconst restAs = (jwt: string, pathname: string, init: RequestInit = {}) =>\n  http(pathname, { ...init, jwt, headers: { prefer: 'return=representation' } });\n\nasync function rememberThroughService(account: { id: string; jwt: string }, text: string) {\n  const conversation = await restAs(account.jwt, '/rest/v1/conversations?select=id,conversation_identifier', {\n    method: 'POST',\n    body: JSON.stringify({ user_id: account.id, title: 't' }),\n  });\n  const message = await restAs(account.jwt, '/rest/v1/messages?select=id', {\n    method: 'POST',\n    body: JSON.stringify({ conversation_id: conversation.json[0].id, role: 'user', content: `Remember that ${text}` }),\n  });\n  const id = message.json[0].id as number;\n  const interpreted = await actions(account.jwt, { action: 'interpret', message_id: id });\n  expect(interpreted.json.command).toMatchObject({ kind: 'remember', operation: { type: 'detail.create', text } });\n  const saved = await actions(account.jwt, {\n    action: 'apply',\n    operation_id: randomUUID(),\n    authorization: { kind: 'direct_command', message_id: id },\n    operations: [interpreted.json.command.operation],\n  });\n  expect(saved.status).toBe(200);\n  return saved.json.receipt;\n}\n\n/** What a later Companion answer reads: the user's own JWT and RLS (rag-query's read). */\nconst laterContext = async (jwt: string) =>\n  ((await restAs(jwt, '/rest/v1/companion_saved_details?select=body', { method: 'GET' })).json as any[]).map(\n    r => r.body\n  );\n\ndescribeStack('Saved details against the real local stack (mobile, #370)', () => {\n  beforeAll(async () => {\n    const probe = () =>\n      http('/rest/v1/rpc/companion_read_details', {\n        method: 'POST',\n        key: SERVICE_KEY,\n        body: JSON.stringify({ p_user_id: '00000000-0000-0000-0000-000000000000' }),\n      });\n    if ((await probe()).status !== 200) {\n      // This repo's migration, exactly as it ships (after #361, #363 and #366 above).\n      psql(\n        fs.readFileSync(\n          path.resolve(__dirname, '../../supabase/migrations/20261028004902_companion_saved_details.sql'),\n          'utf8'\n        )\n      );\n      execFileSync('docker', ['kill', '--signal=SIGUSR1', REST_CONTAINER], { stdio: 'ignore' });\n      for (let i = 0; i < 50; i++) {\n        if ((await probe()).status === 200) break;\n        await new Promise(resolve => setTimeout(resolve, 200));\n      }\n    }\n  }, 60_000);\n\n  afterEach(() => {\n    clients.splice(0).forEach(client => client.clear());\n  });\n\n  it('a remembered detail is shown in the mobile sheet; an edit and a confirmed removal go through the real service and a later answer stops reading it; another account sees none', async () => {\n    // Wrong if: the sheet does not show the saved detail, the edit or removal is not the\n    // real persisted change, an unconfirmed removal writes, a removed detail is still read\n    // as remembered context, or another account reads it.\n    const owner = await newAccount('details-owner');\n    const stranger = await newAccount('details-stranger');\n    await rememberThroughService(owner, 'I can attend appointments on Fridays');\n    mockUserId = owner.id;\n    mockCapture = jest.fn();\n\n    mount(<CompanionScreen />);\n    fireEvent.press(await screen.findByRole('button', { name: /Your tasks/ }));\n    let sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await within(sheet).findByRole('button', { name: /Saved details/ }));\n    sheet = await screen.findByTestId('companion-task-sheet');\n    expect(await within(sheet).findByText('I can attend appointments on Fridays', {}, { timeout: 10_000 })).toBeTruthy();\n\n    const edit = await within(sheet).findByRole('button', { name: 'Edit saved detail: I can attend appointments on Fridays' });\n    await waitFor(() => expect(edit).not.toBeDisabled(), { timeout: 10_000 });\n    fireEvent.press(edit);\n    fireEvent.changeText(within(sheet).getByLabelText('Saved detail'), 'I can attend appointments on Saturdays');\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Save change' }));\n    expect(\n      await within(sheet).findByText(\n        'Changed “I can attend appointments on Fridays” to “I can attend appointments on Saturdays”.',\n        {},\n        { timeout: 10_000 }\n      )\n    ).toBeTruthy();\n    expect(await laterContext(owner.jwt)).toEqual(['I can attend appointments on Saturdays']);\n\n    const remove = await within(sheet).findByRole('button', {\n      name: 'Remove saved detail: I can attend appointments on Saturdays',\n    });\n    await waitFor(() => expect(remove).not.toBeDisabled(), { timeout: 10_000 });\n    fireEvent.press(remove);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Cancel' }));\n    expect(await laterContext(owner.jwt)).toEqual(['I can attend appointments on Saturdays']);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Remove saved detail: I can attend appointments on Saturdays' }));\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Remove detail' }));\n    expect(\n      await within(sheet).findByText(\n        'Removed “I can attend appointments on Saturdays”. It will not be used in later conversations.',\n        {},\n        { timeout: 10_000 }\n      )\n    ).toBeTruthy();\n    expect(await laterContext(owner.jwt)).toEqual([]);\n    expect((await actions(owner.jwt, { action: 'read' })).json.details).toEqual([]);\n    expect((await actions(stranger.jwt, { action: 'read' })).json.details).toEqual([]);\n    expect(await laterContext(stranger.jwt)).toEqual([]);\n  }, 90_000);\n\n  it('S370-1: a conflicting Undo of a save reviews the detail the real service read; unconfirmed approval sends nothing; a newer edit is never removed by the older review', async () => {\n    // Wrong if: the client drops the service's current_detail, the review names the\n    // historical text, an unconfirmed or stale approval removes anything, or the newly\n    // reviewed removal does not remove exactly the current revision.\n    const owner = await newAccount('details-undo-conflict');\n    const created = await rememberThroughService(owner, 'I can attend appointments on Fridays');\n    const detailId = created.detail.detail_id as string;\n    const editElsewhere = async (text: string, expected_revision: number) =>\n      expect(\n        (\n          await actions(owner.jwt, {\n            action: 'apply',\n            operation_id: randomUUID(),\n            authorization: { kind: 'ui_control' },\n            operations: [{ type: 'detail.update', detail_id: detailId, text, expected_revision }],\n          })\n        ).status\n      ).toBe(200);\n    // The real client and store; the transport is real HTTP with the owner's JWT.\n    const client = createTaskActionClient({\n      transport: async body => {\n        const reply = await actions(owner.jwt, body, 'ios');\n        return { status: reply.status, body: reply.json };\n      },\n      platform: 'ios',\n      appVersion: 'test',\n    });\n    const store = new TaskActionStore({ client, newOperationId: () => randomUUID(), onChanged: () => {} });\n    const key = `detail:${detailId}`;\n    const live = async () => {\n      const r = await client.read();\n      if (r.kind !== 'ok') throw new Error(`read ${r.kind}`);\n      return r.details;\n    };\n\n    await editElsewhere('I can attend appointments on Saturdays', 1);\n    await store.undo(key, created.operation_id, { removalConfirmed: true });\n    let p = store.get(key);\n    if (p.phase !== 'undo_review') throw new Error(`phase ${p.phase}`);\n    expect(p.currentDetail).toEqual({\n      detailId,\n      text: 'I can attend appointments on Saturdays',\n      revision: 2,\n      removed: false,\n    });\n    expect(p.proposal.operations).toEqual([{ type: 'detail.remove', detail_id: detailId, expected_revision: 2 }]);\n    expect(verifiedCompensationDetail(p.proposal.operations[0], p.currentDetail, await live())).toEqual(p.currentDetail);\n\n    // Without the removal confirmation nothing is sent.\n    await store.approveCompensation(key);\n    expect((await live()).map(d => [d.text, d.revision])).toEqual([['I can attend appointments on Saturdays', 2]]);\n\n    // A newer edit: the newer read withholds the review, and the service refuses it too.\n    await editElsewhere('I can attend appointments on Sundays', 2);\n    expect(verifiedCompensationDetail(p.proposal.operations[0], p.currentDetail, await live())).toBeNull();\n    await store.approveCompensation(key, { removalConfirmed: true });\n    expect(store.get(key).phase).toBe('conflict');\n    expect((await live()).map(d => [d.text, d.revision])).toEqual([['I can attend appointments on Sundays', 3]]);\n\n    // A new Undo reviews the current detail; its confirmed approval removes exactly revision 3.\n    await store.undo(key, created.operation_id, { removalConfirmed: true });\n    p = store.get(key);\n    if (p.phase !== 'undo_review') throw new Error(`phase ${p.phase}`);\n    expect(p.currentDetail).toMatchObject({ text: 'I can attend appointments on Sundays', revision: 3, removed: false });\n    await store.approveCompensation(key, { removalConfirmed: true });\n    const done = store.get(key);\n    if (done.phase !== 'saved') throw new Error(`phase ${done.phase}`);\n    expect([done.receipt.operationType, done.receipt.detail?.text]).toEqual([\n      'detail.remove',\n      'I can attend appointments on Sundays',\n    ]);\n    expect(await live()).toEqual([]);\n    expect(await laterContext(owner.jwt)).toEqual([]);\n  }, 90_000);\n});\n\nif (!enabled) {\n  it('local stack checks are skipped: ACTIONS_API_URL, ACTIONS_ANON_KEY and ACTIONS_SERVICE_ROLE_KEY are not set', () => {\n    expect(enabled).toBe(false);\n  });\n}\n","usedDeprecatedRules":[]},{"filePath":"/Users/savargupta/.t3/worktrees/Unify/t3-c68f1368/unify-front-end/__tests__/companionActions/planLocalStack.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":53,"column":17,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":53,"endColumn":33},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":66,"column":20,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":66,"endColumn":43},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":81,"column":38,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":81,"endColumn":61},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":91,"column":20,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":91,"endColumn":43},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":205,"column":17,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":205,"endColumn":49},{"ruleId":"import/first","severity":1,"message":"Import in body of module; reorder to top.","line":247,"column":1,"nodeType":"ImportDeclaration","endLine":247,"endColumn":60,"fix":{"range":[12142,12142],"text":""}},{"ruleId":"import/first","severity":1,"message":"Import in body of module; reorder to top.","line":248,"column":1,"nodeType":"ImportDeclaration","endLine":248,"endColumn":73,"fix":{"range":[12215,12215],"text":""}},{"ruleId":"import/first","severity":1,"message":"Import in body of module; reorder to top.","line":249,"column":1,"nodeType":"ImportDeclaration","endLine":249,"endColumn":85,"fix":{"range":[12300,12300],"text":""}},{"ruleId":"import/first","severity":1,"message":"Import in body of module; reorder to top.","line":820,"column":1,"nodeType":"ImportDeclaration","endLine":820,"endColumn":54,"fix":{"range":[0,43405],"text":"// Mounted acceptance of settlement plans (mobile-app#364, direction B) against the real\n// local stack: the actual Companion screen, send hook, plan entry, plan cards and the\n// task bottom sheet send real HTTP requests with real user JWTs to the real\n// companion-actions edge function, which writes through this repo's migrations to a\n// real Postgres with RLS. Conversations and messages are saved to the same database\n// with the user's JWT (PostgREST). Only the model stream, Sanity content and\n// generation-allowance hooks are stand-ins; the model answer carries the typed plan\n// suggestion exactly as rag-query returns it (web repo index_companion_context_test.ts).\n//\n// Runs only when ACTIONS_API_URL, ACTIONS_ANON_KEY and ACTIONS_SERVICE_ROLE_KEY point at\n// the disposable 127.0.0.1 stack of the web repo (supabase/tests/companion-actions/run.sh,\n// ACTIONS_KEEP=1). See DOCS/companion-actions/364-plan.md.\n// Enabled runs must explicitly name that project's ACTIONS_DB_CONTAINER and\n// ACTIONS_REST_CONTAINER. There is no default container selection.\nimport React from 'react';\nimport { act, fireEvent, render, screen, waitFor, within } from '@testing-library/react-native';\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query';\nimport { createTestQueryClient } from '@/testSupport/queryClient';\nimport { createInstance } from 'i18next';\nimport { I18nextProvider, initReactI18next } from 'react-i18next';\nimport { AccessibilityInfo, StyleSheet, TouchableOpacity, View, Text } from 'react-native';\nimport en from '@/i18n/locales/en/translation.json';\nimport { execFileSync } from 'child_process';\nimport * as fs from 'fs';\nimport * as path from 'path';\n\nimport CompanionScreen from '@/app/(tabs)/companion/index';\nimport { clearPlanStores } from '@/services/companionActions/planStore';\nimport { clearTaskActionStores } from '@/services/companionActions/taskActionStore';\n\nimport ChecklistScreen from '@/app/(tabs)/Checklist';\n\nconst API_URL = process.env.ACTIONS_API_URL ?? '';\nconst ANON_KEY = process.env.ACTIONS_ANON_KEY ?? '';\nconst SERVICE_KEY = process.env.ACTIONS_SERVICE_ROLE_KEY ?? '';\nconst DB_CONTAINER = process.env.ACTIONS_DB_CONTAINER?.trim() ?? '';\nconst REST_CONTAINER = process.env.ACTIONS_REST_CONTAINER?.trim() ?? '';\nconst enabled = /^http:\\/\\/127\\.0\\.0\\.1:\\d+$/.test(API_URL) && Boolean(ANON_KEY && SERVICE_KEY);\nif (enabled && (!DB_CONTAINER || !REST_CONTAINER)) {\n  throw new Error(\n    'ACTIONS_DB_CONTAINER and ACTIONS_REST_CONTAINER are required for enabled local-stack tests.'\n  );\n}\nprocess.env.EXPO_PUBLIC_SUPABASE_URL = API_URL;\nprocess.env.EXPO_PUBLIC_SUPABASE_ANON_KEY = ANON_KEY;\nconst mockJwts = new Map<string, string>();\n\nconst mockChecklistRows:any[]=[];\nconst mockLegacyCompleted=jest.fn();\nlet mockUserId = 'user-1';\nlet mockCapture: jest.Mock = jest.fn();\nconst mockAuthListeners = new Set<(event: string, session: unknown) => void>();\nconst mockPush = jest.fn();\njest.mock('expo-router', () => ({\n  useRouter: () => ({ push: mockPush, replace: jest.fn() }),\n  useLocalSearchParams: () => ({}),\n}));\njest.mock('@react-navigation/native', () => {\n  const React = require('react');\n  return {\n    useFocusEffect: (callback: () => void) => {\n      React.useEffect(() => {\n        const cleanup = callback();\n        return typeof cleanup === 'function' ? cleanup : undefined;\n      }, [callback]);\n    },\n    useIsFocused: () => true,\n  };\n});\njest.mock('@react-navigation/bottom-tabs', () => ({ useBottomTabBarHeight: () => 0 }));\njest.mock('react-native-reanimated', () => {\n  const { View } = require('react-native');\n  const identity = (value: unknown) => value;\n  return {\n    __esModule: true,\n    default: { View },\n    useSharedValue: (value: unknown) => ({ value }),\n    useAnimatedStyle: () => ({}),\n    withTiming: identity,\n    Easing: { out: identity, in: identity, cubic: identity },\n    runOnJS: identity,\n    interpolate: identity,\n    Extrapolate: { CLAMP: 'clamp' },\n  };\n});\njest.mock('react-native-gesture-handler', () => {\n  const { View, TouchableOpacity } = require('react-native');\n  const gesture: any = { onUpdate: () => gesture, onEnd: () => gesture, enabled: () => gesture };\n  return {\n    Gesture: { Pan: () => gesture },\n    GestureDetector: ({ children }: { children: React.ReactNode }) => children,\n    GestureHandlerRootView: View,\n    TouchableOpacity,\n  };\n});\njest.mock('react-native-keyboard-controller', () => {\n  const { View } = require('react-native');\n  return {\n    KeyboardAvoidingView: View,\n    useReanimatedKeyboardAnimation: () => ({ height: { value: 0 }, progress: { value: 0 } }),\n  };\n});\njest.mock('expo-haptics', () => ({ impactAsync: jest.fn(), ImpactFeedbackStyle: { Medium: 'medium' } }));\njest.mock('@expo/vector-icons/MaterialIcons', () => () => null);\njest.mock('expo-constants', () => ({\n  __esModule: true,\n  default: { expoConfig: { version: '9.9.9', extra: {} } },\n}));\nconst mockPostHog = { capture: (...args: unknown[]) => mockCapture(...args), screen: () => {} };\njest.mock('posthog-react-native', () => ({ usePostHog: () => mockPostHog }));\njest.mock('@/context/HapticsContext', () => ({ useHapticsPreference: () => ({ hapticsEnabled: false }) }));\nconst mockRefreshStage = jest.fn().mockResolvedValue(undefined);\nconst mockApplyConfirmedArrival = jest.fn();\njest.mock('@/hooks/onboarding/useUserStage', () => ({\n  useUserStage: () => ({\n    currentStage: 0,\n    stageChanged: false,\n    arrivalDate: null,\n    userId: mockUserId,\n    refreshStage: mockRefreshStage,\n    applyConfirmedArrival: mockApplyConfirmedArrival,\n    isLoading: false,\n  }),\n}));\njest.mock('@/hooks/checklist/useRefreshingToday', () => ({\n  useRefreshingToday: () => new Date(2026, 9, 27, 12, 0, 0),\n}));\nconst mockRefreshUser = jest.fn();\njest.mock('@/context/UserContext', () => ({\n  useCurrentUser: () => ({ currentUser: { id: mockUserId, isPremium: false }, refreshUser: mockRefreshUser }),\n}));\n\n// Conversations and messages: the same tables the app uses, written and read with the\n// signed-in user's JWT through PostgREST (row-level security applies).\nconst mockRest = (pathname: string, init: { method: string; body?: unknown; prefer?: string }) =>\n  (globalThis as any).__planRealFetch(`${process.env.ACTIONS_API_URL}${pathname}`, {\n    method: init.method,\n    headers: {\n      'content-type': 'application/json',\n      apikey: process.env.ACTIONS_ANON_KEY,\n      authorization: `Bearer ${mockJwts.get(mockUserId)}`,\n      ...(init.prefer ? { prefer: init.prefer } : {}),\n    },\n    body: init.body === undefined ? undefined : JSON.stringify(init.body),\n  }).then(async (res: Response) => {\n    const text = await res.text();\n    if (!res.ok) throw new Error(`rest ${pathname} ${res.status} ${text}`);\n    return text ? JSON.parse(text) : null;\n  });\njest.mock('@/services/companion/createConversation', () => ({\n  createConversation: jest.fn(async () => {\n    const [row] = await mockRest('/rest/v1/conversations?select=id,conversation_identifier', {\n      method: 'POST',\n      body: { user_id: mockUserId, title: 'Plan' },\n      prefer: 'return=representation',\n    });\n    return { conversation_identifier: row.conversation_identifier, id: row.id };\n  }),\n}));\njest.mock('@/services/companion/saveMessage', () => ({\n  saveMessage: jest.fn(async (p: { conversationIdentifier: string; role: string; content: string }) => {\n    const [conv] = await mockRest(\n      `/rest/v1/conversations?select=id&conversation_identifier=eq.${p.conversationIdentifier}`,\n      { method: 'GET' }\n    );\n    const [row] = await mockRest('/rest/v1/messages?select=id', {\n      method: 'POST',\n      body: { conversation_id: conv.id, role: p.role, content: p.content },\n      prefer: 'return=representation',\n    });\n    return { id: row.id };\n  }),\n}));\njest.mock('@/services/companion/getConversationMessages', () => ({\n  getConversationMessages: jest.fn(async (conversation: string) => {\n    const rows = await mockRest(\n      `/rest/v1/messages?select=id,role,content,created_at,conversations!inner(conversation_identifier)&conversations.conversation_identifier=eq.${conversation}&order=id`,\n      { method: 'GET' }\n    );\n    return rows.map((m: any) => ({ id: m.id, role: m.role, content: m.content, sources: null, created_at: m.created_at }));\n  }),\n}));\njest.mock('@/services/companion/getConversations', () => ({ getConversations: jest.fn(async () => []) }));\nlet mockMessageCount = 0;\njest.mock('@/hooks/companion/useChatbotUsage', () => ({\n  useChatbotUsage: () => ({ data: { message_count: mockMessageCount } }),\n}));\njest.mock('@/hooks/companion/useCompanionReviewPrompt', () => ({ useCompanionReviewPrompt: () => {} }));\njest.mock('@/hooks/companion/usePersonalizedStarters', () => ({ usePersonalizedStarters: () => ({ data: undefined }) }));\nconst mockStream = jest.fn();\njest.mock('@/utils/gemini', () => ({\n  AICompanionBusyError: class extends Error {},\n  AICompanionLimitError: class extends Error {},\n  streamGeminiAPI: (...a: unknown[]) => mockStream(...a),\n}));\njest.mock('@/components/companion/TypingIndicator', () => ({ TypingIndicator: () => null }));\njest.mock('@/context/ToastContext', () => ({ useToast: () => ({ showToast: jest.fn() }) }));\njest.mock('@/components/companion/AnimatedDottedBackground', () => ({ AnimatedDottedBackground: () => null }));\njest.mock('@/components/companion/StarterPrompts', () => ({ StarterPrompts: () => null }));\njest.mock('@/components/companion/PartnerSpotlightBanner', () => () => null);\njest.mock('@/components/icons/SendIcon.svg', () => () => null);\njest.mock('lucide-react-native', () => ({ History: () => null, Plus: () => null }));\njest.mock('@/components/common/BottomSheet', () => ({ __esModule: true, default: () => null }));\njest.mock('react-native-safe-area-context', () => ({\n  useSafeAreaInsets: () => ({ top: 0, bottom: 0, left: 0, right: 0 }),\n}));\njest.mock('@/hooks/sanity/useSanityLanguage', () => ({ useSanityLanguage: () => 'en' }));\njest.mock('@/lib/supabase', () => ({\n  supabase: {\n    from:(table:string)=>{\n      const sdk=require('@supabase/supabase-js').createClient(process.env.ACTIONS_API_URL,process.env.ACTIONS_ANON_KEY,{auth:{persistSession:false,autoRefreshToken:false},global:{fetch:(globalThis as any).__planRealFetch,headers:{Authorization:`Bearer ${mockJwts.get(mockUserId)}`}}});\n      return sdk.from(table);\n    },\n    auth: {\n      getUser: async () => ({ data: { user: { id: mockUserId } } }),\n      getSession: async () => ({\n        data: { session: { user: { id: mockUserId }, access_token: mockJwts.get(mockUserId) } },\n      }),\n      onAuthStateChange: (listener: (event: string, session: unknown) => void) => {\n        mockAuthListeners.add(listener);\n        return { data: { subscription: { unsubscribe: () => mockAuthListeners.delete(listener) } } };\n      },\n    },\n  },\n}));\njest.mock('@/services/onboarding/getOnboardingProfile', () => ({\n  getOnboardingProfile: jest.fn(async () => ({ persona: 'skilled_worker', province: 'British Columbia' })),\n}));\njest.mock('@/sanity-custom', () => ({\n  sanityClient: {\n    fetch: jest.fn(async () => [\n      { _id: 'sin-number', _type: 'checklist', title: 'Get your SIN', class: 'do_now', class_order: 1 },\n      { _id: 'bank-account', _type: 'checklist', title: 'Open a bank account', class: 'do_now', class_order: 2 },\n    ]),\n  },\n}));\njest.mock('@/services/checklist/getUserTasks', () => ({ getUserTasks: jest.fn().mockResolvedValue([]) }));\njest.mock('@/services/checklist/customChecklistTasks', () => ({\n  getCustomChecklistTasks: jest.fn().mockResolvedValue([]),\n  deleteCustomChecklistTask: jest.fn(),\n  setCustomChecklistTaskCompletion: jest.fn(async (input:any)=>{await jest.requireActual('@/services/checklist/customChecklistTasks').setCustomChecklistTaskCompletion(input);mockLegacyCompleted();}),\n}));\njest.mock('@/services/checklist/checklistTaskOrder', () => ({\n  getChecklistTaskOrders: jest.fn().mockResolvedValue([]),\n  upsertChecklistTaskOrder: jest.fn(),\n}));\njest.mock('@/services/checklist/setChecklistItemCompletion', () => ({ setChecklistItemCompletion: jest.fn() }));\njest.mock('@/services/checklist/setChecklistItemDismissed', () => ({ setChecklistItemDismissed: jest.fn() }));\njest.mock('@/components/home/HomeHeader', () => () => null);\njest.mock('@/components/LoadingScreen', () => () => null);\njest.mock('@/components/partners/SpotlightRow', () => () => null);\n\nfunction testI18n() {\n  const i18n = createInstance();\n  void i18n.use(initReactI18next).init({\n    lng: 'en',\n    resources: { en: { translation: en } },\n    interpolation: { escapeValue: false },\n    initImmediate: false,\n  });\n  return i18n;\n}\n\nconst clients: QueryClient[] = [];\nfunction mount() {\n  // A new query client per mount (a client restart): nothing is shared but the server.\n  // The managed client also disposes resources removed during account changes.\n  const client = createTestQueryClient({ defaultOptions: { queries: { retry: false, gcTime: Infinity } } });\n  clients.push(client);\n  return render(\n    <QueryClientProvider client={client}>\n      <I18nextProvider i18n={testI18n()}>\n        <RetainedTabs />\n      </I18nextProvider>\n    </QueryClientProvider>\n  );\n}\n\nconst realFetch: typeof fetch = (globalThis as any).__realFetch ?? global.fetch;\n(globalThis as any).__planRealFetch = realFetch;\n\nasync function http(pathname: string, init: RequestInit & { key?: string; jwt?: string }) {\n  const res = await realFetch(`${API_URL}${pathname}`, {\n    ...init,\n    headers: {\n      'content-type': 'application/json',\n      apikey: init.key ?? ANON_KEY,\n      authorization: `Bearer ${init.jwt ?? init.key ?? ANON_KEY}`,\n      ...(init.headers as Record<string, string> | undefined),\n    },\n  });\n  const text = await res.text();\n  return { status: res.status, json: text ? JSON.parse(text) : null };\n}\n\nfunction psql(sqlText: string) {\n  return execFileSync(\n    'docker',\n    ['exec', '-i', DB_CONTAINER, 'psql', '-v', 'ON_ERROR_STOP=1', '-qtA', '-U', 'postgres', '-d', 'postgres'],\n    { input: sqlText, stdio: ['pipe', 'pipe', 'pipe'] }\n  ).toString().trim();\n}\n\nasync function newAccount(label: string) {\n  const email = `${label}-${Date.now()}@mobile364.invalid`;\n  const password = 'mobile-plans-1';\n  const created = await http('/auth/v1/admin/users', {\n    method: 'POST',\n    key: SERVICE_KEY,\n    body: JSON.stringify({ email, password, email_confirm: true }),\n  });\n  if (created.status !== 200) throw new Error(`createUser ${created.status}`);\n  const token = await http('/auth/v1/token?grant_type=password', {\n    method: 'POST',\n    body: JSON.stringify({ email, password }),\n  });\n  if (token.status !== 200) throw new Error(`signIn ${token.status}`);\n  const id = created.json.id as string;\n  const jwt = token.json.access_token as string;\n  mockJwts.set(id, jwt);\n  // The fictional Vancouver arrival: profile and the two existing Checklist tasks.\n  await http('/rest/v1/user_onboarding_profiles', {\n    method: 'POST',\n    jwt,\n    body: JSON.stringify({ id, persona: 'skilled_worker', city: 'Vancouver', province: 'British Columbia',\n      arrival_date: '2026-11-02T00:00:00Z', stage: 0, wants_reminders: false }),\n  });\n  for (const sanity of ['sin-number', 'bank-account']) {\n    await http('/rest/v1/user_tasks', {\n      method: 'POST',\n      jwt,\n      body: JSON.stringify({ user_id: id, sanity_checklist_id: sanity, completed: false }),\n    });\n  }\n  return { id, jwt };\n}\n\nconst actions = (jwt: string, body: Record<string, unknown>, platform = 'web') =>\n  http('/functions/v1/companion-actions', {\n    method: 'POST',\n    jwt,\n    body: JSON.stringify({ contract_version: 1, client: { platform, app_version: 'test' }, ...body }),\n  });\n\nconst GOAL = 'Your first week in Vancouver';\nconst PHONE = 'Set up phone service';\nconst SUGGESTION = {\n  type: 'plan',\n  version: 1,\n  goal: GOAL,\n  items: [\n    { kind: 'existing', task_ref: 'sanity:sin-number', label: 'Get your SIN' },\n    { kind: 'existing', task_ref: 'sanity:bank-account', label: 'Open a bank account' },\n    { kind: 'new', title: PHONE },\n  ],\n};\n\n/** The model answer, with the typed plan suggestion rag-query extracted. */\nfunction answersWithPlan() {\n  mockStream.mockImplementation(async (_q: string, _c: string, _h: unknown, cb: any) => {\n    cb.onMetadata({ sources: [], queryType: 'newcomer_settlement' });\n    cb.onComplete({ cleanAnswer: 'You already have your SIN and bank tasks. A phone plan helps with both.', actionProposal: SUGGESTION });\n  });\n}\n\nconst composer = () => screen.getByPlaceholderText('Ask anything...');\nconst sendButton = () => {\n  const button = screen.UNSAFE_getAllByType(TouchableOpacity).find(b => StyleSheet.flatten(b.props.style)?.borderRadius === 20);\n  if (!button) throw new Error('send control missing');\n  return button;\n};\nasync function send(text: string) {\n  fireEvent.changeText(await screen.findByPlaceholderText(/Ask anything|limit/i), text);\n  fireEvent.press(sendButton());\n}\nconst isEnabled = (el: { props: { accessibilityState?: { disabled?: boolean } } }) =>\n  el.props.accessibilityState?.disabled !== true;\nasync function enabledButton(scope: ReturnType<typeof within>, name: string | RegExp) {\n  await scope.findByRole('button', { name }, { timeout: 10_000 });\n  await waitFor(() => expect(isEnabled(scope.getByRole('button', { name }))).toBe(true), { timeout: 10_000 });\n  return scope.getByRole('button', { name });\n}\nconst sqlCount = (userId: string, where = 'true') =>\n  Number(psql(`select count(*) from custom_checklist_tasks where user_id = '${userId}' and ${where};`));\n\n/** A saved plan, made through the real endpoint as another platform would. */\nasync function savedPlanFor(acc: { id: string; jwt: string }) {\n  const p = await actions(acc.jwt, { action: 'plan_prepare', goal: GOAL, items: SUGGESTION.items });\n  const draft = p.json.plan_proposal;\n  const w = await actions(acc.jwt, {\n    action: 'plan_apply',\n    operation_id: (globalThis.crypto as Crypto).randomUUID(),\n    authorization: { kind: 'approved_proposal', proposal_id: draft.plan_proposal_id, proposal_revision: draft.proposal_revision },\n    items: draft.items,\n  }, 'ios');\n  if (w.status !== 200) throw new Error(`plan_apply ${w.status} ${JSON.stringify(w.json)}`);\n  return w.json;\n}\n\nfunction switchAccount(id: string) {\n  mockUserId = id;\n  act(() => {\n    for (const l of [...mockAuthListeners]) l('SIGNED_IN', { user: { id }, access_token: mockJwts.get(id) });\n  });\n}\n\nconst describeStack = enabled ? describe : describe.skip;\n\ndescribeStack('Settlement plans against the real local stack (mobile)', () => {\n  it('a saved task completion reconciles the plan entry without reopening the screen', async () => {\n    const acc = await newAccount('plan-progress');\n    mockUserId = acc.id;\n    const saved = await savedPlanFor(acc);\n    mount();\n    const entry = await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, 0 of 3 done`) }, { timeout: 10_000 });\n    fireEvent.changeText(composer(), 'Keep this question');\n    fireEvent.press(entry);\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await within(sheet).findByRole('button', { name: `${PHONE}, Not started` }));\n    await waitFor(() => expect(within(sheet).getByRole('radio', { name: 'Completed' })).not.toBeDisabled());\n    fireEvent.press(within(sheet).getByRole('radio', { name: 'Completed' }));\n    await within(sheet).findByText('Changed from Not started to Completed', {}, { timeout: 10_000 });\n    const current = await actions(acc.jwt, { action: 'read' });\n    const phoneRef = saved.receipt.results[2].task_ref;\n    expect(current.json.tasks.find((row: { task_ref: string }) => row.task_ref === phoneRef).state).toBe('completed');\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, 1 of 3 done`) }, { timeout: 10_000 });\n    expect(composer().props.value).toBe('Keep this question');\n  }, 60_000);\n  beforeAll(async () => {\n    const applied = (name: string) => psql(`select to_regclass('public.${name}') is not null;`) === 't';\n    const migrations = path.resolve(__dirname, '../../supabase/migrations');\n    if (!applied('companion_action_receipts'))\n      psql(fs.readFileSync(path.join(migrations, '20261025235536_companion_task_actions.sql'), 'utf8'));\n    if (psql(`select to_regprocedure('public.companion_prepare_proposal(uuid,jsonb,jsonb)') is not null;`) !== 't')\n      psql(fs.readFileSync(path.join(migrations, '20261026165156_companion_task_create.sql'), 'utf8'));\n    if (!applied('companion_plan_proposals'))\n      psql(fs.readFileSync(path.join(migrations, '20261027183338_companion_settlement_plan.sql'), 'utf8'));\n    psql(`update public.companion_feature_gate set enabled = true, min_contract_version = 1,\n            max_contract_version = 1, allowed_platforms = '{ios,android,web}';`);\n    execFileSync('docker', ['kill', '--signal=SIGUSR1', REST_CONTAINER], { stdio: 'ignore' });\n    for (let i = 0; i < 50; i++) {\n      const ready = await http('/rest/v1/rpc/companion_plans_read', {\n        method: 'POST',\n        key: SERVICE_KEY,\n        body: JSON.stringify({ p_user_id: '00000000-0000-0000-0000-000000000000' }),\n      });\n      if (ready.status === 200) break;\n      await new Promise(resolve => setTimeout(resolve, 200));\n    }\n  }, 60_000);\n\n  beforeEach(() => {\n    global.fetch = realFetch;\n    mockCapture = jest.fn();\n    mockStream.mockReset();\n    clearPlanStores(null);\n    clearTaskActionStores(null);\n  });\n  afterEach(() => {\n    global.fetch = realFetch;\n    clients.splice(0).forEach(client => client.clear());\n  });\n\n  it('a suggested plan is a draft that reuses two tasks and proposes one; excluding changes the count; approval adds exactly one task', async () => {\n    const acc = await newAccount('plan-a');\n    mockUserId = acc.id;\n    answersWithPlan();\n    mount();\n    await send('I arrive in Vancouver next week. Help me plan my first week.');\n\n    const card = await screen.findByTestId('plan-card', {}, { timeout: 10_000 });\n    expect(within(card).getByText('Draft plan · not saved yet')).toBeTruthy();\n    expect(within(card).getByText(GOAL)).toBeTruthy();\n    expect(within(card).getByText('2 tasks you already have · 1 new task')).toBeTruthy();\n    expect(sqlCount(acc.id)).toBe(0);\n    // The typed message stays while the user reviews.\n    fireEvent.changeText(composer(), 'My next question');\n\n    fireEvent.press(within(card).getByRole('button', { name: `Review plan: ${GOAL}` }));\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    expect(within(sheet).getByRole('header', { name: 'Review plan' })).toBeTruthy();\n    expect(await within(sheet).findByText('Get your SIN')).toBeTruthy();\n    expect(within(sheet).getByText('Open a bank account')).toBeTruthy();\n    expect(within(sheet).getAllByText('Already in your Checklist · Not started')).toHaveLength(2);\n    expect(within(sheet).getByText('City: Vancouver')).toBeTruthy();\n    const include = within(sheet).getByRole('checkbox', { name: `Add ${PHONE}` });\n    expect(include.props.accessibilityState.checked).toBe(true);\n    await enabledButton(within(sheet), 'Approve and add 1 task');\n\n    // Excluding the addition is a draft edit (a new revision): the count follows it.\n    fireEvent.press(include);\n    await enabledButton(within(sheet), 'Save plan with existing tasks');\n    expect(sqlCount(acc.id)).toBe(0);\n    fireEvent.press(within(sheet).getByRole('checkbox', { name: `Add ${PHONE}` }));\n    const approve = await enabledButton(within(sheet), 'Approve and add 1 task');\n\n    fireEvent.press(approve);\n    fireEvent.press(approve);\n    expect(await within(sheet).findByText('Added 1 task. Reused 2 tasks you already had.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(sqlCount(acc.id, `title = '${PHONE}'`)).toBe(1);\n    expect(Number(psql(`select count(*) from companion_plans where user_id = '${acc.id}';`))).toBe(1);\n\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    expect(composer().props.value).toBe('My next question');\n    // The persistent entry, outside any message, now names the saved plan.\n    const entry = await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 });\n    expect(within(entry).getByText('0 of 3 done')).toBeTruthy();\n    // Analytics carry categories and a count only.\n    const sent = JSON.stringify(mockCapture.mock.calls);\n    expect(sent).not.toContain(PHONE);\n    expect(sent).not.toContain(GOAL);\n  }, 60_000);\n\n  it('the plan entry resumes the saved plan after a restart with current progress, never reads as \"no plan\" while loading, and Undo removes only the added task after confirmation', async () => {\n    const acc = await newAccount('plan-b');\n    mockUserId = acc.id;\n    const saved = await savedPlanFor(acc);\n    const phoneRef = saved.receipt.results[2].task_ref as string;\n    // Progress made later on the web: the plan shows it, never a copy.\n    const st = await actions(acc.jwt, { action: 'apply', operation_id: (globalThis.crypto as Crypto).randomUUID(),\n      authorization: { kind: 'ui_control' }, operations: [{ type: 'task.set_state', task_ref: 'sanity:sin-number', state: 'completed', expected_revision: 1 }] });\n    expect(st.status).toBe(200);\n\n    // Hold the first plan read: the entry says it is checking, not that there is no plan.\n    let release!: () => void;\n    const held = new Promise<void>(r => (release = r));\n    let heldOnce = false;\n    global.fetch = (async (url: any, init: any) => {\n      if (!heldOnce && String(init?.body ?? '').includes('\"action\":\"plans\"')) {\n        heldOnce = true;\n        await held;\n      }\n      return realFetch(url, init);\n    }) as typeof fetch;\n    mount();\n    expect(await screen.findByText('Checking your saved plan…')).toBeTruthy();\n    release();\n    const entry = await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 });\n    expect(within(entry).getByText('1 of 3 done')).toBeTruthy();\n\n    fireEvent.press(entry);\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    expect(await within(sheet).findByText('Saved plan · uses your shared Checklist')).toBeTruthy();\n    expect(within(sheet).getByRole('button', { name: /Get your SIN, Completed/ })).toBeTruthy();\n    expect(within(sheet).getByRole('button', { name: new RegExp(`${PHONE}, Not started`) })).toBeTruthy();\n    expect(within(sheet).getByText('Added 1 task. Reused 2 tasks you already had.')).toBeTruthy();\n\n    // Undo removes a task: it asks first. Keep sends nothing.\n    fireEvent.press(await enabledButton(within(sheet), 'Undo plan change'));\n    expect(await within(sheet).findByText(`This removes 1 task the plan added: ${PHONE}. Your other tasks stay as they are.`)).toBeTruthy();\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Keep plan' }));\n    expect(sqlCount(acc.id, 'removed_at is null')).toBe(1);\n    fireEvent.press(await enabledButton(within(sheet), 'Undo plan change'));\n    fireEvent.press(await enabledButton(within(sheet), 'Undo plan'));\n    expect(await within(sheet).findByText('Plan undone. Removed 1 task.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(sqlCount(acc.id, 'removed_at is null')).toBe(0);\n    expect(psql(`select completed from user_tasks where user_id = '${acc.id}' and sanity_checklist_id = 'sin-number';`)).toBe('t');\n    expect(phoneRef).toMatch(/^custom:/);\n  }, 60_000);\n\n  it('a reply lost after commit is looked up and shown as saved; a failed lookup stays unresolved and never writes', async () => {\n    const acc = await newAccount('plan-c');\n    mockUserId = acc.id;\n    const p = await actions(acc.jwt, { action: 'plan_prepare', goal: GOAL, items: SUGGESTION.items });\n    expect(p.status).toBe(200);\n    let applies = 0;\n    let statusCalls = 0;\n    global.fetch = (async (url: any, init: any) => {\n      const body = String(init?.body ?? '');\n      if (body.includes('\"action\":\"plan_apply\"')) {\n        applies++;\n        await realFetch(url, init); // committed on the server\n        throw new TypeError('Network request failed'); // the reply never arrives\n      }\n      if (body.includes('\"action\":\"plan_status\"') && ++statusCalls === 1) {\n        throw new TypeError('Network request failed');\n      }\n      return realFetch(url, init);\n    }) as typeof fetch;\n    mount();\n    const entry = await screen.findByRole('button', { name: new RegExp(`Draft plan, ${GOAL}`) }, { timeout: 10_000 });\n    fireEvent.press(entry);\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await enabledButton(within(sheet), 'Approve and add 1 task'));\n    expect(await within(sheet).findByText('We could not check the result. The change may or may not have saved.', {}, { timeout: 10_000 })).toBeTruthy();\n    // Unresolved: approval is off; only a lookup is offered.\n    expect(isEnabled(within(sheet).getByRole('button', { name: 'Approve and add 1 task' }))).toBe(false);\n    expect(applies).toBe(1);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Check again' }));\n    expect(await within(sheet).findByText('Added 1 task. Reused 2 tasks you already had.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(applies).toBe(1);\n    expect(sqlCount(acc.id)).toBe(1);\n  }, 60_000);\n\n  it('a retry after a relevant profile change asks for a new approval of the remaining addition, still reachable after a restart; approving adds exactly one task', async () => {\n    // Wrong if: the needs-review result is not shown, the same Retry is offered again,\n    // the review is missing the remaining addition or its before/current context, it is\n    // gone after a restart, approval adds zero or two tasks, or the reused tasks change.\n    const acc = await newAccount('plan-e');\n    mockUserId = acc.id;\n    psql(`create function public.test364_mobile_fault() returns trigger language plpgsql as $f$\n            begin if new.title = '${PHONE}' then raise exception 'injected fault'; end if; return new; end $f$;\n          create trigger test364_mobile_fault before insert on custom_checklist_tasks\n            for each row execute function public.test364_mobile_fault();`);\n    let saved: any;\n    try {\n      saved = await savedPlanFor(acc);\n    } finally {\n      psql('drop trigger test364_mobile_fault on custom_checklist_tasks; drop function public.test364_mobile_fault();');\n    }\n    expect(saved.status).toBe('partial');\n    const reused = () =>\n      psql(`select string_agg(sanity_checklist_id || ':' || coalesce(revision, 0) || ':' || completed, ',' order by sanity_checklist_id)\n              from user_tasks where user_id = '${acc.id}';`);\n    const reusedBefore = reused();\n\n    const first = mount();\n    fireEvent.press(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 }));\n    let sheet = await screen.findByTestId('companion-task-sheet');\n    expect(await within(sheet).findByText(`Could not add: ${PHONE}. Everything else is saved.`)).toBeTruthy();\n    const patched = await http(`/rest/v1/user_onboarding_profiles?id=eq.${acc.id}`, {\n      method: 'PATCH', jwt: acc.jwt, body: JSON.stringify({ city: 'Surrey' }),\n    });\n    expect(patched.status).toBeLessThan(300);\n    fireEvent.press(await enabledButton(within(sheet), 'Try adding 1 task again'));\n    expect(await within(sheet).findByText(`Not added, because something changed: ${PHONE}.`, {}, { timeout: 10_000 })).toBeTruthy();\n    expect(await within(sheet).findByText('City: Surrey', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(within(sheet).getByText('Before: Vancouver')).toBeTruthy();\n    expect(within(sheet).getByRole('checkbox', { name: `Add ${PHONE}` }).props.accessibilityState.checked).toBe(true);\n    await enabledButton(within(sheet), 'Approve and add 1 task');\n    expect(within(sheet).queryByRole('button', { name: 'Try adding 1 task again' })).toBeNull();\n    expect(sqlCount(acc.id)).toBe(0);\n\n    // A restart: new query client, no store state. The review is reached from the entry.\n    first.unmount();\n    clients.splice(0).forEach(client => client.clear());\n    clearPlanStores(null);\n    mount();\n    const entry = await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, .*needs your review`) }, { timeout: 10_000 });\n    fireEvent.press(entry);\n    sheet = await screen.findByTestId('companion-task-sheet');\n    expect(await within(sheet).findByText('City: Surrey', {}, { timeout: 10_000 })).toBeTruthy();\n    // It changes again before approval: nothing is written and the refreshed review shows it.\n    await http(`/rest/v1/user_onboarding_profiles?id=eq.${acc.id}`, {\n      method: 'PATCH', jwt: acc.jwt, body: JSON.stringify({ city: 'Burnaby' }),\n    });\n    fireEvent.press(await enabledButton(within(sheet), 'Approve and add 1 task'));\n    expect(await within(sheet).findByText('City: Burnaby', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(within(sheet).getByText('Before: Surrey')).toBeTruthy();\n    expect(sqlCount(acc.id)).toBe(0);\n    const approve = await enabledButton(within(sheet), 'Approve and add 1 task');\n    fireEvent.press(approve);\n    fireEvent.press(approve);\n    expect(await within(sheet).findByText(`Added after your review: ${PHONE}.`, {}, { timeout: 10_000 })).toBeTruthy();\n    expect(sqlCount(acc.id, `title = '${PHONE}'`)).toBe(1);\n    expect(sqlCount(acc.id)).toBe(1);\n    expect(reused()).toBe(reusedBefore);\n    expect(within(sheet).queryByRole('button', { name: /Approve and add/ })).toBeNull();\n    expect(await within(sheet).findByRole('button', { name: `${PHONE}, Not started` }, { timeout: 10_000 })).toBeTruthy();\n    expect(JSON.stringify(mockCapture.mock.calls)).not.toContain(PHONE);\n  }, 90_000);\n\n  it('a lost reply to the revised review approval is looked up before anything else; a failed lookup stays unresolved and never writes again', async () => {\n    // Wrong if: the review approval is sent twice, a failed lookup is shown as saved or\n    // as not saved, or approval stays available while the outcome is unknown.\n    const acc = await newAccount('plan-f');\n    mockUserId = acc.id;\n    psql(`create function public.test364_mobile_fault() returns trigger language plpgsql as $f$\n            begin if new.title = '${PHONE}' then raise exception 'injected fault'; end if; return new; end $f$;\n          create trigger test364_mobile_fault before insert on custom_checklist_tasks\n            for each row execute function public.test364_mobile_fault();`);\n    let saved: any;\n    try {\n      saved = await savedPlanFor(acc);\n    } finally {\n      psql('drop trigger test364_mobile_fault on custom_checklist_tasks; drop function public.test364_mobile_fault();');\n    }\n    await http(`/rest/v1/user_onboarding_profiles?id=eq.${acc.id}`, {\n      method: 'PATCH', jwt: acc.jwt, body: JSON.stringify({ city: 'Surrey' }),\n    });\n    const retried = await actions(acc.jwt, {\n      action: 'plan_retry', operation_id: (globalThis.crypto as Crypto).randomUUID(),\n      receipt_operation_id: saved.operation_id, authorization: { kind: 'ui_control' },\n    }, 'ios');\n    expect(retried.json.receipt.results[0].outcome).toBe('needs_review');\n    let applies = 0;\n    let lookups = 0;\n    global.fetch = (async (url: any, init: any) => {\n      const body = String(init?.body ?? '');\n      if (body.includes('\"action\":\"plan_apply\"')) {\n        applies++;\n        await realFetch(url, init);\n        throw new TypeError('Network request failed');\n      }\n      if (body.includes('\"action\":\"plan_status\"') && ++lookups === 1) throw new TypeError('Network request failed');\n      return realFetch(url, init);\n    }) as typeof fetch;\n    mount();\n    fireEvent.press(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, .*needs your review`) }, { timeout: 10_000 }));\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await enabledButton(within(sheet), 'Approve and add 1 task'));\n    expect(await within(sheet).findByText('We could not check the result. The change may or may not have saved.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(isEnabled(within(sheet).getByRole('button', { name: 'Approve and add 1 task' }))).toBe(false);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Check again' }));\n    expect(await within(sheet).findByText(`Added after your review: ${PHONE}.`, {}, { timeout: 10_000 })).toBeTruthy();\n    expect(applies).toBe(1);\n    expect(sqlCount(acc.id)).toBe(1);\n  }, 60_000);\n\n  it('two unfinished retry reviews both stay reachable after a restart; each is approved on its own', async () => {\n    // Wrong if: after a restart either review is missing, Retry is offered for an addition\n    // waiting in a review, approving one review removes or changes the other, an approval\n    // adds the wrong task or two, the saved addition changes, or the typed message is lost.\n    const LIBRARY = 'Get a library card';\n    const acc = await newAccount('plan-g');\n    mockUserId = acc.id;\n    const fault = (titles: string[]) =>\n      psql(`create or replace function public.test364_mobile_fault2() returns trigger language plpgsql as $f$\n              begin if new.title in (${titles.map(t => `'${t}'`).join(', ') || 'null'}) then raise exception 'injected fault'; end if; return new; end $f$;`);\n    fault([PHONE, LIBRARY]);\n    psql(`create trigger test364_mobile_fault2 before insert on custom_checklist_tasks\n            for each row execute function public.test364_mobile_fault2();`);\n    try {\n      const p = await actions(acc.jwt, { action: 'plan_prepare', goal: GOAL,\n        items: [...SUGGESTION.items, { kind: 'new', title: LIBRARY }] });\n      const draft = p.json.plan_proposal;\n      const saved = await actions(acc.jwt, {\n        action: 'plan_apply', operation_id: (globalThis.crypto as Crypto).randomUUID(),\n        authorization: { kind: 'approved_proposal', proposal_id: draft.plan_proposal_id, proposal_revision: draft.proposal_revision },\n        items: draft.items,\n      }, 'ios');\n      expect(saved.json.receipt.results.map((r: { outcome: string }) => r.outcome)).toEqual(['reused', 'reused', 'failed', 'failed']);\n      fault([LIBRARY]);\n      // The user adds their own phone task elsewhere: Retry asks how to treat the match.\n      const mine = await http('/rest/v1/custom_checklist_tasks', {\n        method: 'POST', jwt: acc.jwt, headers: { prefer: 'return=representation' },\n        body: JSON.stringify({ user_id: acc.id, title: PHONE, description: '', priority: 'Do soon' }),\n      });\n      expect(mine.status).toBeLessThan(300);\n\n      const first = mount();\n      fireEvent.changeText(composer(), 'Keep this question');\n      fireEvent.press(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 }));\n      let sheet = await screen.findByTestId('companion-task-sheet');\n      fireEvent.press(await enabledButton(within(sheet), 'Try adding 2 tasks again'));\n      await within(sheet).findByRole('checkbox', { name: `Add ${PHONE}` }, { timeout: 10_000 });\n      // The library card failed again; a relevant change opens a separate review for it.\n      await http(`/rest/v1/user_onboarding_profiles?id=eq.${acc.id}`, {\n        method: 'PATCH', jwt: acc.jwt, body: JSON.stringify({ city: 'Surrey' }),\n      });\n      fireEvent.press(await enabledButton(within(sheet), 'Try adding 1 task again'));\n      await within(sheet).findByRole('checkbox', { name: `Add ${LIBRARY}` }, { timeout: 10_000 });\n      fault([]);\n\n      // A restart: new query client, no store state. Both reviews are reached from the entry.\n      first.unmount();\n      clients.splice(0).forEach(client => client.clear());\n      clearPlanStores(null);\n      mount();\n      fireEvent.changeText(composer(), 'Keep this question');\n      fireEvent.press(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, .*needs your review`) }, { timeout: 10_000 }));\n      sheet = await screen.findByTestId('companion-task-sheet');\n      await within(sheet).findByRole('checkbox', { name: `Add ${LIBRARY}` }, { timeout: 10_000 });\n      expect(within(sheet).queryByRole('checkbox', { name: `Add ${PHONE}` })).not.toBeNull();\n      expect(within(sheet).queryByRole('button', { name: /Try adding/ })).toBeNull();\n      // Each open review is its own section, named by what it would add.\n      const review = (title: string) => {\n        const named = within(sheet).getAllByTestId('plan-retry-review')\n          .filter(s => within(s).queryByRole('header', { name: `Review the remaining change: ${title}` }));\n        expect(named).toHaveLength(1);\n        return within(named[0]);\n      };\n\n      // Approving the library-card review leaves the phone review as it was.\n      fireEvent.press(await enabledButton(review(LIBRARY), 'Approve and add 1 task'));\n      expect(await within(sheet).findByText(`Added after your review: ${LIBRARY}.`, {}, { timeout: 10_000 })).toBeTruthy();\n      expect(sqlCount(acc.id, `title = '${LIBRARY}'`)).toBe(1);\n      expect(within(sheet).getByRole('checkbox', { name: `Add ${PHONE}` }).props.accessibilityState.checked).toBe(true);\n      expect(within(sheet).getByText(`You may already have this task: ${PHONE}`)).toBeTruthy();\n\n      // The phone review: the user keeps their own task instead of adding another.\n      fireEvent.press(await enabledButton(within(sheet), 'Use the task I have'));\n      fireEvent.press(await enabledButton(within(sheet), 'Save without adding it'));\n      expect(await within(sheet).findByText(`Using the task you already have: ${PHONE}.`, {}, { timeout: 10_000 })).toBeTruthy();\n      expect(sqlCount(acc.id, `title = '${PHONE}'`)).toBe(1);\n      expect(sqlCount(acc.id)).toBe(2);\n      expect(within(sheet).queryByRole('button', { name: /Approve and add|Save without adding/ })).toBeNull();\n      expect(composer().props.value).toBe('Keep this question');\n    } finally {\n      psql('drop trigger if exists test364_mobile_fault2 on custom_checklist_tasks; drop function if exists public.test364_mobile_fault2();');\n    }\n  }, 120_000);\n\n  it(\"an account change hides the previous account's plan entry, cards and open plan before the next account renders\", async () => {\n    const a = await newAccount('plan-d1');\n    const b = await newAccount('plan-d2');\n    mockUserId = a.id;\n    await savedPlanFor(a);\n    mount();\n    const entry = await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 });\n    fireEvent.press(entry);\n    await screen.findByTestId('companion-task-sheet');\n    switchAccount(b.id);\n    expect(screen.queryByText(GOAL)).toBeNull();\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    // B has no plan: once B's read answers, no plan entry and none of A's data.\n    await waitFor(() => expect(screen.queryByText('Checking your saved plan…')).toBeNull(), { timeout: 10_000 });\n    expect(screen.queryByRole('button', { name: /Your plan/ })).toBeNull();\n    expect(screen.queryByText(GOAL)).toBeNull();\n  }, 60_000);\n});\n\nif (!enabled) {\n  it('local stack checks are skipped: ACTIONS_API_URL, ACTIONS_ANON_KEY and ACTIONS_SERVICE_ROLE_KEY are not set', () => {\n    expect(enabled).toBe(false);\n  });\n}"}},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":823,"column":15,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":823,"endColumn":38},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":827,"column":14,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":827,"endColumn":30},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":833,"column":32,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":833,"endColumn":55},{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'entry' is assigned a value but never used.","line":853,"column":17,"nodeType":"Identifier","messageId":"unusedVar","endLine":853,"endColumn":22}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":13,"fixableErrorCount":0,"fixableWarningCount":4,"source":"// Mounted acceptance of settlement plans (mobile-app#364, direction B) against the real\n// local stack: the actual Companion screen, send hook, plan entry, plan cards and the\n// task bottom sheet send real HTTP requests with real user JWTs to the real\n// companion-actions edge function, which writes through this repo's migrations to a\n// real Postgres with RLS. Conversations and messages are saved to the same database\n// with the user's JWT (PostgREST). Only the model stream, Sanity content and\n// generation-allowance hooks are stand-ins; the model answer carries the typed plan\n// suggestion exactly as rag-query returns it (web repo index_companion_context_test.ts).\n//\n// Runs only when ACTIONS_API_URL, ACTIONS_ANON_KEY and ACTIONS_SERVICE_ROLE_KEY point at\n// the disposable 127.0.0.1 stack of the web repo (supabase/tests/companion-actions/run.sh,\n// ACTIONS_KEEP=1). See DOCS/companion-actions/364-plan.md.\n// Enabled runs must explicitly name that project's ACTIONS_DB_CONTAINER and\n// ACTIONS_REST_CONTAINER. There is no default container selection.\nimport React from 'react';\nimport { act, fireEvent, render, screen, waitFor, within } from '@testing-library/react-native';\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query';\nimport { createTestQueryClient } from '@/testSupport/queryClient';\nimport { createInstance } from 'i18next';\nimport { I18nextProvider, initReactI18next } from 'react-i18next';\nimport { AccessibilityInfo, StyleSheet, TouchableOpacity, View, Text } from 'react-native';\nimport en from '@/i18n/locales/en/translation.json';\nimport { execFileSync } from 'child_process';\nimport * as fs from 'fs';\nimport * as path from 'path';\n\nconst API_URL = process.env.ACTIONS_API_URL ?? '';\nconst ANON_KEY = process.env.ACTIONS_ANON_KEY ?? '';\nconst SERVICE_KEY = process.env.ACTIONS_SERVICE_ROLE_KEY ?? '';\nconst DB_CONTAINER = process.env.ACTIONS_DB_CONTAINER?.trim() ?? '';\nconst REST_CONTAINER = process.env.ACTIONS_REST_CONTAINER?.trim() ?? '';\nconst enabled = /^http:\\/\\/127\\.0\\.0\\.1:\\d+$/.test(API_URL) && Boolean(ANON_KEY && SERVICE_KEY);\nif (enabled && (!DB_CONTAINER || !REST_CONTAINER)) {\n  throw new Error(\n    'ACTIONS_DB_CONTAINER and ACTIONS_REST_CONTAINER are required for enabled local-stack tests.'\n  );\n}\nprocess.env.EXPO_PUBLIC_SUPABASE_URL = API_URL;\nprocess.env.EXPO_PUBLIC_SUPABASE_ANON_KEY = ANON_KEY;\nconst mockJwts = new Map<string, string>();\n\nconst mockChecklistRows:any[]=[];\nconst mockLegacyCompleted=jest.fn();\nlet mockUserId = 'user-1';\nlet mockCapture: jest.Mock = jest.fn();\nconst mockAuthListeners = new Set<(event: string, session: unknown) => void>();\nconst mockPush = jest.fn();\njest.mock('expo-router', () => ({\n  useRouter: () => ({ push: mockPush, replace: jest.fn() }),\n  useLocalSearchParams: () => ({}),\n}));\njest.mock('@react-navigation/native', () => {\n  const React = require('react');\n  return {\n    useFocusEffect: (callback: () => void) => {\n      React.useEffect(() => {\n        const cleanup = callback();\n        return typeof cleanup === 'function' ? cleanup : undefined;\n      }, [callback]);\n    },\n    useIsFocused: () => true,\n  };\n});\njest.mock('@react-navigation/bottom-tabs', () => ({ useBottomTabBarHeight: () => 0 }));\njest.mock('react-native-reanimated', () => {\n  const { View } = require('react-native');\n  const identity = (value: unknown) => value;\n  return {\n    __esModule: true,\n    default: { View },\n    useSharedValue: (value: unknown) => ({ value }),\n    useAnimatedStyle: () => ({}),\n    withTiming: identity,\n    Easing: { out: identity, in: identity, cubic: identity },\n    runOnJS: identity,\n    interpolate: identity,\n    Extrapolate: { CLAMP: 'clamp' },\n  };\n});\njest.mock('react-native-gesture-handler', () => {\n  const { View, TouchableOpacity } = require('react-native');\n  const gesture: any = { onUpdate: () => gesture, onEnd: () => gesture, enabled: () => gesture };\n  return {\n    Gesture: { Pan: () => gesture },\n    GestureDetector: ({ children }: { children: React.ReactNode }) => children,\n    GestureHandlerRootView: View,\n    TouchableOpacity,\n  };\n});\njest.mock('react-native-keyboard-controller', () => {\n  const { View } = require('react-native');\n  return {\n    KeyboardAvoidingView: View,\n    useReanimatedKeyboardAnimation: () => ({ height: { value: 0 }, progress: { value: 0 } }),\n  };\n});\njest.mock('expo-haptics', () => ({ impactAsync: jest.fn(), ImpactFeedbackStyle: { Medium: 'medium' } }));\njest.mock('@expo/vector-icons/MaterialIcons', () => () => null);\njest.mock('expo-constants', () => ({\n  __esModule: true,\n  default: { expoConfig: { version: '9.9.9', extra: {} } },\n}));\nconst mockPostHog = { capture: (...args: unknown[]) => mockCapture(...args), screen: () => {} };\njest.mock('posthog-react-native', () => ({ usePostHog: () => mockPostHog }));\njest.mock('@/context/HapticsContext', () => ({ useHapticsPreference: () => ({ hapticsEnabled: false }) }));\nconst mockRefreshStage = jest.fn().mockResolvedValue(undefined);\nconst mockApplyConfirmedArrival = jest.fn();\njest.mock('@/hooks/onboarding/useUserStage', () => ({\n  useUserStage: () => ({\n    currentStage: 0,\n    stageChanged: false,\n    arrivalDate: null,\n    userId: mockUserId,\n    refreshStage: mockRefreshStage,\n    applyConfirmedArrival: mockApplyConfirmedArrival,\n    isLoading: false,\n  }),\n}));\njest.mock('@/hooks/checklist/useRefreshingToday', () => ({\n  useRefreshingToday: () => new Date(2026, 9, 27, 12, 0, 0),\n}));\nconst mockRefreshUser = jest.fn();\njest.mock('@/context/UserContext', () => ({\n  useCurrentUser: () => ({ currentUser: { id: mockUserId, isPremium: false }, refreshUser: mockRefreshUser }),\n}));\n\n// Conversations and messages: the same tables the app uses, written and read with the\n// signed-in user's JWT through PostgREST (row-level security applies).\nconst mockRest = (pathname: string, init: { method: string; body?: unknown; prefer?: string }) =>\n  (globalThis as any).__planRealFetch(`${process.env.ACTIONS_API_URL}${pathname}`, {\n    method: init.method,\n    headers: {\n      'content-type': 'application/json',\n      apikey: process.env.ACTIONS_ANON_KEY,\n      authorization: `Bearer ${mockJwts.get(mockUserId)}`,\n      ...(init.prefer ? { prefer: init.prefer } : {}),\n    },\n    body: init.body === undefined ? undefined : JSON.stringify(init.body),\n  }).then(async (res: Response) => {\n    const text = await res.text();\n    if (!res.ok) throw new Error(`rest ${pathname} ${res.status} ${text}`);\n    return text ? JSON.parse(text) : null;\n  });\njest.mock('@/services/companion/createConversation', () => ({\n  createConversation: jest.fn(async () => {\n    const [row] = await mockRest('/rest/v1/conversations?select=id,conversation_identifier', {\n      method: 'POST',\n      body: { user_id: mockUserId, title: 'Plan' },\n      prefer: 'return=representation',\n    });\n    return { conversation_identifier: row.conversation_identifier, id: row.id };\n  }),\n}));\njest.mock('@/services/companion/saveMessage', () => ({\n  saveMessage: jest.fn(async (p: { conversationIdentifier: string; role: string; content: string }) => {\n    const [conv] = await mockRest(\n      `/rest/v1/conversations?select=id&conversation_identifier=eq.${p.conversationIdentifier}`,\n      { method: 'GET' }\n    );\n    const [row] = await mockRest('/rest/v1/messages?select=id', {\n      method: 'POST',\n      body: { conversation_id: conv.id, role: p.role, content: p.content },\n      prefer: 'return=representation',\n    });\n    return { id: row.id };\n  }),\n}));\njest.mock('@/services/companion/getConversationMessages', () => ({\n  getConversationMessages: jest.fn(async (conversation: string) => {\n    const rows = await mockRest(\n      `/rest/v1/messages?select=id,role,content,created_at,conversations!inner(conversation_identifier)&conversations.conversation_identifier=eq.${conversation}&order=id`,\n      { method: 'GET' }\n    );\n    return rows.map((m: any) => ({ id: m.id, role: m.role, content: m.content, sources: null, created_at: m.created_at }));\n  }),\n}));\njest.mock('@/services/companion/getConversations', () => ({ getConversations: jest.fn(async () => []) }));\nlet mockMessageCount = 0;\njest.mock('@/hooks/companion/useChatbotUsage', () => ({\n  useChatbotUsage: () => ({ data: { message_count: mockMessageCount } }),\n}));\njest.mock('@/hooks/companion/useCompanionReviewPrompt', () => ({ useCompanionReviewPrompt: () => {} }));\njest.mock('@/hooks/companion/usePersonalizedStarters', () => ({ usePersonalizedStarters: () => ({ data: undefined }) }));\nconst mockStream = jest.fn();\njest.mock('@/utils/gemini', () => ({\n  AICompanionBusyError: class extends Error {},\n  AICompanionLimitError: class extends Error {},\n  streamGeminiAPI: (...a: unknown[]) => mockStream(...a),\n}));\njest.mock('@/components/companion/TypingIndicator', () => ({ TypingIndicator: () => null }));\njest.mock('@/context/ToastContext', () => ({ useToast: () => ({ showToast: jest.fn() }) }));\njest.mock('@/components/companion/AnimatedDottedBackground', () => ({ AnimatedDottedBackground: () => null }));\njest.mock('@/components/companion/StarterPrompts', () => ({ StarterPrompts: () => null }));\njest.mock('@/components/companion/PartnerSpotlightBanner', () => () => null);\njest.mock('@/components/icons/SendIcon.svg', () => () => null);\njest.mock('lucide-react-native', () => ({ History: () => null, Plus: () => null }));\njest.mock('@/components/common/BottomSheet', () => ({ __esModule: true, default: () => null }));\njest.mock('react-native-safe-area-context', () => ({\n  useSafeAreaInsets: () => ({ top: 0, bottom: 0, left: 0, right: 0 }),\n}));\njest.mock('@/hooks/sanity/useSanityLanguage', () => ({ useSanityLanguage: () => 'en' }));\njest.mock('@/lib/supabase', () => ({\n  supabase: {\n    from:(table:string)=>{\n      const sdk=require('@supabase/supabase-js').createClient(process.env.ACTIONS_API_URL,process.env.ACTIONS_ANON_KEY,{auth:{persistSession:false,autoRefreshToken:false},global:{fetch:(globalThis as any).__planRealFetch,headers:{Authorization:`Bearer ${mockJwts.get(mockUserId)}`}}});\n      return sdk.from(table);\n    },\n    auth: {\n      getUser: async () => ({ data: { user: { id: mockUserId } } }),\n      getSession: async () => ({\n        data: { session: { user: { id: mockUserId }, access_token: mockJwts.get(mockUserId) } },\n      }),\n      onAuthStateChange: (listener: (event: string, session: unknown) => void) => {\n        mockAuthListeners.add(listener);\n        return { data: { subscription: { unsubscribe: () => mockAuthListeners.delete(listener) } } };\n      },\n    },\n  },\n}));\njest.mock('@/services/onboarding/getOnboardingProfile', () => ({\n  getOnboardingProfile: jest.fn(async () => ({ persona: 'skilled_worker', province: 'British Columbia' })),\n}));\njest.mock('@/sanity-custom', () => ({\n  sanityClient: {\n    fetch: jest.fn(async () => [\n      { _id: 'sin-number', _type: 'checklist', title: 'Get your SIN', class: 'do_now', class_order: 1 },\n      { _id: 'bank-account', _type: 'checklist', title: 'Open a bank account', class: 'do_now', class_order: 2 },\n    ]),\n  },\n}));\njest.mock('@/services/checklist/getUserTasks', () => ({ getUserTasks: jest.fn().mockResolvedValue([]) }));\njest.mock('@/services/checklist/customChecklistTasks', () => ({\n  getCustomChecklistTasks: jest.fn().mockResolvedValue([]),\n  deleteCustomChecklistTask: jest.fn(),\n  setCustomChecklistTaskCompletion: jest.fn(async (input:any)=>{await jest.requireActual('@/services/checklist/customChecklistTasks').setCustomChecklistTaskCompletion(input);mockLegacyCompleted();}),\n}));\njest.mock('@/services/checklist/checklistTaskOrder', () => ({\n  getChecklistTaskOrders: jest.fn().mockResolvedValue([]),\n  upsertChecklistTaskOrder: jest.fn(),\n}));\njest.mock('@/services/checklist/setChecklistItemCompletion', () => ({ setChecklistItemCompletion: jest.fn() }));\njest.mock('@/services/checklist/setChecklistItemDismissed', () => ({ setChecklistItemDismissed: jest.fn() }));\njest.mock('@/components/home/HomeHeader', () => () => null);\njest.mock('@/components/LoadingScreen', () => () => null);\njest.mock('@/components/partners/SpotlightRow', () => () => null);\n\nimport CompanionScreen from '@/app/(tabs)/companion/index';\nimport { clearPlanStores } from '@/services/companionActions/planStore';\nimport { clearTaskActionStores } from '@/services/companionActions/taskActionStore';\n\nfunction testI18n() {\n  const i18n = createInstance();\n  void i18n.use(initReactI18next).init({\n    lng: 'en',\n    resources: { en: { translation: en } },\n    interpolation: { escapeValue: false },\n    initImmediate: false,\n  });\n  return i18n;\n}\n\nconst clients: QueryClient[] = [];\nfunction mount() {\n  // A new query client per mount (a client restart): nothing is shared but the server.\n  // The managed client also disposes resources removed during account changes.\n  const client = createTestQueryClient({ defaultOptions: { queries: { retry: false, gcTime: Infinity } } });\n  clients.push(client);\n  return render(\n    <QueryClientProvider client={client}>\n      <I18nextProvider i18n={testI18n()}>\n        <RetainedTabs />\n      </I18nextProvider>\n    </QueryClientProvider>\n  );\n}\n\nconst realFetch: typeof fetch = (globalThis as any).__realFetch ?? global.fetch;\n(globalThis as any).__planRealFetch = realFetch;\n\nasync function http(pathname: string, init: RequestInit & { key?: string; jwt?: string }) {\n  const res = await realFetch(`${API_URL}${pathname}`, {\n    ...init,\n    headers: {\n      'content-type': 'application/json',\n      apikey: init.key ?? ANON_KEY,\n      authorization: `Bearer ${init.jwt ?? init.key ?? ANON_KEY}`,\n      ...(init.headers as Record<string, string> | undefined),\n    },\n  });\n  const text = await res.text();\n  return { status: res.status, json: text ? JSON.parse(text) : null };\n}\n\nfunction psql(sqlText: string) {\n  return execFileSync(\n    'docker',\n    ['exec', '-i', DB_CONTAINER, 'psql', '-v', 'ON_ERROR_STOP=1', '-qtA', '-U', 'postgres', '-d', 'postgres'],\n    { input: sqlText, stdio: ['pipe', 'pipe', 'pipe'] }\n  ).toString().trim();\n}\n\nasync function newAccount(label: string) {\n  const email = `${label}-${Date.now()}@mobile364.invalid`;\n  const password = 'mobile-plans-1';\n  const created = await http('/auth/v1/admin/users', {\n    method: 'POST',\n    key: SERVICE_KEY,\n    body: JSON.stringify({ email, password, email_confirm: true }),\n  });\n  if (created.status !== 200) throw new Error(`createUser ${created.status}`);\n  const token = await http('/auth/v1/token?grant_type=password', {\n    method: 'POST',\n    body: JSON.stringify({ email, password }),\n  });\n  if (token.status !== 200) throw new Error(`signIn ${token.status}`);\n  const id = created.json.id as string;\n  const jwt = token.json.access_token as string;\n  mockJwts.set(id, jwt);\n  // The fictional Vancouver arrival: profile and the two existing Checklist tasks.\n  await http('/rest/v1/user_onboarding_profiles', {\n    method: 'POST',\n    jwt,\n    body: JSON.stringify({ id, persona: 'skilled_worker', city: 'Vancouver', province: 'British Columbia',\n      arrival_date: '2026-11-02T00:00:00Z', stage: 0, wants_reminders: false }),\n  });\n  for (const sanity of ['sin-number', 'bank-account']) {\n    await http('/rest/v1/user_tasks', {\n      method: 'POST',\n      jwt,\n      body: JSON.stringify({ user_id: id, sanity_checklist_id: sanity, completed: false }),\n    });\n  }\n  return { id, jwt };\n}\n\nconst actions = (jwt: string, body: Record<string, unknown>, platform = 'web') =>\n  http('/functions/v1/companion-actions', {\n    method: 'POST',\n    jwt,\n    body: JSON.stringify({ contract_version: 1, client: { platform, app_version: 'test' }, ...body }),\n  });\n\nconst GOAL = 'Your first week in Vancouver';\nconst PHONE = 'Set up phone service';\nconst SUGGESTION = {\n  type: 'plan',\n  version: 1,\n  goal: GOAL,\n  items: [\n    { kind: 'existing', task_ref: 'sanity:sin-number', label: 'Get your SIN' },\n    { kind: 'existing', task_ref: 'sanity:bank-account', label: 'Open a bank account' },\n    { kind: 'new', title: PHONE },\n  ],\n};\n\n/** The model answer, with the typed plan suggestion rag-query extracted. */\nfunction answersWithPlan() {\n  mockStream.mockImplementation(async (_q: string, _c: string, _h: unknown, cb: any) => {\n    cb.onMetadata({ sources: [], queryType: 'newcomer_settlement' });\n    cb.onComplete({ cleanAnswer: 'You already have your SIN and bank tasks. A phone plan helps with both.', actionProposal: SUGGESTION });\n  });\n}\n\nconst composer = () => screen.getByPlaceholderText('Ask anything...');\nconst sendButton = () => {\n  const button = screen.UNSAFE_getAllByType(TouchableOpacity).find(b => StyleSheet.flatten(b.props.style)?.borderRadius === 20);\n  if (!button) throw new Error('send control missing');\n  return button;\n};\nasync function send(text: string) {\n  fireEvent.changeText(await screen.findByPlaceholderText(/Ask anything|limit/i), text);\n  fireEvent.press(sendButton());\n}\nconst isEnabled = (el: { props: { accessibilityState?: { disabled?: boolean } } }) =>\n  el.props.accessibilityState?.disabled !== true;\nasync function enabledButton(scope: ReturnType<typeof within>, name: string | RegExp) {\n  await scope.findByRole('button', { name }, { timeout: 10_000 });\n  await waitFor(() => expect(isEnabled(scope.getByRole('button', { name }))).toBe(true), { timeout: 10_000 });\n  return scope.getByRole('button', { name });\n}\nconst sqlCount = (userId: string, where = 'true') =>\n  Number(psql(`select count(*) from custom_checklist_tasks where user_id = '${userId}' and ${where};`));\n\n/** A saved plan, made through the real endpoint as another platform would. */\nasync function savedPlanFor(acc: { id: string; jwt: string }) {\n  const p = await actions(acc.jwt, { action: 'plan_prepare', goal: GOAL, items: SUGGESTION.items });\n  const draft = p.json.plan_proposal;\n  const w = await actions(acc.jwt, {\n    action: 'plan_apply',\n    operation_id: (globalThis.crypto as Crypto).randomUUID(),\n    authorization: { kind: 'approved_proposal', proposal_id: draft.plan_proposal_id, proposal_revision: draft.proposal_revision },\n    items: draft.items,\n  }, 'ios');\n  if (w.status !== 200) throw new Error(`plan_apply ${w.status} ${JSON.stringify(w.json)}`);\n  return w.json;\n}\n\nfunction switchAccount(id: string) {\n  mockUserId = id;\n  act(() => {\n    for (const l of [...mockAuthListeners]) l('SIGNED_IN', { user: { id }, access_token: mockJwts.get(id) });\n  });\n}\n\nconst describeStack = enabled ? describe : describe.skip;\n\ndescribeStack('Settlement plans against the real local stack (mobile)', () => {\n  it('a saved task completion reconciles the plan entry without reopening the screen', async () => {\n    const acc = await newAccount('plan-progress');\n    mockUserId = acc.id;\n    const saved = await savedPlanFor(acc);\n    mount();\n    const entry = await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, 0 of 3 done`) }, { timeout: 10_000 });\n    fireEvent.changeText(composer(), 'Keep this question');\n    fireEvent.press(entry);\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await within(sheet).findByRole('button', { name: `${PHONE}, Not started` }));\n    await waitFor(() => expect(within(sheet).getByRole('radio', { name: 'Completed' })).not.toBeDisabled());\n    fireEvent.press(within(sheet).getByRole('radio', { name: 'Completed' }));\n    await within(sheet).findByText('Changed from Not started to Completed', {}, { timeout: 10_000 });\n    const current = await actions(acc.jwt, { action: 'read' });\n    const phoneRef = saved.receipt.results[2].task_ref;\n    expect(current.json.tasks.find((row: { task_ref: string }) => row.task_ref === phoneRef).state).toBe('completed');\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, 1 of 3 done`) }, { timeout: 10_000 });\n    expect(composer().props.value).toBe('Keep this question');\n  }, 60_000);\n  beforeAll(async () => {\n    const applied = (name: string) => psql(`select to_regclass('public.${name}') is not null;`) === 't';\n    const migrations = path.resolve(__dirname, '../../supabase/migrations');\n    if (!applied('companion_action_receipts'))\n      psql(fs.readFileSync(path.join(migrations, '20261025235536_companion_task_actions.sql'), 'utf8'));\n    if (psql(`select to_regprocedure('public.companion_prepare_proposal(uuid,jsonb,jsonb)') is not null;`) !== 't')\n      psql(fs.readFileSync(path.join(migrations, '20261026165156_companion_task_create.sql'), 'utf8'));\n    if (!applied('companion_plan_proposals'))\n      psql(fs.readFileSync(path.join(migrations, '20261027183338_companion_settlement_plan.sql'), 'utf8'));\n    psql(`update public.companion_feature_gate set enabled = true, min_contract_version = 1,\n            max_contract_version = 1, allowed_platforms = '{ios,android,web}';`);\n    execFileSync('docker', ['kill', '--signal=SIGUSR1', REST_CONTAINER], { stdio: 'ignore' });\n    for (let i = 0; i < 50; i++) {\n      const ready = await http('/rest/v1/rpc/companion_plans_read', {\n        method: 'POST',\n        key: SERVICE_KEY,\n        body: JSON.stringify({ p_user_id: '00000000-0000-0000-0000-000000000000' }),\n      });\n      if (ready.status === 200) break;\n      await new Promise(resolve => setTimeout(resolve, 200));\n    }\n  }, 60_000);\n\n  beforeEach(() => {\n    global.fetch = realFetch;\n    mockCapture = jest.fn();\n    mockStream.mockReset();\n    clearPlanStores(null);\n    clearTaskActionStores(null);\n  });\n  afterEach(() => {\n    global.fetch = realFetch;\n    clients.splice(0).forEach(client => client.clear());\n  });\n\n  it('a suggested plan is a draft that reuses two tasks and proposes one; excluding changes the count; approval adds exactly one task', async () => {\n    const acc = await newAccount('plan-a');\n    mockUserId = acc.id;\n    answersWithPlan();\n    mount();\n    await send('I arrive in Vancouver next week. Help me plan my first week.');\n\n    const card = await screen.findByTestId('plan-card', {}, { timeout: 10_000 });\n    expect(within(card).getByText('Draft plan · not saved yet')).toBeTruthy();\n    expect(within(card).getByText(GOAL)).toBeTruthy();\n    expect(within(card).getByText('2 tasks you already have · 1 new task')).toBeTruthy();\n    expect(sqlCount(acc.id)).toBe(0);\n    // The typed message stays while the user reviews.\n    fireEvent.changeText(composer(), 'My next question');\n\n    fireEvent.press(within(card).getByRole('button', { name: `Review plan: ${GOAL}` }));\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    expect(within(sheet).getByRole('header', { name: 'Review plan' })).toBeTruthy();\n    expect(await within(sheet).findByText('Get your SIN')).toBeTruthy();\n    expect(within(sheet).getByText('Open a bank account')).toBeTruthy();\n    expect(within(sheet).getAllByText('Already in your Checklist · Not started')).toHaveLength(2);\n    expect(within(sheet).getByText('City: Vancouver')).toBeTruthy();\n    const include = within(sheet).getByRole('checkbox', { name: `Add ${PHONE}` });\n    expect(include.props.accessibilityState.checked).toBe(true);\n    await enabledButton(within(sheet), 'Approve and add 1 task');\n\n    // Excluding the addition is a draft edit (a new revision): the count follows it.\n    fireEvent.press(include);\n    await enabledButton(within(sheet), 'Save plan with existing tasks');\n    expect(sqlCount(acc.id)).toBe(0);\n    fireEvent.press(within(sheet).getByRole('checkbox', { name: `Add ${PHONE}` }));\n    const approve = await enabledButton(within(sheet), 'Approve and add 1 task');\n\n    fireEvent.press(approve);\n    fireEvent.press(approve);\n    expect(await within(sheet).findByText('Added 1 task. Reused 2 tasks you already had.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(sqlCount(acc.id, `title = '${PHONE}'`)).toBe(1);\n    expect(Number(psql(`select count(*) from companion_plans where user_id = '${acc.id}';`))).toBe(1);\n\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    expect(composer().props.value).toBe('My next question');\n    // The persistent entry, outside any message, now names the saved plan.\n    const entry = await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 });\n    expect(within(entry).getByText('0 of 3 done')).toBeTruthy();\n    // Analytics carry categories and a count only.\n    const sent = JSON.stringify(mockCapture.mock.calls);\n    expect(sent).not.toContain(PHONE);\n    expect(sent).not.toContain(GOAL);\n  }, 60_000);\n\n  it('the plan entry resumes the saved plan after a restart with current progress, never reads as \"no plan\" while loading, and Undo removes only the added task after confirmation', async () => {\n    const acc = await newAccount('plan-b');\n    mockUserId = acc.id;\n    const saved = await savedPlanFor(acc);\n    const phoneRef = saved.receipt.results[2].task_ref as string;\n    // Progress made later on the web: the plan shows it, never a copy.\n    const st = await actions(acc.jwt, { action: 'apply', operation_id: (globalThis.crypto as Crypto).randomUUID(),\n      authorization: { kind: 'ui_control' }, operations: [{ type: 'task.set_state', task_ref: 'sanity:sin-number', state: 'completed', expected_revision: 1 }] });\n    expect(st.status).toBe(200);\n\n    // Hold the first plan read: the entry says it is checking, not that there is no plan.\n    let release!: () => void;\n    const held = new Promise<void>(r => (release = r));\n    let heldOnce = false;\n    global.fetch = (async (url: any, init: any) => {\n      if (!heldOnce && String(init?.body ?? '').includes('\"action\":\"plans\"')) {\n        heldOnce = true;\n        await held;\n      }\n      return realFetch(url, init);\n    }) as typeof fetch;\n    mount();\n    expect(await screen.findByText('Checking your saved plan…')).toBeTruthy();\n    release();\n    const entry = await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 });\n    expect(within(entry).getByText('1 of 3 done')).toBeTruthy();\n\n    fireEvent.press(entry);\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    expect(await within(sheet).findByText('Saved plan · uses your shared Checklist')).toBeTruthy();\n    expect(within(sheet).getByRole('button', { name: /Get your SIN, Completed/ })).toBeTruthy();\n    expect(within(sheet).getByRole('button', { name: new RegExp(`${PHONE}, Not started`) })).toBeTruthy();\n    expect(within(sheet).getByText('Added 1 task. Reused 2 tasks you already had.')).toBeTruthy();\n\n    // Undo removes a task: it asks first. Keep sends nothing.\n    fireEvent.press(await enabledButton(within(sheet), 'Undo plan change'));\n    expect(await within(sheet).findByText(`This removes 1 task the plan added: ${PHONE}. Your other tasks stay as they are.`)).toBeTruthy();\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Keep plan' }));\n    expect(sqlCount(acc.id, 'removed_at is null')).toBe(1);\n    fireEvent.press(await enabledButton(within(sheet), 'Undo plan change'));\n    fireEvent.press(await enabledButton(within(sheet), 'Undo plan'));\n    expect(await within(sheet).findByText('Plan undone. Removed 1 task.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(sqlCount(acc.id, 'removed_at is null')).toBe(0);\n    expect(psql(`select completed from user_tasks where user_id = '${acc.id}' and sanity_checklist_id = 'sin-number';`)).toBe('t');\n    expect(phoneRef).toMatch(/^custom:/);\n  }, 60_000);\n\n  it('a reply lost after commit is looked up and shown as saved; a failed lookup stays unresolved and never writes', async () => {\n    const acc = await newAccount('plan-c');\n    mockUserId = acc.id;\n    const p = await actions(acc.jwt, { action: 'plan_prepare', goal: GOAL, items: SUGGESTION.items });\n    expect(p.status).toBe(200);\n    let applies = 0;\n    let statusCalls = 0;\n    global.fetch = (async (url: any, init: any) => {\n      const body = String(init?.body ?? '');\n      if (body.includes('\"action\":\"plan_apply\"')) {\n        applies++;\n        await realFetch(url, init); // committed on the server\n        throw new TypeError('Network request failed'); // the reply never arrives\n      }\n      if (body.includes('\"action\":\"plan_status\"') && ++statusCalls === 1) {\n        throw new TypeError('Network request failed');\n      }\n      return realFetch(url, init);\n    }) as typeof fetch;\n    mount();\n    const entry = await screen.findByRole('button', { name: new RegExp(`Draft plan, ${GOAL}`) }, { timeout: 10_000 });\n    fireEvent.press(entry);\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await enabledButton(within(sheet), 'Approve and add 1 task'));\n    expect(await within(sheet).findByText('We could not check the result. The change may or may not have saved.', {}, { timeout: 10_000 })).toBeTruthy();\n    // Unresolved: approval is off; only a lookup is offered.\n    expect(isEnabled(within(sheet).getByRole('button', { name: 'Approve and add 1 task' }))).toBe(false);\n    expect(applies).toBe(1);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Check again' }));\n    expect(await within(sheet).findByText('Added 1 task. Reused 2 tasks you already had.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(applies).toBe(1);\n    expect(sqlCount(acc.id)).toBe(1);\n  }, 60_000);\n\n  it('a retry after a relevant profile change asks for a new approval of the remaining addition, still reachable after a restart; approving adds exactly one task', async () => {\n    // Wrong if: the needs-review result is not shown, the same Retry is offered again,\n    // the review is missing the remaining addition or its before/current context, it is\n    // gone after a restart, approval adds zero or two tasks, or the reused tasks change.\n    const acc = await newAccount('plan-e');\n    mockUserId = acc.id;\n    psql(`create function public.test364_mobile_fault() returns trigger language plpgsql as $f$\n            begin if new.title = '${PHONE}' then raise exception 'injected fault'; end if; return new; end $f$;\n          create trigger test364_mobile_fault before insert on custom_checklist_tasks\n            for each row execute function public.test364_mobile_fault();`);\n    let saved: any;\n    try {\n      saved = await savedPlanFor(acc);\n    } finally {\n      psql('drop trigger test364_mobile_fault on custom_checklist_tasks; drop function public.test364_mobile_fault();');\n    }\n    expect(saved.status).toBe('partial');\n    const reused = () =>\n      psql(`select string_agg(sanity_checklist_id || ':' || coalesce(revision, 0) || ':' || completed, ',' order by sanity_checklist_id)\n              from user_tasks where user_id = '${acc.id}';`);\n    const reusedBefore = reused();\n\n    const first = mount();\n    fireEvent.press(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 }));\n    let sheet = await screen.findByTestId('companion-task-sheet');\n    expect(await within(sheet).findByText(`Could not add: ${PHONE}. Everything else is saved.`)).toBeTruthy();\n    const patched = await http(`/rest/v1/user_onboarding_profiles?id=eq.${acc.id}`, {\n      method: 'PATCH', jwt: acc.jwt, body: JSON.stringify({ city: 'Surrey' }),\n    });\n    expect(patched.status).toBeLessThan(300);\n    fireEvent.press(await enabledButton(within(sheet), 'Try adding 1 task again'));\n    expect(await within(sheet).findByText(`Not added, because something changed: ${PHONE}.`, {}, { timeout: 10_000 })).toBeTruthy();\n    expect(await within(sheet).findByText('City: Surrey', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(within(sheet).getByText('Before: Vancouver')).toBeTruthy();\n    expect(within(sheet).getByRole('checkbox', { name: `Add ${PHONE}` }).props.accessibilityState.checked).toBe(true);\n    await enabledButton(within(sheet), 'Approve and add 1 task');\n    expect(within(sheet).queryByRole('button', { name: 'Try adding 1 task again' })).toBeNull();\n    expect(sqlCount(acc.id)).toBe(0);\n\n    // A restart: new query client, no store state. The review is reached from the entry.\n    first.unmount();\n    clients.splice(0).forEach(client => client.clear());\n    clearPlanStores(null);\n    mount();\n    const entry = await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, .*needs your review`) }, { timeout: 10_000 });\n    fireEvent.press(entry);\n    sheet = await screen.findByTestId('companion-task-sheet');\n    expect(await within(sheet).findByText('City: Surrey', {}, { timeout: 10_000 })).toBeTruthy();\n    // It changes again before approval: nothing is written and the refreshed review shows it.\n    await http(`/rest/v1/user_onboarding_profiles?id=eq.${acc.id}`, {\n      method: 'PATCH', jwt: acc.jwt, body: JSON.stringify({ city: 'Burnaby' }),\n    });\n    fireEvent.press(await enabledButton(within(sheet), 'Approve and add 1 task'));\n    expect(await within(sheet).findByText('City: Burnaby', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(within(sheet).getByText('Before: Surrey')).toBeTruthy();\n    expect(sqlCount(acc.id)).toBe(0);\n    const approve = await enabledButton(within(sheet), 'Approve and add 1 task');\n    fireEvent.press(approve);\n    fireEvent.press(approve);\n    expect(await within(sheet).findByText(`Added after your review: ${PHONE}.`, {}, { timeout: 10_000 })).toBeTruthy();\n    expect(sqlCount(acc.id, `title = '${PHONE}'`)).toBe(1);\n    expect(sqlCount(acc.id)).toBe(1);\n    expect(reused()).toBe(reusedBefore);\n    expect(within(sheet).queryByRole('button', { name: /Approve and add/ })).toBeNull();\n    expect(await within(sheet).findByRole('button', { name: `${PHONE}, Not started` }, { timeout: 10_000 })).toBeTruthy();\n    expect(JSON.stringify(mockCapture.mock.calls)).not.toContain(PHONE);\n  }, 90_000);\n\n  it('a lost reply to the revised review approval is looked up before anything else; a failed lookup stays unresolved and never writes again', async () => {\n    // Wrong if: the review approval is sent twice, a failed lookup is shown as saved or\n    // as not saved, or approval stays available while the outcome is unknown.\n    const acc = await newAccount('plan-f');\n    mockUserId = acc.id;\n    psql(`create function public.test364_mobile_fault() returns trigger language plpgsql as $f$\n            begin if new.title = '${PHONE}' then raise exception 'injected fault'; end if; return new; end $f$;\n          create trigger test364_mobile_fault before insert on custom_checklist_tasks\n            for each row execute function public.test364_mobile_fault();`);\n    let saved: any;\n    try {\n      saved = await savedPlanFor(acc);\n    } finally {\n      psql('drop trigger test364_mobile_fault on custom_checklist_tasks; drop function public.test364_mobile_fault();');\n    }\n    await http(`/rest/v1/user_onboarding_profiles?id=eq.${acc.id}`, {\n      method: 'PATCH', jwt: acc.jwt, body: JSON.stringify({ city: 'Surrey' }),\n    });\n    const retried = await actions(acc.jwt, {\n      action: 'plan_retry', operation_id: (globalThis.crypto as Crypto).randomUUID(),\n      receipt_operation_id: saved.operation_id, authorization: { kind: 'ui_control' },\n    }, 'ios');\n    expect(retried.json.receipt.results[0].outcome).toBe('needs_review');\n    let applies = 0;\n    let lookups = 0;\n    global.fetch = (async (url: any, init: any) => {\n      const body = String(init?.body ?? '');\n      if (body.includes('\"action\":\"plan_apply\"')) {\n        applies++;\n        await realFetch(url, init);\n        throw new TypeError('Network request failed');\n      }\n      if (body.includes('\"action\":\"plan_status\"') && ++lookups === 1) throw new TypeError('Network request failed');\n      return realFetch(url, init);\n    }) as typeof fetch;\n    mount();\n    fireEvent.press(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, .*needs your review`) }, { timeout: 10_000 }));\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await enabledButton(within(sheet), 'Approve and add 1 task'));\n    expect(await within(sheet).findByText('We could not check the result. The change may or may not have saved.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(isEnabled(within(sheet).getByRole('button', { name: 'Approve and add 1 task' }))).toBe(false);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Check again' }));\n    expect(await within(sheet).findByText(`Added after your review: ${PHONE}.`, {}, { timeout: 10_000 })).toBeTruthy();\n    expect(applies).toBe(1);\n    expect(sqlCount(acc.id)).toBe(1);\n  }, 60_000);\n\n  it('two unfinished retry reviews both stay reachable after a restart; each is approved on its own', async () => {\n    // Wrong if: after a restart either review is missing, Retry is offered for an addition\n    // waiting in a review, approving one review removes or changes the other, an approval\n    // adds the wrong task or two, the saved addition changes, or the typed message is lost.\n    const LIBRARY = 'Get a library card';\n    const acc = await newAccount('plan-g');\n    mockUserId = acc.id;\n    const fault = (titles: string[]) =>\n      psql(`create or replace function public.test364_mobile_fault2() returns trigger language plpgsql as $f$\n              begin if new.title in (${titles.map(t => `'${t}'`).join(', ') || 'null'}) then raise exception 'injected fault'; end if; return new; end $f$;`);\n    fault([PHONE, LIBRARY]);\n    psql(`create trigger test364_mobile_fault2 before insert on custom_checklist_tasks\n            for each row execute function public.test364_mobile_fault2();`);\n    try {\n      const p = await actions(acc.jwt, { action: 'plan_prepare', goal: GOAL,\n        items: [...SUGGESTION.items, { kind: 'new', title: LIBRARY }] });\n      const draft = p.json.plan_proposal;\n      const saved = await actions(acc.jwt, {\n        action: 'plan_apply', operation_id: (globalThis.crypto as Crypto).randomUUID(),\n        authorization: { kind: 'approved_proposal', proposal_id: draft.plan_proposal_id, proposal_revision: draft.proposal_revision },\n        items: draft.items,\n      }, 'ios');\n      expect(saved.json.receipt.results.map((r: { outcome: string }) => r.outcome)).toEqual(['reused', 'reused', 'failed', 'failed']);\n      fault([LIBRARY]);\n      // The user adds their own phone task elsewhere: Retry asks how to treat the match.\n      const mine = await http('/rest/v1/custom_checklist_tasks', {\n        method: 'POST', jwt: acc.jwt, headers: { prefer: 'return=representation' },\n        body: JSON.stringify({ user_id: acc.id, title: PHONE, description: '', priority: 'Do soon' }),\n      });\n      expect(mine.status).toBeLessThan(300);\n\n      const first = mount();\n      fireEvent.changeText(composer(), 'Keep this question');\n      fireEvent.press(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 }));\n      let sheet = await screen.findByTestId('companion-task-sheet');\n      fireEvent.press(await enabledButton(within(sheet), 'Try adding 2 tasks again'));\n      await within(sheet).findByRole('checkbox', { name: `Add ${PHONE}` }, { timeout: 10_000 });\n      // The library card failed again; a relevant change opens a separate review for it.\n      await http(`/rest/v1/user_onboarding_profiles?id=eq.${acc.id}`, {\n        method: 'PATCH', jwt: acc.jwt, body: JSON.stringify({ city: 'Surrey' }),\n      });\n      fireEvent.press(await enabledButton(within(sheet), 'Try adding 1 task again'));\n      await within(sheet).findByRole('checkbox', { name: `Add ${LIBRARY}` }, { timeout: 10_000 });\n      fault([]);\n\n      // A restart: new query client, no store state. Both reviews are reached from the entry.\n      first.unmount();\n      clients.splice(0).forEach(client => client.clear());\n      clearPlanStores(null);\n      mount();\n      fireEvent.changeText(composer(), 'Keep this question');\n      fireEvent.press(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, .*needs your review`) }, { timeout: 10_000 }));\n      sheet = await screen.findByTestId('companion-task-sheet');\n      await within(sheet).findByRole('checkbox', { name: `Add ${LIBRARY}` }, { timeout: 10_000 });\n      expect(within(sheet).queryByRole('checkbox', { name: `Add ${PHONE}` })).not.toBeNull();\n      expect(within(sheet).queryByRole('button', { name: /Try adding/ })).toBeNull();\n      // Each open review is its own section, named by what it would add.\n      const review = (title: string) => {\n        const named = within(sheet).getAllByTestId('plan-retry-review')\n          .filter(s => within(s).queryByRole('header', { name: `Review the remaining change: ${title}` }));\n        expect(named).toHaveLength(1);\n        return within(named[0]);\n      };\n\n      // Approving the library-card review leaves the phone review as it was.\n      fireEvent.press(await enabledButton(review(LIBRARY), 'Approve and add 1 task'));\n      expect(await within(sheet).findByText(`Added after your review: ${LIBRARY}.`, {}, { timeout: 10_000 })).toBeTruthy();\n      expect(sqlCount(acc.id, `title = '${LIBRARY}'`)).toBe(1);\n      expect(within(sheet).getByRole('checkbox', { name: `Add ${PHONE}` }).props.accessibilityState.checked).toBe(true);\n      expect(within(sheet).getByText(`You may already have this task: ${PHONE}`)).toBeTruthy();\n\n      // The phone review: the user keeps their own task instead of adding another.\n      fireEvent.press(await enabledButton(within(sheet), 'Use the task I have'));\n      fireEvent.press(await enabledButton(within(sheet), 'Save without adding it'));\n      expect(await within(sheet).findByText(`Using the task you already have: ${PHONE}.`, {}, { timeout: 10_000 })).toBeTruthy();\n      expect(sqlCount(acc.id, `title = '${PHONE}'`)).toBe(1);\n      expect(sqlCount(acc.id)).toBe(2);\n      expect(within(sheet).queryByRole('button', { name: /Approve and add|Save without adding/ })).toBeNull();\n      expect(composer().props.value).toBe('Keep this question');\n    } finally {\n      psql('drop trigger if exists test364_mobile_fault2 on custom_checklist_tasks; drop function if exists public.test364_mobile_fault2();');\n    }\n  }, 120_000);\n\n  it(\"an account change hides the previous account's plan entry, cards and open plan before the next account renders\", async () => {\n    const a = await newAccount('plan-d1');\n    const b = await newAccount('plan-d2');\n    mockUserId = a.id;\n    await savedPlanFor(a);\n    mount();\n    const entry = await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 });\n    fireEvent.press(entry);\n    await screen.findByTestId('companion-task-sheet');\n    switchAccount(b.id);\n    expect(screen.queryByText(GOAL)).toBeNull();\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    // B has no plan: once B's read answers, no plan entry and none of A's data.\n    await waitFor(() => expect(screen.queryByText('Checking your saved plan…')).toBeNull(), { timeout: 10_000 });\n    expect(screen.queryByRole('button', { name: /Your plan/ })).toBeNull();\n    expect(screen.queryByText(GOAL)).toBeNull();\n  }, 60_000);\n});\n\nif (!enabled) {\n  it('local stack checks are skipped: ACTIONS_API_URL, ACTIONS_ANON_KEY and ACTIONS_SERVICE_ROLE_KEY are not set', () => {\n    expect(enabled).toBe(false);\n  });\n}\n\nimport ChecklistScreen from '@/app/(tabs)/Checklist';\njest.mock('react-native-confetti-cannon',()=>()=>null);\njest.mock('react-native-draggable-flatlist',()=>{\n const {View}=require('react-native');\n return {__esModule:true,default:({data,renderItem,ListHeaderComponent,ListFooterComponent}:any)=><View>{ListHeaderComponent}{data.map((item:any,index:number)=><View key={index}>{renderItem({item,drag:()=>{},isActive:false})}</View>)}{ListFooterComponent}</View>,ScaleDecorator:({children}:any)=>children};\n});\njest.mock('@/hooks/checklist/useChecklistTasks',()=>({useChecklistTasks:()=>{\n const React=require('react');const [tasks,setTasks]=React.useState(mockChecklistRows);\n return {tasks,setTasks,refetch:async()=>{},isLoading:false};\n}}));\njest.mock('@/hooks/checklist/useChecklistProfile',()=>({useChecklistProfile:()=>({persona:'skilled_worker',province:'British Columbia',isLoading:false,refresh:async()=>false})}));\njest.mock('@/components/checklist/ArrivalCountdownSection',()=>({ArrivalCountdownSection:()=>null}));\njest.mock('@/components/checklist/ChecklistItem',()=>({ChecklistItem:({task,onPress}:any)=>{\n const {TouchableOpacity,Text}=require('react-native');return <TouchableOpacity accessibilityRole='button' accessibilityLabel={`Checklist ${task.task.task_name}`} onPress={onPress}><Text>{task.task.task_name}</Text></TouchableOpacity>;\n}}));\nfunction RetainedTabs(){\n const [tab,setTab]=React.useState('companion');const [visited,setVisited]=React.useState(false);\n return <View>\n  <TouchableOpacity accessibilityRole='button' accessibilityLabel='Select Checklist tab' onPress={()=>{setVisited(true);setTab('checklist');}}><Text>Checklist</Text></TouchableOpacity>\n  <TouchableOpacity accessibilityRole='button' accessibilityLabel='Select Companion tab' onPress={()=>setTab('companion')}><Text>Companion</Text></TouchableOpacity>\n  <View style={{display:tab==='companion'?'flex':'none'}}><CompanionScreen/></View>\n  {visited&&<View style={{display:tab==='checklist'?'flex':'none'}}><ChecklistScreen/></View>}\n </View>;\n}\ndescribeStack('Independent retained mobile Checklist completion',()=>{\n beforeEach(()=>{global.fetch=realFetch;clearPlanStores(null);clearTaskActionStores(null);mockLegacyCompleted.mockClear();});\n afterEach(()=>{global.fetch=realFetch;clients.splice(0).forEach(c=>c.clear());});\n it('Checklist completion refreshes the retained Companion plan entry',async()=>{\n  // Falsifier: the real Checklist screen completion callback and service save Completed,\n  // but the retained Companion screen still shows its old plan count after tab return.\n  const acc=await newAccount('r3-native-legacy');mockUserId=acc.id;\n  const saved=await savedPlanFor(acc);const ref=saved.receipt.results[2].task_ref;\n  mockChecklistRows.splice(0,mockChecklistRows.length,{user_task_id:1,user_id:acc.id,task_id:null,sanity_checklist_id:null,custom_task_id:Number(ref.slice(7)),source:'custom',completed:false,completed_at:null,dismissed_at:null,task:{task_name:PHONE,task_description:'',priority:'Do soon'}});\n  mount();const entry=await screen.findByRole('button',{name:new RegExp(`Your plan, ${GOAL}, 0 of 3 done`)},{timeout:10_000});\n  fireEvent.changeText(composer(),'Retain my question');\n  fireEvent.press(screen.getByRole('button',{name:'Select Checklist tab'}));\n  fireEvent.press(await screen.findByRole('button',{name:`Checklist ${PHONE}`}));\n  fireEvent.press(await screen.findByRole('button',{name:en.checklist.markAsComplete}));\n  await waitFor(()=>expect(mockLegacyCompleted).toHaveBeenCalledTimes(1),{timeout:10_000});\n  const now=await actions(acc.jwt,{action:'read'});expect(now.json.tasks.find((t:any)=>t.task_ref===ref).state).toBe('completed');\n  fireEvent.press(screen.getByRole('button',{name:'Select Companion tab'}));\n  expect(composer().props.value).toBe('Retain my question');\n  await waitFor(()=>expect(screen.queryByRole('button',{name:new RegExp(`Your plan, ${GOAL}, 1 of 3 done`)})).not.toBeNull(),{timeout:2000});\n },60_000);\n});\n\n// Composition of #364 and #366 (integration reconciliation): the same real stack and the\n// actual Companion screen, plan entry, task sheet and step controls. Added with the\n// integration. The step migration is applied after the plan migration when missing.\ndescribeStack('Plan and task steps together against the real local stack (mobile)', () => {\n  beforeAll(async () => {\n    if (psql(`select to_regprocedure('public.companion_read_steps(uuid)') is not null;`) !== 't') {\n      psql(fs.readFileSync(path.resolve(__dirname, '../../supabase/migrations/20261027183644_companion_task_steps.sql'), 'utf8'));\n      psql(`update public.companion_feature_gate set enabled = true, min_contract_version = 1,\n              max_contract_version = 1, allowed_platforms = '{ios,android,web}';`);\n      execFileSync('docker', ['kill', '--signal=SIGUSR1', REST_CONTAINER], { stdio: 'ignore' });\n    }\n    for (let i = 0; i < 50; i++) {\n      const ready = await http('/rest/v1/rpc/companion_read_steps', {\n        method: 'POST',\n        key: SERVICE_KEY,\n        body: JSON.stringify({ p_user_id: '00000000-0000-0000-0000-000000000000' }),\n      });\n      if (ready.status === 200) break;\n      await new Promise(resolve => setTimeout(resolve, 200));\n    }\n  }, 60_000);\n  beforeEach(() => {\n    global.fetch = realFetch;\n    mockCapture = jest.fn();\n    mockStream.mockReset();\n    clearPlanStores(null);\n    clearTaskActionStores(null);\n  });\n  afterEach(() => {\n    global.fetch = realFetch;\n    clients.splice(0).forEach(client => client.clear());\n  });\n\n  it('a task the approved plan added takes a step; the step never completes the task or the plan; explicit completion updates the plan and keeps the step', async () => {\n    // Wrong if: the plan-added task has no step controls, checking its only step changes\n    // the task state or the plan count, or completion loses the step or the plan count.\n    const acc = await newAccount('plan-steps');\n    mockUserId = acc.id;\n    answersWithPlan();\n    mount();\n    await send('I arrive in Vancouver next week. Help me plan my first week.');\n    const card = await screen.findByTestId('plan-card', {}, { timeout: 10_000 });\n    fireEvent.press(within(card).getByRole('button', { name: `Review plan: ${GOAL}` }));\n    let sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await enabledButton(within(sheet), 'Approve and add 1 task'));\n    await within(sheet).findByText('Added 1 task. Reused 2 tasks you already had.', {}, { timeout: 10_000 });\n    const plans = async () => (await actions(acc.jwt, { action: 'plans' })).json.plans;\n    const phoneRef = (await plans())[0].items[2].task_ref as string;\n    expect(phoneRef).toMatch(/^custom:/);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n\n    // Open the same task from the plan and add and check one step.\n    fireEvent.press(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, 0 of 3 done`) }, { timeout: 10_000 }));\n    sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await within(sheet).findByRole('button', { name: `${PHONE}, Not started` }));\n    sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.changeText(await within(sheet).findByLabelText('New step', {}, { timeout: 10_000 }), 'Compare phone plans');\n    fireEvent.press(await enabledButton(within(sheet), 'Add step'));\n    await within(sheet).findByRole('checkbox', { name: 'Compare phone plans' }, { timeout: 10_000 });\n    await waitFor(() => expect(isEnabled(within(sheet).getByRole('checkbox', { name: 'Compare phone plans' }))).toBe(true), { timeout: 10_000 });\n    fireEvent.press(within(sheet).getByRole('checkbox', { name: 'Compare phone plans' }));\n    await within(sheet).findByText('Checked step: Compare phone plans', {}, { timeout: 10_000 });\n    expect(await within(sheet).findByText('All steps are done. This task stays Not started until you mark it complete.')).toBeTruthy();\n    expect(within(sheet).getByRole('radio', { name: 'Not started' }).props.accessibilityState.checked).toBe(true);\n    let read = (await actions(acc.jwt, { action: 'read' })).json;\n    expect(read.tasks.find((t: { task_ref: string }) => t.task_ref === phoneRef).state).toBe('not_started');\n    expect(read.steps.filter((s: { task_ref: string }) => s.task_ref === phoneRef).map((s: { title: string; done: boolean }) => [s.title, s.done]))\n      .toEqual([['Compare phone plans', true]]);\n    expect((await plans())[0].items.map((i: { state: string }) => i.state)).toEqual(['not_started', 'not_started', 'not_started']);\n\n    // Only the explicit completion completes the task; the plan and step history follow.\n    fireEvent.press(await enabledButton(within(sheet), 'Mark task complete'));\n    expect(await within(sheet).findByText('Completed with 1 of 1 steps done.', {}, { timeout: 10_000 })).toBeTruthy();\n    read = (await actions(acc.jwt, { action: 'read' })).json;\n    expect(read.tasks.find((t: { task_ref: string }) => t.task_ref === phoneRef).state).toBe('completed');\n    expect(read.steps.filter((s: { task_ref: string }) => s.task_ref === phoneRef).map((s: { title: string; done: boolean }) => [s.title, s.done]))\n      .toEqual([['Compare phone plans', true]]);\n    expect((await plans())[0].items.map((i: { state: string }) => i.state)).toEqual(['not_started', 'not_started', 'completed']);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    expect(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}, 1 of 3 done`) }, { timeout: 10_000 })).toBeTruthy();\n  }, 90_000);\n});\n\n// ------------------------------------------------------------------ #367 task removal\n// The same real stack with this repo's #367 migration applied last, in timestamp order:\n// #361, #363, #364, #366, #365 (20261028001530), #367. The actual Companion screen, send\n// hook, removal card, plan entry and task sheet.\ndescribeStack('Task removal against the real local stack (mobile, #367)', () => {\n  let announcementSpy: jest.SpyInstance<void, [announcement: string]>;\n  beforeAll(async () => {\n    const has = (sig: string) => psql(`select to_regprocedure('public.${sig}') is not null;`) === 't';\n    // The earlier blocks applied #361-#366. #365 precedes #367 and is applied here when\n    // missing; refuse an out-of-order stack instead of guessing.\n    if (!has('companion_read_steps(uuid)') || !has('companion_plans_read(uuid)'))\n      throw new Error('#366 and #364 must be applied before #367');\n    const has365 = has('companion_prepare_edit(uuid,jsonb,jsonb,text)');\n    const has370 = has('companion_read_details(uuid)');\n    const has367 = has('companion_remove_prepare(uuid,text,jsonb)');\n    if (has367 && (!has365 || !has370)) throw new Error('#365 and #370 must be applied before #367');\n    if (has370 && !has365) throw new Error('#365 must be applied before #370');\n    if (!has365)\n      psql(fs.readFileSync(path.resolve(__dirname, '../../supabase/migrations/20261028001530_companion_task_edit.sql'), 'utf8'));\n    if (!has370)\n      psql(fs.readFileSync(path.resolve(__dirname, '../../supabase/migrations/20261028004902_companion_saved_details.sql'), 'utf8'));\n    if (!has367) {\n      psql(fs.readFileSync(path.resolve(__dirname, '../../supabase/migrations/20261028025026_companion_task_remove.sql'), 'utf8'));\n      psql(`update public.companion_feature_gate set enabled = true, min_contract_version = 1,\n              max_contract_version = 1, allowed_platforms = '{ios,android,web}';`);\n      execFileSync('docker', ['kill', '--signal=SIGUSR1', REST_CONTAINER], { stdio: 'ignore' });\n    }\n    for (let i = 0; i < 50; i++) {\n      const ready = await http('/rest/v1/rpc/companion_read_tasks', {\n        method: 'POST',\n        key: SERVICE_KEY,\n        body: JSON.stringify({ p_user_id: '00000000-0000-0000-0000-000000000000' }),\n      });\n      if (ready.status === 200) break;\n      await new Promise(resolve => setTimeout(resolve, 200));\n    }\n  }, 60_000);\n  beforeEach(() => {\n    global.fetch = realFetch;\n    mockCapture = jest.fn();\n    mockStream.mockReset();\n    clearPlanStores(null);\n    clearTaskActionStores(null);\n    // The react-native Jest preset already mocks this function, so spyOn returns that mock\n    // with the calls of earlier tests (a completion in the steps block): start from none.\n    announcementSpy = jest.spyOn(AccessibilityInfo, 'announceForAccessibility').mockImplementation(() => {});\n    announcementSpy.mockClear();\n  });\n  afterEach(() => {\n    announcementSpy.mockRestore();\n    global.fetch = realFetch;\n    clients.splice(0).forEach(client => client.clear());\n  });\n\n  const taskNow = async (jwt: string, ref: string) =>\n    (await actions(jwt, { action: 'read' })).json.tasks.find((t: { task_ref: string }) => t.task_ref === ref);\n  const removalReceipts = (userId: string) =>\n    Number(psql(`select count(*) from companion_action_receipts where user_id = '${userId}'\n                  and outcome->'results'->0->>'type' = 'task.remove';`));\n  // This file's Checklist rows stand in for the legacy read: the account has \"Get your SIN\".\n  const sinRow = (userId: string) => ({\n    user_task_id: 1, user_id: userId, task_id: null, sanity_checklist_id: 'sin-number',\n    custom_task_id: null, source: 'sanity', completed: false, completed_at: null, dismissed_at: null,\n    task: { task_name: 'Get your SIN', task_description: '', priority: 'Do now' },\n  });\n  const planItem = async (jwt: string, ref: string) =>\n    (await actions(jwt, { action: 'plans' })).json.plans[0].items.find((i: { task_ref: string }) => i.task_ref === ref);\n\n  it('composition: remember and edit a detail, remove and restore a plan task, retain the draft and exclude another account', async () => {\n    // Added after the merge. Fails on lost detail dispatch, removal, receipts or ownership.\n    const acc = await newAccount('compose-mobile');\n    const stranger = await newAccount('compose-mobile-other');\n    mockUserId = acc.id;\n    await savedPlanFor(acc);\n    mockChecklistRows.splice(0, mockChecklistRows.length, sinRow(acc.id));\n    mount();\n    await send('Remember that I prefer Friday appointments');\n    const detailCard = await screen.findByTestId('detail-command-card', {}, { timeout: 10_000 });\n    expect(within(detailCard).getByText(/I prefer Friday appointments/)).toBeTruthy();\n    fireEvent.press(within(detailCard).getByRole('button', { name: 'View saved details' }));\n    let sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await enabledButton(within(sheet), 'Edit saved detail: I prefer Friday appointments'));\n    fireEvent.changeText(within(sheet).getByLabelText('Saved detail'), 'I prefer Saturday appointments');\n    fireEvent.press(await enabledButton(within(sheet), 'Save change'));\n    await within(sheet).findByText('Changed “I prefer Friday appointments” to “I prefer Saturday appointments”.', {}, { timeout: 10_000 });\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    await send('Remove task: Get your SIN');\n    const removal = await screen.findByTestId('task-removal-card', {}, { timeout: 10_000 });\n    fireEvent.changeText(composer(), 'Keep my next question');\n    fireEvent.press(within(removal).getByRole('button', { name: 'Review removal of Get your SIN' }));\n    sheet = await screen.findByTestId('companion-task-sheet');\n    await within(sheet).findByText('Remove “Get your SIN”?', {}, { timeout: 10_000 });\n    fireEvent.press(await enabledButton(within(sheet), 'Remove task'));\n    await within(sheet).findByText('Removed from your Checklist: Get your SIN', {}, { timeout: 10_000 });\n    expect((await planItem(acc.jwt, 'sanity:sin-number')).removed).toBe(true);\n    fireEvent.press(await enabledButton(within(sheet), 'Undo: Removed from your Checklist: Get your SIN'));\n    await within(sheet).findByText('Restored to your Checklist: Get your SIN', {}, { timeout: 10_000 });\n    expect((await planItem(acc.jwt, 'sanity:sin-number')).removed).toBe(false);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    expect(composer().props.value).toBe('Keep my next question');\n    const own = await actions(acc.jwt, { action: 'read' });\n    expect(own.json.details.map((d: { text: string; revision: number }) => [d.text, d.revision])).toEqual([['I prefer Saturday appointments', 2]]);\n    expect((await actions(stranger.jwt, { action: 'read' })).json.details).toEqual([]);\n    switchAccount(stranger.id);\n    await waitFor(() => expect(screen.queryByTestId('detail-command-card')).toBeNull());\n    expect(mockStream).not.toHaveBeenCalled();\n  }, 90_000);\n\n  it('a removal request in a conversation only opens a review; Cancel writes nothing; the confirmed removal names the plan, reads as removed there, and its Undo restores it; the draft stays', async () => {\n    // Wrong if: the command removes anything or calls the model; the review does not name\n    // the plan; Cancel writes; the confirmed removal is not the legacy dismissal; the plan\n    // does not read it as removed; Undo does not restore it; the typed draft is lost.\n    const acc = await newAccount('remove-command');\n    mockUserId = acc.id;\n    await savedPlanFor(acc);\n    mockChecklistRows.splice(0, mockChecklistRows.length, sinRow(acc.id));\n    mount();\n    await send('Remove task: Get your SIN');\n    const card = await screen.findByTestId('task-removal-card', {}, { timeout: 10_000 });\n    expect(within(card).getByText('Get your SIN')).toBeTruthy();\n    expect(within(card).getByText('Not removed · needs your confirmation')).toBeTruthy();\n    expect(mockStream).not.toHaveBeenCalled();\n    expect((await taskNow(acc.jwt, 'sanity:sin-number'))?.removed ?? false).toBe(false);\n    expect(removalReceipts(acc.id)).toBe(0);\n    fireEvent.changeText(composer(), 'My next question');\n\n    fireEvent.press(within(card).getByRole('button', { name: 'Review removal of Get your SIN' }));\n    let sheet = await screen.findByTestId('companion-task-sheet');\n    expect(await within(sheet).findByText('Remove “Get your SIN”?', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(within(sheet).getByText(`Saved plans that include it: ${GOAL}. It shows there as removed.`)).toBeTruthy();\n    expect(within(sheet).getByText('Current state: Not started')).toBeTruthy();\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Cancel' }));\n    expect(within(sheet).queryByText('Remove “Get your SIN”?')).toBeNull();\n    expect(removalReceipts(acc.id)).toBe(0);\n    expect((await taskNow(acc.jwt, 'sanity:sin-number'))?.removed ?? false).toBe(false);\n    expect(announcementSpy).not.toHaveBeenCalled();\n\n    // Cancel keeps the request open: the card still offers its review, and the draft stays.\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    expect(composer().props.value).toBe('My next question');\n    const again = await screen.findByTestId('task-removal-card');\n    fireEvent.press(within(again).getByRole('button', { name: 'Review removal of Get your SIN' }));\n    sheet = await screen.findByTestId('companion-task-sheet');\n    await within(sheet).findByText('Remove “Get your SIN”?', {}, { timeout: 10_000 });\n    fireEvent.press(await enabledButton(within(sheet), 'Remove task'));\n    expect(await within(sheet).findByText('Removed from your Checklist: Get your SIN', {}, { timeout: 10_000 })).toBeTruthy();\n    await waitFor(() => expect(announcementSpy.mock.calls).toEqual([\n      ['Removed from your Checklist: Get your SIN'],\n    ]));\n    expect(within(sheet).getByText('Saved plans: 1 · Steps kept: 0 · Reminders stopped: 0')).toBeTruthy();\n    expect((await taskNow(acc.jwt, 'sanity:sin-number')).removed).toBe(true);\n    expect(psql(`select dismissed_at is not null from user_tasks where user_id = '${acc.id}' and sanity_checklist_id = 'sin-number';`)).toBe('t');\n    expect((await planItem(acc.jwt, 'sanity:sin-number')).removed).toBe(true);\n    expect(removalReceipts(acc.id)).toBe(1);\n\n    const undo = 'Undo: Removed from your Checklist: Get your SIN';\n    fireEvent.press(await enabledButton(within(sheet), undo));\n    expect(await within(sheet).findByText('Restored to your Checklist: Get your SIN', {}, { timeout: 10_000 })).toBeTruthy();\n    await waitFor(() => expect(announcementSpy.mock.calls).toEqual([\n      ['Removed from your Checklist: Get your SIN'],\n      ['Restored to your Checklist: Get your SIN'],\n    ]));\n    expect((await taskNow(acc.jwt, 'sanity:sin-number')).removed).toBe(false);\n    expect((await planItem(acc.jwt, 'sanity:sin-number')).removed).toBe(false);\n    // Positive control: a state change in the same panel keeps the state announcement.\n    await waitFor(() => expect(within(sheet).getByRole('radio', { name: 'In progress' }).props.accessibilityState?.disabled).toBe(false), {\n      timeout: 10_000,\n    });\n    fireEvent.press(within(sheet).getByRole('radio', { name: 'In progress' }));\n    await waitFor(() => expect(announcementSpy.mock.calls).toEqual([\n      ['Removed from your Checklist: Get your SIN'],\n      ['Restored to your Checklist: Get your SIN'],\n      ['Saved. Task state: In progress.'],\n    ]), { timeout: 10_000 });\n    expect((await taskNow(acc.jwt, 'sanity:sin-number')).state).toBe('in_progress');\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    expect(composer().props.value).toBe('My next question');\n    // The card's review was used: it names its removal, with no review control.\n    const used = await screen.findByTestId('task-removal-card');\n    await waitFor(() => expect(within(used).queryByRole('button', { name: 'Review removal of Get your SIN' })).toBeNull(), {\n      timeout: 10_000,\n    });\n    expect(within(used).getByText('Removed from your Checklist')).toBeTruthy();\n    expect(JSON.stringify(mockCapture.mock.calls)).not.toContain('Get your SIN');\n  }, 90_000);\n\n  it('a change on another device between review and approval opens a revised review and removes nothing; the approved removal keeps steps; an Undo another device already made changes nothing', async () => {\n    // Wrong if: an approval of the old review removes the changed task; the revised review\n    // is not shown; steps are deleted with the task; a stale Undo writes.\n    const acc = await newAccount('remove-panel');\n    mockUserId = acc.id;\n    const saved = await savedPlanFor(acc);\n    const phoneRef = saved.receipt.results[2].task_ref as string;\n    const step = await actions(acc.jwt, {\n      action: 'apply', operation_id: (globalThis.crypto as Crypto).randomUUID(), authorization: { kind: 'ui_control' },\n      operations: [{ type: 'step.create', task_ref: phoneRef, titles: ['Compare phone plans'] }],\n    });\n    expect(step.status).toBe(200);\n    mount();\n    fireEvent.press(await screen.findByRole('button', { name: new RegExp(`Your plan, ${GOAL}`) }, { timeout: 10_000 }));\n    let sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await within(sheet).findByRole('button', { name: `${PHONE}, Not started` }));\n    sheet = await screen.findByTestId('companion-task-sheet');\n    fireEvent.press(await enabledButton(within(sheet), `Remove task: ${PHONE}`));\n    expect(await within(sheet).findByText(`Remove “${PHONE}”?`, {}, { timeout: 10_000 })).toBeTruthy();\n    expect(within(sheet).getByText('Steps kept as history: 1')).toBeTruthy();\n\n    // Another device moves the task on while the review is open.\n    const before = await taskNow(acc.jwt, phoneRef);\n    const moved = await actions(acc.jwt, {\n      action: 'apply', operation_id: (globalThis.crypto as Crypto).randomUUID(), authorization: { kind: 'ui_control' },\n      operations: [{ type: 'task.set_state', task_ref: phoneRef, state: 'in_progress', expected_revision: before.revision }],\n    });\n    expect(moved.status).toBe(200);\n    fireEvent.press(await enabledButton(within(sheet), 'Remove task'));\n    expect(await within(sheet).findByText('This task changed after you opened this review. Check the details and confirm again.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(within(sheet).getByText('Current state: In progress')).toBeTruthy();\n    expect((await taskNow(acc.jwt, phoneRef)).removed).toBe(false);\n    expect(removalReceipts(acc.id)).toBe(0);\n\n    fireEvent.press(await enabledButton(within(sheet), 'Remove task'));\n    expect(await within(sheet).findByText(`Removed from your Checklist: ${PHONE}`, {}, { timeout: 10_000 })).toBeTruthy();\n    expect(within(sheet).getByText('Saved plans: 1 · Steps kept: 1 · Reminders stopped: 0')).toBeTruthy();\n    const read = (await actions(acc.jwt, { action: 'read' })).json;\n    expect(read.tasks.find((t: { task_ref: string }) => t.task_ref === phoneRef).removed).toBe(true);\n    expect(Number(psql(`select count(*) from companion_task_steps where user_id = '${acc.id}' and task_ref = '${phoneRef}';`))).toBe(1);\n\n    // Another device undoes the removal first; this device's Undo of the same receipt\n    // then changes nothing and says so.\n    const receipt = Number(psql(`select count(*) from companion_action_receipts where user_id = '${acc.id}';`));\n    const removal = psql(`select operation_id from companion_action_receipts where user_id = '${acc.id}'\n                           and outcome->'results'->0->>'type' = 'task.remove';`);\n    const web = await actions(acc.jwt, {\n      action: 'undo', operation_id: (globalThis.crypto as Crypto).randomUUID(),\n      receipt_operation_id: removal, authorization: { kind: 'ui_control' },\n    });\n    expect(web.status).toBe(200);\n    fireEvent.press(await enabledButton(within(sheet), `Undo: Removed from your Checklist: ${PHONE}`));\n    expect(await within(sheet).findByText('That change was already undone.', {}, { timeout: 10_000 })).toBeTruthy();\n    expect(Number(psql(`select count(*) from companion_action_receipts where user_id = '${acc.id}';`))).toBe(receipt + 1);\n    expect((await taskNow(acc.jwt, phoneRef)).removed).toBe(false);\n  }, 90_000);\n\n  it('a removal request card turns historical after another device removed the task; its review cannot remove again', async () => {\n    // Wrong if: the old card or its sheet still offers a removal of the removed task, or\n    // the stale review writes a second removal.\n    const acc = await newAccount('remove-stale');\n    mockUserId = acc.id;\n    mockChecklistRows.splice(0, mockChecklistRows.length, sinRow(acc.id));\n    mount();\n    await send('Remove task: Get your SIN');\n    const card = await screen.findByTestId('task-removal-card', {}, { timeout: 10_000 });\n\n    // Another device removes it through its own reviewed removal.\n    const p = await actions(acc.jwt, { action: 'prepare', operation: { type: 'task.remove', task_ref: 'sanity:sin-number', expected_revision: 0 } });\n    const d = p.json.proposal;\n    const w = await actions(acc.jwt, {\n      action: 'apply', operation_id: (globalThis.crypto as Crypto).randomUUID(), operations: d.operations,\n      authorization: { kind: 'approved_proposal', proposal_id: d.proposal_id, proposal_revision: d.proposal_revision, removal_confirmed: true },\n    });\n    expect(w.status).toBe(200);\n\n    // Opening the old request reads current progress: the task is removed, nothing to confirm.\n    // This screen has not read progress since; the stale review opens on current progress.\n    fireEvent.press(within(card).getByRole('button', { name: 'Review removal of Get your SIN' }));\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    expect(await within(sheet).findByText(en.taskActions.removed, {}, { timeout: 10_000 })).toBeTruthy();\n    await waitFor(() => expect(within(sheet).queryByText('Remove “Get your SIN”?')).toBeNull());\n    expect(within(sheet).queryByRole('button', { name: 'Remove task' })).toBeNull();\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    const old = screen.getByTestId('task-removal-card');\n    await waitFor(() => expect(within(old).queryByRole('button', { name: 'Review removal of Get your SIN' })).toBeNull(), {\n      timeout: 10_000,\n    });\n    expect(within(old).getByText(en.taskActions.removed)).toBeTruthy();\n    expect(removalReceipts(acc.id)).toBe(1);\n  }, 60_000);\n\n  it(\"another account sees none of a removal review, card or receipt\", async () => {\n    // Wrong if: the second account's screen shows the first account's card or can read its review.\n    const a = await newAccount('remove-owner');\n    const b = await newAccount('remove-other');\n    mockUserId = a.id;\n    mockChecklistRows.splice(0, mockChecklistRows.length, sinRow(a.id));\n    mount();\n    await send('Remove task: Get your SIN');\n    await screen.findByTestId('task-removal-card', {}, { timeout: 10_000 });\n    switchAccount(b.id);\n    await waitFor(() => expect(screen.queryByTestId('task-removal-card')).toBeNull());\n    const proposal = psql(`select id from companion_proposals where user_id = '${a.id}' and kind = 'task_remove';`);\n    const read = await actions(b.jwt, { action: 'proposal', proposal_id: proposal });\n    expect(read.status).toBe(404);\n  }, 60_000);\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/savargupta/.t3/worktrees/Unify/t3-c68f1368/unify-front-end/__tests__/companionActions/savedDetails.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":38,"column":17,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":38,"endColumn":33},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":54,"column":20,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":54,"endColumn":43},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":69,"column":38,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":69,"endColumn":61},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":83,"column":20,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":83,"endColumn":43},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":95,"column":5,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":95,"endColumn":21},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":96,"column":7,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":96,"endColumn":30},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":100,"column":9,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":100,"endColumn":25},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":101,"column":11,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":101,"endColumn":27},{"ruleId":"import/first","severity":1,"message":"Import in body of module; reorder to top.","line":321,"column":1,"nodeType":"ImportDeclaration","endLine":321,"endColumn":60,"fix":{"range":[0,11019],"text":"// Mounted acceptance for saved personal details (mobile-app#370): the real Companion screen,\n// its conversation cards and the bottom sheet, driven through user controls. The network\n// is the scripted contract stand-in (client behaviour only); the real endpoint and\n// database are covered by companionActionsLocalStack.test.tsx and the web repo's\n// supabase/tests/companion-actions/details_test.ts.\nimport React from 'react';\nimport {\n  act,\n  fireEvent,\n  render,\n  screen,\n  waitFor,\n  within,\n} from '@testing-library/react-native';\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query';\nimport { createTestQueryClient } from '@/testSupport/queryClient';\nimport { createInstance } from 'i18next';\nimport { I18nextProvider, initReactI18next } from 'react-i18next';\nimport { AppState, StyleSheet, TouchableOpacity } from 'react-native';\nimport en from '@/i18n/locales/en/translation.json';\nimport { scriptedServer } from '@/testSupport/companionActionsServer';\nimport { clearTaskActionStores } from '@/services/companionActions/taskActionStore';\n\nimport CompanionScreen from '@/app/(tabs)/companion/index';\n\n// The scripted fetch answers every request; nothing leaves the process.\nprocess.env.EXPO_PUBLIC_SUPABASE_URL = 'http://127.0.0.1:59371';\nprocess.env.EXPO_PUBLIC_SUPABASE_ANON_KEY = 'test-anon-key';\n\nlet mockUserId = 'user-1';\nlet mockCapture: jest.Mock;\nconst mockAuthListeners = new Set<(event: string, session: unknown) => void>();\n\nconst mockPush = jest.fn();\njest.mock('expo-router', () => ({\n  useRouter: () => ({ push: mockPush, replace: jest.fn() }),\n  useLocalSearchParams: () => ({}),\n}));\njest.mock('@react-navigation/native', () => {\n  const React = require('react');\n  return {\n    useFocusEffect: (callback: () => void) => {\n      React.useEffect(() => {\n        const cleanup = callback();\n        return typeof cleanup === 'function' ? cleanup : undefined;\n      }, [callback]);\n    },\n    useIsFocused: () => true,\n  };\n});\n\njest.mock('@react-navigation/bottom-tabs', () => ({\n  useBottomTabBarHeight: () => 0,\n}));\njest.mock('react-native-reanimated', () => {\n  const { View } = require('react-native');\n  const identity = (value: unknown) => value;\n  return {\n    __esModule: true,\n    default: { View },\n    useSharedValue: (value: unknown) => ({ value }),\n    useAnimatedStyle: () => ({}),\n    withTiming: identity,\n    Easing: { out: identity, in: identity, cubic: identity },\n    runOnJS: identity,\n    interpolate: identity,\n    Extrapolate: { CLAMP: 'clamp' },\n  };\n});\njest.mock('react-native-gesture-handler', () => {\n  const { View, TouchableOpacity } = require('react-native');\n  const gesture: any = {\n    onUpdate: () => gesture,\n    onEnd: () => gesture,\n    enabled: () => gesture,\n  };\n  return {\n    Gesture: { Pan: () => gesture },\n    GestureDetector: ({ children }: { children: React.ReactNode }) => children,\n    GestureHandlerRootView: View,\n    TouchableOpacity,\n  };\n});\njest.mock('react-native-keyboard-controller', () => {\n  const { View } = require('react-native');\n  return {\n    KeyboardAvoidingView: View,\n    useReanimatedKeyboardAnimation: () => ({\n      height: { value: 0 },\n      progress: { value: 0 },\n    }),\n  };\n});\njest.mock('react-native-draggable-flatlist', () => ({\n  __esModule: true,\n  default: ({ data, renderItem, ListHeaderComponent, ListFooterComponent }: any) =>\n    require('react').createElement(\n      require('react-native').View,\n      null,\n      ListHeaderComponent,\n      data.map((item: any, index: number) =>\n        require('react').createElement(\n          require('react').Fragment,\n          { key: item.key },\n          renderItem({ item, drag: () => {}, isActive: false, getIndex: () => index })\n        )\n      ),\n      ListFooterComponent\n    ),\n  ScaleDecorator: ({ children }: any) => children,\n}));\njest.mock('react-native-confetti-cannon', () => () => null);\njest.mock('expo-haptics', () => ({\n  impactAsync: jest.fn(),\n  ImpactFeedbackStyle: { Medium: 'medium' },\n}));\njest.mock('@expo/vector-icons/MaterialIcons', () => () => null);\njest.mock('expo-constants', () => ({\n  __esModule: true,\n  default: { expoConfig: { version: '9.9.9', extra: {} } },\n}));\n// One client object, as the real provider gives: a new object per render would\n// change every analytics callback and re-run the screen's focus effect forever.\nconst mockPostHog = {\n  capture: (...args: unknown[]) => mockCapture(...args),\n  screen: () => {},\n};\njest.mock('posthog-react-native', () => ({\n  usePostHog: () => mockPostHog,\n}));\njest.mock('@/context/HapticsContext', () => ({\n  useHapticsPreference: () => ({ hapticsEnabled: false }),\n}));\n// Stable functions, as the real hook returns: a new function on every render\n// would re-run the screen's effects without end.\nconst mockRefreshStage = jest.fn().mockResolvedValue(undefined);\nconst mockApplyConfirmedArrival = jest.fn();\njest.mock('@/hooks/onboarding/useUserStage', () => ({\n  useUserStage: () => ({\n    currentStage: 1,\n    stageChanged: false,\n    arrivalDate: null,\n    userId: mockUserId,\n    refreshStage: mockRefreshStage,\n    applyConfirmedArrival: mockApplyConfirmedArrival,\n    isLoading: false,\n  }),\n}));\njest.mock('@/hooks/checklist/useRefreshingToday', () => ({\n  useRefreshingToday: () => new Date(2026, 9, 23, 12, 0, 0),\n}));\nconst mockRefreshUser = jest.fn();\njest.mock('@/context/UserContext', () => ({\n  useCurrentUser: () => ({\n    currentUser: { id: mockUserId, isPremium: false },\n    refreshUser: mockRefreshUser,\n  }),\n}));\n// The actual send, conversation and message hooks run. Their services and the model\n// stream are scripted.\nlet mockMessageCount = 0;\ntype SavedRow = {\n  id: number;\n  role: 'user' | 'assistant';\n  content: string;\n  conversation: string;\n  account: string;\n};\nconst mockSaved: SavedRow[] = [];\nlet mockNextMessageId = 100;\nconst mockStream = jest.fn();\nlet mockServerRef: ReturnType<typeof scriptedServer> | null = null;\nconst mockServer = () => mockServerRef!;\njest.mock('@/services/companion/createConversation', () => ({\n  createConversation: jest.fn(async () => ({\n    conversation_identifier: 'conv-1',\n    id: 1,\n  })),\n}));\njest.mock('@/services/companion/saveMessage', () => ({\n  saveMessage: jest.fn(\n    async (p: { conversationIdentifier: string; role: 'user' | 'assistant'; content: string }) => {\n      const row = {\n        id: mockNextMessageId++,\n        role: p.role,\n        content: p.content,\n        conversation: p.conversationIdentifier,\n        account: mockUserId,\n      };\n      mockSaved.push(row);\n      mockServer().saveMessage(row.id, row.role, row.content, row.conversation);\n      return { id: row.id };\n    }\n  ),\n}));\njest.mock('@/services/companion/getConversationMessages', () => ({\n  getConversationMessages: jest.fn(async (conversation: string) =>\n    mockSaved\n      .filter(m => m.conversation === conversation && m.account === mockUserId)\n      .map(m => ({\n        id: m.id,\n        role: m.role,\n        content: m.content,\n        sources: null,\n        created_at: new Date(Date.UTC(2026, 9, 26, 10, 0, m.id - 100)).toISOString(),\n      }))\n  ),\n}));\njest.mock('@/services/companion/getConversations', () => ({\n  getConversations: jest.fn(async () => []),\n}));\njest.mock('@/hooks/companion/useChatbotUsage', () => ({\n  useChatbotUsage: () => ({ data: { message_count: mockMessageCount } }),\n}));\njest.mock('@/hooks/companion/useCompanionReviewPrompt', () => ({\n  useCompanionReviewPrompt: () => {},\n}));\njest.mock('@/hooks/companion/usePersonalizedStarters', () => ({\n  usePersonalizedStarters: () => ({ data: undefined }),\n}));\njest.mock('@/utils/gemini', () => ({\n  AICompanionBusyError: class extends Error {},\n  AICompanionLimitError: class extends Error {},\n  streamGeminiAPI: (...a: unknown[]) => mockStream(...a),\n}));\n// Its looping animation would outlive this file.\njest.mock('@/components/companion/TypingIndicator', () => ({\n  TypingIndicator: () => null,\n}));\njest.mock('@/context/ToastContext', () => ({\n  useToast: () => ({ showToast: jest.fn() }),\n}));\njest.mock('@/components/companion/AnimatedDottedBackground', () => ({\n  AnimatedDottedBackground: () => null,\n}));\njest.mock('@/components/companion/StarterPrompts', () => ({\n  StarterPrompts: () => null,\n}));\njest.mock('@/components/companion/PartnerSpotlightBanner', () => () => null);\njest.mock('@/components/icons/SendIcon.svg', () => () => null);\njest.mock('lucide-react-native', () => ({ History: () => null, Plus: () => null }));\njest.mock('@/components/common/BottomSheet', () => ({\n  __esModule: true,\n  default: () => null,\n}));\njest.mock('react-native-safe-area-context', () => ({\n  useSafeAreaInsets: () => ({ top: 0, bottom: 0, left: 0, right: 0 }),\n}));\njest.mock('@/hooks/sanity/useSanityLanguage', () => ({\n  useSanityLanguage: () => 'en',\n}));\njest.mock('@/lib/supabase', () => ({\n  supabase: {\n    auth: {\n      getUser: async () => ({ data: { user: { id: mockUserId } } }),\n      getSession: async () => ({\n        data: {\n          session: { user: { id: mockUserId }, access_token: `jwt-${mockUserId}` },\n        },\n      }),\n      onAuthStateChange: (listener: (event: string, session: unknown) => void) => {\n        mockAuthListeners.add(listener);\n        return {\n          data: { subscription: { unsubscribe: () => mockAuthListeners.delete(listener) } },\n        };\n      },\n    },\n  },\n}));\njest.mock('@/services/onboarding/getOnboardingProfile', () => ({\n  getOnboardingProfile: jest.fn(async () => ({\n    persona: 'international_student',\n    province: 'British Columbia',\n  })),\n}));\njest.mock('@/sanity-custom', () => ({\n  sanityClient: {\n    fetch: jest.fn(async () => [\n      {\n        _id: 'sin',\n        _type: 'checklist',\n        title: 'Get a SIN',\n        class: 'do_now',\n        class_order: 1,\n      },\n    ]),\n  },\n}));\njest.mock('@/services/checklist/getUserTasks', () => ({\n  getUserTasks: jest.fn().mockResolvedValue([]),\n}));\njest.mock('@/services/checklist/customChecklistTasks', () => ({\n  getCustomChecklistTasks: jest.fn(async () =>\n    mockServer().customTasks().map((t: { id: string; title: string }) => ({\n      id: Number(t.id),\n      user_id: mockUserId,\n      priority: 'Do soon',\n      title: t.title,\n      description: '',\n      completed: false,\n      completed_at: null,\n      created_at: '2026-10-26T10:00:00Z',\n      updated_at: '2026-10-26T10:00:00Z',\n    }))\n  ),\n  deleteCustomChecklistTask: jest.fn(),\n  setCustomChecklistTaskCompletion: jest.fn(),\n}));\njest.mock('@/services/checklist/checklistTaskOrder', () => ({\n  getChecklistTaskOrders: jest.fn().mockResolvedValue([]),\n  upsertChecklistTaskOrder: jest.fn(),\n}));\njest.mock('@/services/checklist/setChecklistItemCompletion', () => ({\n  setChecklistItemCompletion: jest.fn(),\n}));\njest.mock('@/services/checklist/setChecklistItemDismissed', () => ({\n  setChecklistItemDismissed: jest.fn(),\n}));\njest.mock('@/components/home/HomeHeader', () => () => null);\njest.mock('@/components/LoadingScreen', () => () => null);\njest.mock('@/components/partners/SpotlightRow', () => () => null);"}}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":1,"source":"// Mounted acceptance for saved personal details (mobile-app#370): the real Companion screen,\n// its conversation cards and the bottom sheet, driven through user controls. The network\n// is the scripted contract stand-in (client behaviour only); the real endpoint and\n// database are covered by companionActionsLocalStack.test.tsx and the web repo's\n// supabase/tests/companion-actions/details_test.ts.\nimport React from 'react';\nimport {\n  act,\n  fireEvent,\n  render,\n  screen,\n  waitFor,\n  within,\n} from '@testing-library/react-native';\nimport { QueryClient, QueryClientProvider } from '@tanstack/react-query';\nimport { createTestQueryClient } from '@/testSupport/queryClient';\nimport { createInstance } from 'i18next';\nimport { I18nextProvider, initReactI18next } from 'react-i18next';\nimport { AppState, StyleSheet, TouchableOpacity } from 'react-native';\nimport en from '@/i18n/locales/en/translation.json';\nimport { scriptedServer } from '@/testSupport/companionActionsServer';\nimport { clearTaskActionStores } from '@/services/companionActions/taskActionStore';\n\n// The scripted fetch answers every request; nothing leaves the process.\nprocess.env.EXPO_PUBLIC_SUPABASE_URL = 'http://127.0.0.1:59371';\nprocess.env.EXPO_PUBLIC_SUPABASE_ANON_KEY = 'test-anon-key';\n\nlet mockUserId = 'user-1';\nlet mockCapture: jest.Mock;\nconst mockAuthListeners = new Set<(event: string, session: unknown) => void>();\n\nconst mockPush = jest.fn();\njest.mock('expo-router', () => ({\n  useRouter: () => ({ push: mockPush, replace: jest.fn() }),\n  useLocalSearchParams: () => ({}),\n}));\njest.mock('@react-navigation/native', () => {\n  const React = require('react');\n  return {\n    useFocusEffect: (callback: () => void) => {\n      React.useEffect(() => {\n        const cleanup = callback();\n        return typeof cleanup === 'function' ? cleanup : undefined;\n      }, [callback]);\n    },\n    useIsFocused: () => true,\n  };\n});\n\njest.mock('@react-navigation/bottom-tabs', () => ({\n  useBottomTabBarHeight: () => 0,\n}));\njest.mock('react-native-reanimated', () => {\n  const { View } = require('react-native');\n  const identity = (value: unknown) => value;\n  return {\n    __esModule: true,\n    default: { View },\n    useSharedValue: (value: unknown) => ({ value }),\n    useAnimatedStyle: () => ({}),\n    withTiming: identity,\n    Easing: { out: identity, in: identity, cubic: identity },\n    runOnJS: identity,\n    interpolate: identity,\n    Extrapolate: { CLAMP: 'clamp' },\n  };\n});\njest.mock('react-native-gesture-handler', () => {\n  const { View, TouchableOpacity } = require('react-native');\n  const gesture: any = {\n    onUpdate: () => gesture,\n    onEnd: () => gesture,\n    enabled: () => gesture,\n  };\n  return {\n    Gesture: { Pan: () => gesture },\n    GestureDetector: ({ children }: { children: React.ReactNode }) => children,\n    GestureHandlerRootView: View,\n    TouchableOpacity,\n  };\n});\njest.mock('react-native-keyboard-controller', () => {\n  const { View } = require('react-native');\n  return {\n    KeyboardAvoidingView: View,\n    useReanimatedKeyboardAnimation: () => ({\n      height: { value: 0 },\n      progress: { value: 0 },\n    }),\n  };\n});\njest.mock('react-native-draggable-flatlist', () => ({\n  __esModule: true,\n  default: ({ data, renderItem, ListHeaderComponent, ListFooterComponent }: any) =>\n    require('react').createElement(\n      require('react-native').View,\n      null,\n      ListHeaderComponent,\n      data.map((item: any, index: number) =>\n        require('react').createElement(\n          require('react').Fragment,\n          { key: item.key },\n          renderItem({ item, drag: () => {}, isActive: false, getIndex: () => index })\n        )\n      ),\n      ListFooterComponent\n    ),\n  ScaleDecorator: ({ children }: any) => children,\n}));\njest.mock('react-native-confetti-cannon', () => () => null);\njest.mock('expo-haptics', () => ({\n  impactAsync: jest.fn(),\n  ImpactFeedbackStyle: { Medium: 'medium' },\n}));\njest.mock('@expo/vector-icons/MaterialIcons', () => () => null);\njest.mock('expo-constants', () => ({\n  __esModule: true,\n  default: { expoConfig: { version: '9.9.9', extra: {} } },\n}));\n// One client object, as the real provider gives: a new object per render would\n// change every analytics callback and re-run the screen's focus effect forever.\nconst mockPostHog = {\n  capture: (...args: unknown[]) => mockCapture(...args),\n  screen: () => {},\n};\njest.mock('posthog-react-native', () => ({\n  usePostHog: () => mockPostHog,\n}));\njest.mock('@/context/HapticsContext', () => ({\n  useHapticsPreference: () => ({ hapticsEnabled: false }),\n}));\n// Stable functions, as the real hook returns: a new function on every render\n// would re-run the screen's effects without end.\nconst mockRefreshStage = jest.fn().mockResolvedValue(undefined);\nconst mockApplyConfirmedArrival = jest.fn();\njest.mock('@/hooks/onboarding/useUserStage', () => ({\n  useUserStage: () => ({\n    currentStage: 1,\n    stageChanged: false,\n    arrivalDate: null,\n    userId: mockUserId,\n    refreshStage: mockRefreshStage,\n    applyConfirmedArrival: mockApplyConfirmedArrival,\n    isLoading: false,\n  }),\n}));\njest.mock('@/hooks/checklist/useRefreshingToday', () => ({\n  useRefreshingToday: () => new Date(2026, 9, 23, 12, 0, 0),\n}));\nconst mockRefreshUser = jest.fn();\njest.mock('@/context/UserContext', () => ({\n  useCurrentUser: () => ({\n    currentUser: { id: mockUserId, isPremium: false },\n    refreshUser: mockRefreshUser,\n  }),\n}));\n// The actual send, conversation and message hooks run. Their services and the model\n// stream are scripted.\nlet mockMessageCount = 0;\ntype SavedRow = {\n  id: number;\n  role: 'user' | 'assistant';\n  content: string;\n  conversation: string;\n  account: string;\n};\nconst mockSaved: SavedRow[] = [];\nlet mockNextMessageId = 100;\nconst mockStream = jest.fn();\nlet mockServerRef: ReturnType<typeof scriptedServer> | null = null;\nconst mockServer = () => mockServerRef!;\njest.mock('@/services/companion/createConversation', () => ({\n  createConversation: jest.fn(async () => ({\n    conversation_identifier: 'conv-1',\n    id: 1,\n  })),\n}));\njest.mock('@/services/companion/saveMessage', () => ({\n  saveMessage: jest.fn(\n    async (p: { conversationIdentifier: string; role: 'user' | 'assistant'; content: string }) => {\n      const row = {\n        id: mockNextMessageId++,\n        role: p.role,\n        content: p.content,\n        conversation: p.conversationIdentifier,\n        account: mockUserId,\n      };\n      mockSaved.push(row);\n      mockServer().saveMessage(row.id, row.role, row.content, row.conversation);\n      return { id: row.id };\n    }\n  ),\n}));\njest.mock('@/services/companion/getConversationMessages', () => ({\n  getConversationMessages: jest.fn(async (conversation: string) =>\n    mockSaved\n      .filter(m => m.conversation === conversation && m.account === mockUserId)\n      .map(m => ({\n        id: m.id,\n        role: m.role,\n        content: m.content,\n        sources: null,\n        created_at: new Date(Date.UTC(2026, 9, 26, 10, 0, m.id - 100)).toISOString(),\n      }))\n  ),\n}));\njest.mock('@/services/companion/getConversations', () => ({\n  getConversations: jest.fn(async () => []),\n}));\njest.mock('@/hooks/companion/useChatbotUsage', () => ({\n  useChatbotUsage: () => ({ data: { message_count: mockMessageCount } }),\n}));\njest.mock('@/hooks/companion/useCompanionReviewPrompt', () => ({\n  useCompanionReviewPrompt: () => {},\n}));\njest.mock('@/hooks/companion/usePersonalizedStarters', () => ({\n  usePersonalizedStarters: () => ({ data: undefined }),\n}));\njest.mock('@/utils/gemini', () => ({\n  AICompanionBusyError: class extends Error {},\n  AICompanionLimitError: class extends Error {},\n  streamGeminiAPI: (...a: unknown[]) => mockStream(...a),\n}));\n// Its looping animation would outlive this file.\njest.mock('@/components/companion/TypingIndicator', () => ({\n  TypingIndicator: () => null,\n}));\njest.mock('@/context/ToastContext', () => ({\n  useToast: () => ({ showToast: jest.fn() }),\n}));\njest.mock('@/components/companion/AnimatedDottedBackground', () => ({\n  AnimatedDottedBackground: () => null,\n}));\njest.mock('@/components/companion/StarterPrompts', () => ({\n  StarterPrompts: () => null,\n}));\njest.mock('@/components/companion/PartnerSpotlightBanner', () => () => null);\njest.mock('@/components/icons/SendIcon.svg', () => () => null);\njest.mock('lucide-react-native', () => ({ History: () => null, Plus: () => null }));\njest.mock('@/components/common/BottomSheet', () => ({\n  __esModule: true,\n  default: () => null,\n}));\njest.mock('react-native-safe-area-context', () => ({\n  useSafeAreaInsets: () => ({ top: 0, bottom: 0, left: 0, right: 0 }),\n}));\njest.mock('@/hooks/sanity/useSanityLanguage', () => ({\n  useSanityLanguage: () => 'en',\n}));\njest.mock('@/lib/supabase', () => ({\n  supabase: {\n    auth: {\n      getUser: async () => ({ data: { user: { id: mockUserId } } }),\n      getSession: async () => ({\n        data: {\n          session: { user: { id: mockUserId }, access_token: `jwt-${mockUserId}` },\n        },\n      }),\n      onAuthStateChange: (listener: (event: string, session: unknown) => void) => {\n        mockAuthListeners.add(listener);\n        return {\n          data: { subscription: { unsubscribe: () => mockAuthListeners.delete(listener) } },\n        };\n      },\n    },\n  },\n}));\njest.mock('@/services/onboarding/getOnboardingProfile', () => ({\n  getOnboardingProfile: jest.fn(async () => ({\n    persona: 'international_student',\n    province: 'British Columbia',\n  })),\n}));\njest.mock('@/sanity-custom', () => ({\n  sanityClient: {\n    fetch: jest.fn(async () => [\n      {\n        _id: 'sin',\n        _type: 'checklist',\n        title: 'Get a SIN',\n        class: 'do_now',\n        class_order: 1,\n      },\n    ]),\n  },\n}));\njest.mock('@/services/checklist/getUserTasks', () => ({\n  getUserTasks: jest.fn().mockResolvedValue([]),\n}));\njest.mock('@/services/checklist/customChecklistTasks', () => ({\n  getCustomChecklistTasks: jest.fn(async () =>\n    mockServer().customTasks().map((t: { id: string; title: string }) => ({\n      id: Number(t.id),\n      user_id: mockUserId,\n      priority: 'Do soon',\n      title: t.title,\n      description: '',\n      completed: false,\n      completed_at: null,\n      created_at: '2026-10-26T10:00:00Z',\n      updated_at: '2026-10-26T10:00:00Z',\n    }))\n  ),\n  deleteCustomChecklistTask: jest.fn(),\n  setCustomChecklistTaskCompletion: jest.fn(),\n}));\njest.mock('@/services/checklist/checklistTaskOrder', () => ({\n  getChecklistTaskOrders: jest.fn().mockResolvedValue([]),\n  upsertChecklistTaskOrder: jest.fn(),\n}));\njest.mock('@/services/checklist/setChecklistItemCompletion', () => ({\n  setChecklistItemCompletion: jest.fn(),\n}));\njest.mock('@/services/checklist/setChecklistItemDismissed', () => ({\n  setChecklistItemDismissed: jest.fn(),\n}));\njest.mock('@/components/home/HomeHeader', () => () => null);\njest.mock('@/components/LoadingScreen', () => () => null);\njest.mock('@/components/partners/SpotlightRow', () => () => null);\n\nimport CompanionScreen from '@/app/(tabs)/companion/index';\n\nfunction testI18n() {\n  const i18n = createInstance();\n  void i18n.use(initReactI18next).init({\n    lng: 'en',\n    resources: { en: { translation: en } },\n    interpolation: { escapeValue: false },\n    initImmediate: false,\n  });\n  return i18n;\n}\n\nconst clients: QueryClient[] = [];\nfunction renderScreen() {\n  // gcTime Infinity: no garbage-collection timer outlives the test.\n  const client = createTestQueryClient({\n    defaultOptions: { queries: { retry: false, gcTime: Infinity } },\n  });\n  clients.push(client);\n  return render(\n    <QueryClientProvider client={client}>\n      <I18nextProvider i18n={testI18n()}>\n        <CompanionScreen />\n      </I18nextProvider>\n    </QueryClientProvider>\n  );\n}\n\nlet server: ReturnType<typeof scriptedServer>;\nconst realFetch = global.fetch;\nlet userCounter = 0;\nfunction useServer(s: ReturnType<typeof scriptedServer>) {\n  server = s;\n  mockServerRef = s;\n  global.fetch = s.fetch as unknown as typeof fetch;\n}\n\nconst composer = () => screen.getByPlaceholderText('Ask anything...');\nconst sendButton = () => {\n  const button = screen\n    .UNSAFE_getAllByType(TouchableOpacity)\n    .find(b => StyleSheet.flatten(b.props.style)?.borderRadius === 20);\n  if (!button) throw new Error('send control missing');\n  return button;\n};\nasync function send(text: string) {\n  fireEvent.changeText(await screen.findByPlaceholderText(/Ask anything|limit/i), text);\n  fireEvent.press(sendButton());\n}\nconst enabled = (el: { props: { accessibilityState?: { disabled?: boolean } } }) =>\n  el.props.accessibilityState?.disabled !== true;\nbeforeEach(() => {\n  mockUserId = `detail-user-${++userCounter}`;\n  mockCapture = jest.fn();\n  mockPush.mockReset();\n  mockMessageCount = 0;\n  mockSaved.length = 0;\n  mockNextMessageId = 100;\n  mockStream.mockReset();\n  clearTaskActionStores(null);\n  useServer(scriptedServer());\n});\nafterEach(() => {\n  global.fetch = realFetch;\n  clients.splice(0).forEach(client => client.clear());\n});\n\n\n\nconst FRIDAYS = 'I can attend appointments on Fridays';\n/** The model answers; `detail` is the one detail it suggests saving, or none. */\nfunction answersDetail(text: string, detail: string | null) {\n  mockStream.mockImplementation(\n    async (_q: string, _c: string, _h: unknown, cb: { onMetadata: (m: unknown) => void; onComplete: (c: unknown) => void }) => {\n      cb.onMetadata({ sources: [], queryType: 'newcomer_settlement' });\n      cb.onComplete({\n        cleanAnswer: text,\n        ...(detail ? { actionProposal: { type: 'detail.create', version: 1, text: detail } } : {}),\n      });\n    }\n  );\n}\nconst detailWrites = () =>\n  server.sent.filter(\n    b =>\n      (b.action === 'apply' && String(b.operations?.[0]?.type).startsWith('detail.')) ||\n      (b.action === 'undo')\n  );\nasync function switchAccount(nextUserId: string) {\n  mockUserId = nextUserId;\n  await act(async () => {\n    for (const listener of [...mockAuthListeners])\n      listener('SIGNED_IN', { user: { id: nextUserId }, access_token: `jwt-${nextUserId}` });\n  });\n}\n/** Saves a detail through a clear remember command and opens the saved details. */\nasync function rememberAndOpen(text = FRIDAYS) {\n  await send(`Remember that ${text}`);\n  const card = await screen.findByTestId('detail-command-card');\n  await within(card).findByText(`Saved: “${text}”.`);\n  fireEvent.press(within(card).getByRole('button', { name: 'View saved details' }));\n  const sheet = await screen.findByTestId('companion-task-sheet');\n  expect(within(sheet).getByRole('header', { name: 'Saved details' })).toBeTruthy();\n  await within(sheet).findByText(text);\n  return { card, sheet };\n}\n\ndescribe('Saved personal details through Companion (mobile, #370)', () => {\n  it('a clear remember message saves exactly that detail once, with no AI answer, and its receipt names it', async () => {\n    // Wrong if: the model is asked, the saved text differs from the message, the command\n    // writes twice, analytics carries the detail, or the typed message is lost.\n    renderScreen();\n    await send(`Remember that ${FRIDAYS}.`);\n    const card = await screen.findByTestId('detail-command-card');\n    expect(await within(card).findByText(`Saved: “${FRIDAYS}”.`)).toBeTruthy();\n    expect(mockStream).not.toHaveBeenCalled();\n    const writes = detailWrites();\n    expect(writes).toHaveLength(1);\n    expect(writes[0].operations).toEqual([{ type: 'detail.create', text: FRIDAYS }]);\n    expect(writes[0].authorization).toEqual({ kind: 'direct_command', message_id: mockSaved[0].id });\n    expect(server.details().map(d => d.text)).toEqual([FRIDAYS]);\n    for (const call of mockCapture.mock.calls) expect(JSON.stringify(call)).not.toMatch(/Fridays/);\n    const result = mockCapture.mock.calls.find(c => c[0] === 'companion_action_result');\n    expect(result?.[1]).toMatchObject({ action: 'command_detail', operation_type: 'detail.create', outcome: 'applied' });\n  });\n\n  it('an inferred detail is only a draft: Not now saves nothing, and approval saves it once', async () => {\n    // Wrong if: a suggestion is saved before approval, Not now writes, or a double tap saves twice.\n    answersDetail('Fridays work for many offices.', FRIDAYS);\n    renderScreen();\n    await send('I can only go on Fridays. Where do I get a SIN?');\n    const card = await screen.findByTestId('detail-draft-card');\n    expect(within(card).getByText('Needs your approval. Not saved.')).toBeTruthy();\n    expect(server.details()).toEqual([]);\n\n    fireEvent.press(within(card).getByRole('button', { name: `Review the suggested detail: ${FRIDAYS}` }));\n    let sheet = await screen.findByTestId('companion-task-sheet');\n    expect(within(sheet).getByRole('header', { name: 'Remember this detail?' })).toBeTruthy();\n    fireEvent.press(await within(sheet).findByRole('button', { name: 'Not now' }));\n    expect(await within(sheet).findByText('Not saved.')).toBeTruthy();\n    expect(detailWrites()).toHaveLength(0);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n\n    answersDetail('Noted.', FRIDAYS);\n    await send('Fridays are best for me.');\n    await waitFor(() => expect(screen.getAllByTestId('detail-draft-card')).toHaveLength(2));\n    fireEvent.changeText(composer(), 'My next question');\n    fireEvent.press(\n      within(screen.getAllByTestId('detail-draft-card')[1]).getByRole('button', {\n        name: `Review the suggested detail: ${FRIDAYS}`,\n      })\n    );\n    sheet = await screen.findByTestId('companion-task-sheet');\n    const approve = await within(sheet).findByRole('button', { name: 'Remember this' });\n    await waitFor(() => expect(enabled(approve)).toBe(true));\n    fireEvent.press(approve);\n    fireEvent.press(approve);\n    expect(await within(sheet).findByText(`Saved: “${FRIDAYS}”.`)).toBeTruthy();\n    expect(detailWrites()).toHaveLength(1);\n    expect(detailWrites()[0].authorization).toMatchObject({ kind: 'approved_proposal', proposal_revision: 1 });\n    expect(server.details().map(d => d.text)).toEqual([FRIDAYS]);\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    expect(composer().props.value).toBe('My next question');\n  });\n\n  it('edits at the revision shown and keeps typed text through close and reopen; its receipt names before and after', async () => {\n    // Wrong if: the typed edit is lost when the sheet closes, the edit names another\n    // revision, or the receipt does not name the exact change.\n    renderScreen();\n    let { sheet } = await rememberAndOpen();\n    fireEvent.press(within(sheet).getByRole('button', { name: `Edit saved detail: ${FRIDAYS}` }));\n    fireEvent.changeText(within(sheet).getByLabelText('Saved detail'), 'I can attend appointments on Saturdays');\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await waitFor(() => expect(screen.queryByTestId('companion-task-sheet')).toBeNull());\n    fireEvent.press(within(screen.getByTestId('detail-command-card')).getByRole('button', { name: 'View saved details' }));\n    sheet = await screen.findByTestId('companion-task-sheet');\n    expect(within(sheet).getByLabelText('Saved detail').props.value).toBe('I can attend appointments on Saturdays');\n    const save = within(sheet).getByRole('button', { name: 'Save change' });\n    await waitFor(() => expect(enabled(save)).toBe(true));\n    fireEvent.press(save);\n    expect(\n      await within(sheet).findByText(`Changed “${FRIDAYS}” to “I can attend appointments on Saturdays”.`)\n    ).toBeTruthy();\n    const edit = detailWrites().find(w => w.operations?.[0]?.type === 'detail.update')!;\n    expect(edit.operations[0]).toEqual({\n      type: 'detail.update',\n      detail_id: server.details()[0].detail_id,\n      text: 'I can attend appointments on Saturdays',\n      expected_revision: 1,\n    });\n    expect(edit.authorization).toEqual({ kind: 'ui_control' });\n    // The command's receipt keeps its own text and is now history.\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    const card = screen.getByTestId('detail-command-card');\n    await within(card).findByText('Saved earlier. This detail has changed since.');\n    expect(within(card).getByText(`Saved: “${FRIDAYS}”.`)).toBeTruthy();\n  });\n\n  it('every removal asks first; Cancel sends nothing; Remove names the detail and Undo restores it', async () => {\n    // Wrong if: a removal is sent without confirmation, Cancel writes, or Undo is not\n    // tied to the removal receipt.\n    renderScreen();\n    const { sheet } = await rememberAndOpen();\n    const before = detailWrites().length;\n    fireEvent.press(within(sheet).getByRole('button', { name: `Remove saved detail: ${FRIDAYS}` }));\n    expect(within(sheet).getByText('Remove this saved detail?')).toBeTruthy();\n    expect(within(sheet).getByText(`“${FRIDAYS}” will no longer be used in later conversations.`)).toBeTruthy();\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Cancel' }));\n    expect(detailWrites()).toHaveLength(before);\n    fireEvent.press(within(sheet).getByRole('button', { name: `Remove saved detail: ${FRIDAYS}` }));\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Remove detail' }));\n    expect(\n      await within(sheet).findByText(`Removed “${FRIDAYS}”. It will not be used in later conversations.`)\n    ).toBeTruthy();\n    const removal = detailWrites()[detailWrites().length - 1];\n    expect(removal.authorization).toEqual({ kind: 'ui_control', removal_confirmed: true });\n    expect(server.details()[0].removed).toBe(true);\n    await waitFor(() => expect(within(sheet).queryAllByTestId('saved-detail-row')).toHaveLength(0));\n\n    fireEvent.press(within(sheet).getByRole('button', { name: `Undo removing “${FRIDAYS}”` }));\n    expect(await within(sheet).findByText(`Restored “${FRIDAYS}”.`)).toBeTruthy();\n    const undo = detailWrites()[detailWrites().length - 1];\n    expect([undo.action, undo.receipt_operation_id]).toEqual(['undo', removal.operation_id]);\n    expect(server.details()[0].removed).toBe(false);\n  });\n\n  it('the Undo of a save removes it only after confirmation; an Undo after a newer edit offers a reviewed change', async () => {\n    // Wrong if: Undo of a save is sent without confirmation, or an old receipt's Undo\n    // overwrites a newer edit made on another device.\n    renderScreen();\n    await send(`Remember that ${FRIDAYS}`);\n    const card = await screen.findByTestId('detail-command-card');\n    await within(card).findByText(`Saved: “${FRIDAYS}”.`);\n    const before = detailWrites().length;\n    fireEvent.press(within(card).getByRole('button', { name: `Undo saving “${FRIDAYS}”` }));\n    expect(detailWrites()).toHaveLength(before);\n    expect(within(card).getByText(`Undoing this removes “${FRIDAYS}”. It will no longer be used in later conversations.`)).toBeTruthy();\n    fireEvent.press(within(card).getByRole('button', { name: 'Cancel' }));\n    expect(detailWrites()).toHaveLength(before);\n\n    // Another device edits the detail, and this device reads it.\n    server.editDetailElsewhere(server.details()[0].detail_id, 'I can attend appointments on Mondays');\n    fireEvent.press(within(card).getByRole('button', { name: 'View saved details' }));\n    const sheet = await screen.findByTestId('companion-task-sheet');\n    await within(sheet).findByText('I can attend appointments on Mondays');\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Close' }));\n    await within(card).findByText('Saved earlier. This detail has changed since.');\n    expect(within(card).queryByRole('button', { name: `Undo saving “${FRIDAYS}”` })).toBeNull();\n    expect(server.details()[0].text).toBe('I can attend appointments on Mondays');\n  });\n\n  it('a lost reply is looked up and shown from its receipt; the edit is never sent again', async () => {\n    // Wrong if: an unknown outcome is retried blind or shown as saved before the lookup.\n    renderScreen();\n    const { sheet } = await rememberAndOpen();\n    useServer(scriptedServerWithDrop());\n    fireEvent.press(within(sheet).getByRole('button', { name: `Edit saved detail: ${FRIDAYS}` }));\n    fireEvent.changeText(within(sheet).getByLabelText('Saved detail'), 'I prefer mornings');\n    fireEvent.press(within(sheet).getByRole('button', { name: 'Save change' }));\n    expect(await within(sheet).findByText(`Changed “${FRIDAYS}” to “I prefer mornings”.`)).toBeTruthy();\n    const updates = server.sent.filter(b => b.action === 'apply' && b.operations?.[0]?.type === 'detail.update');\n    expect(updates).toHaveLength(1);\n    const lookups = server.sent.filter(b => b.action === 'status');\n    expect(lookups.map(l => l.operation_id)).toEqual([updates[0].operation_id]);\n  });\n\n  it('an account change drops the previous account\\'s details and typed edits before the next account renders', async () => {\n    // Wrong if: the next account sees the previous account's detail or its typed edit.\n    renderScreen();\n    const { sheet } = await rememberAndOpen();\n    fireEvent.press(within(sheet).getByRole('button', { name: `Edit saved detail: ${FRIDAYS}` }));\n    fireEvent.changeText(within(sheet).getByLabelText('Saved detail'), 'Typed by the first account');\n    // The next account's own records (the stand-in holds one account at a time).\n    useServer(scriptedServer());\n    await switchAccount(`other-${userCounter}`);\n    await waitFor(() => expect(screen.queryByText(FRIDAYS)).toBeNull());\n    expect(screen.queryByDisplayValue('Typed by the first account')).toBeNull();\n  });\n});\n\n/**\n * The same stand-in, but the first detail edit's reply is lost after it committed:\n * the server saves it, the client sees a network failure.\n */\nfunction scriptedServerWithDrop() {\n  const previous = server;\n  let dropped = false;\n  const wrapped = {\n    ...previous,\n    fetch: jest.fn(async (url: string, init: { body: string }) => {\n      const body = JSON.parse(init.body);\n      if (!dropped && body.action === 'apply' && body.operations?.[0]?.type === 'detail.update') {\n        dropped = true;\n        previous.sent.push(body);\n        previous.handle(body);\n        throw new TypeError('Network request failed');\n      }\n      return previous.fetch(url, init);\n    }),\n  };\n  return wrapped as unknown as ReturnType<typeof scriptedServer>;\n}\n\n\nit('a conflicting detail removal names the current revision, allows Cancel and preserves the historical receipt', async () => {\n  renderScreen();\n  await send(`Remember that ${FRIDAYS}`);\n  const card = await screen.findByTestId('detail-command-card');\n  const undo = await within(card).findByRole('button', { name: `Undo saving “${FRIDAYS}”` });\n  await waitFor(() => expect(enabled(undo)).toBe(true));\n  fireEvent.press(undo);\n  const current = 'I can attend appointments on Saturdays';\n  server.editDetailElsewhere(server.details()[0].detail_id, current);\n  fireEvent.press(within(card).getByRole('button', { name: 'Remove detail' }));\n  await within(card).findByText(en.savedDetails.undoConflict);\n  expect(within(card).getByText(`Saved: “${FRIDAYS}”.`)).toBeTruthy();\n  const review = within(card).getByRole('button', { name: /Remove “/ });\n  await waitFor(() => expect(enabled(review)).toBe(true));\n  fireEvent.press(review);\n  expect(within(card).getByText(`“${current}” will no longer be used in later conversations.`)).toBeTruthy();\n  fireEvent.press(within(card).getByRole('button', { name: 'Cancel' }));\n  expect(server.details()[0]).toMatchObject({ text: current, removed: false });\n  fireEvent.press(within(card).getByRole('button', { name: `Remove “${current}”` }));\n  fireEvent.press(within(card).getByRole('button', { name: 'Remove detail' }));\n  await within(card).findByText(`Removed “${current}”. It will not be used in later conversations.`);\n  expect(server.details()[0].removed).toBe(true);\n  expect(server.sent.filter(body => body.action === 'apply' && body.operations?.[0]?.type === 'detail.remove').at(-1)?.operations[0].expected_revision).toBe(2);\n});\n\ndescribe('the reviewed change of a conflicting detail Undo is bound to the server’s current detail (S370-1)', () => {\n  const SATURDAYS = 'I can attend appointments on Saturdays';\n  /** The app returns to the foreground: every AppState listener hears 'active'. */\n  function captureForeground() {\n    const listeners: ((state: string) => void)[] = [];\n    jest.spyOn(AppState, 'addEventListener').mockImplementation(((\n      _name: string,\n      cb: (state: string) => void\n    ) => {\n      listeners.push(cb);\n      return { remove: () => {} };\n    }) as never);\n    return () =>\n      act(async () => {\n        listeners.forEach(cb => cb('active'));\n      });\n  }\n  afterEach(() => jest.restoreAllMocks());\n\n  /** Saves Fridays by command, then confirms its Undo after another device changed it. */\n  async function conflictingUndo() {\n    await send(`Remember that ${FRIDAYS}`);\n    const card = await screen.findByTestId('detail-command-card');\n    const undo = await within(card).findByRole('button', { name: `Undo saving “${FRIDAYS}”` });\n    await waitFor(() => expect(enabled(undo)).toBe(true));\n    fireEvent.press(undo);\n    server.editDetailElsewhere(server.details()[0].detail_id, SATURDAYS);\n    fireEvent.press(within(card).getByRole('button', { name: 'Remove detail' }));\n    await within(card).findByText(en.savedDetails.undoConflict);\n    return card;\n  }\n  const removals = () =>\n    server.sent.filter(b => b.action === 'apply' && b.operations?.[0]?.type === 'detail.remove');\n\n  it('a newer edit read while the review is open withholds approval and names nothing stale', async () => {\n    const foreground = captureForeground();\n    renderScreen();\n    const card = await conflictingUndo();\n    const review = within(card).getByRole('button', { name: `Remove “${SATURDAYS}”` });\n    await waitFor(() => expect(enabled(review)).toBe(true));\n    fireEvent.press(review);\n    expect(within(card).getByText(`“${SATURDAYS}” will no longer be used in later conversations.`)).toBeTruthy();\n    // A third edit lands elsewhere and this device reads it while the review is open.\n    server.editDetailElsewhere(server.details()[0].detail_id, 'I can attend appointments on Sundays');\n    await foreground();\n    await within(card).findByText(en.savedDetails.reviewUnverified);\n    expect(within(card).queryByRole('button', { name: 'Remove detail' })).toBeNull();\n    expect(within(card).queryByText(new RegExp(SATURDAYS))).toBeNull();\n    expect(within(card).getByText(`Saved: “${FRIDAYS}”.`)).toBeTruthy();\n    expect(removals()).toHaveLength(0);\n    expect(server.details()[0]).toMatchObject({ revision: 3, removed: false });\n    fireEvent.press(within(card).getByRole('button', { name: en.taskActions.keepCurrent }));\n    await waitFor(() => expect(within(card).queryByText(en.savedDetails.reviewUnverified)).toBeNull());\n  });\n\n  it.each([\n    ['absent', () => undefined],\n    ['a different detail', (v: any) => ({ ...v, detail_id: 'e1000000-0000-4000-8000-000000000999' })],\n    ['an older revision', (v: any) => ({ ...v, revision: v.revision - 1 })],\n    ['a newer revision', (v: any) => ({ ...v, revision: v.revision + 1 })],\n    ['a removed detail', (v: any) => ({ ...v, removed: true })],\n    ['malformed text', (v: any) => ({ ...v, text: 42 })],\n  ])('current_detail %s: approval stays unavailable and nothing is removed', async (_name, transform) => {\n    server.setConflictDetail(transform);\n    renderScreen();\n    const card = await conflictingUndo();\n    await within(card).findByText(en.savedDetails.reviewUnverified);\n    expect(within(card).queryByRole('button', { name: /^Remove “/ })).toBeNull();\n    expect(within(card).queryByRole('button', { name: 'Remove detail' })).toBeNull();\n    expect(within(card).getByText(`Saved: “${FRIDAYS}”.`)).toBeTruthy();\n    expect(removals()).toHaveLength(0);\n    expect(server.details()[0]).toMatchObject({ text: SATURDAYS, revision: 2, removed: false });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"/Users/savargupta/.t3/worktrees/Unify/t3-c68f1368/unify-front-end/__tests__/companionActions/taskActionStoreDetailReview.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/Users/savargupta/.t3/worktrees/Unify/t3-c68f1368/unify-front-end/__tests__/companionActions/taskEdit.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'act' is defined but never used.","line":10,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":6,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"act"},"fix":{"range":[601,605],"text":""},"desc":"Remove unused variable \"act\"."}]},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":40,"column":17,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":40,"endColumn":33},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":55,"column":20,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":55,"endColumn":43},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":70,"column":38,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":70,"endColumn":61},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":84,"column":20,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":84,"endColumn":43},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":96,"column":5,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":96,"endColumn":21},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":97,"column":7,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":97,"endColumn":30},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":101,"column":9,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":101,"endColumn":25},{"ruleId":"@typescript-eslint/no-require-imports","severity":1,"message":"A `require()` style import is forbidden.","line":102,"column":11,"nodeType":"CallExpression","messageId":"noRequireImports","endLine":102,"endColumn":27},{"ruleId":"import/first","severity":1,"message":"Import in body of module; reorder to top.","line":322,"column":1,"nodeType":"ImportDeclaration","endLine":322,"endColumn":60,"fix":{"range":[0,11219],"text":"// Mounted acceptance of editing existing tasks through Companion (mobile-app#365,\n// direction B): the actual Companion screen, send hook, task cards and task bottom\n// sheet, driven through user controls. The companion-actions network is the scripted\n// contract stand-in (testSupport/companionActionsServer.ts); message saves and reads\n// and the model stream are scripted. Server authorization, revisions and persistence\n// are proven against the real endpoint and database in the web repo\n// (supabase/tests/companion-actions); this is not evidence of them.\nimport React from 'react';\nimport {\n  act,\n  fireEvent,\n  render,\n  screen,\n  waitFor,\n  within,\n} f