roviders are\n// controlled fixtures: OpenRouter (embeddings, guidance search, answer),\n// published checklist content and the official pages. Nothing here proves\n// hosted behaviour or live-source content.\n//\n// RUN: ./run.sh            (starts the stack on 127.0.0.1:59471-59473; run.sh\n//      takes PROBE_PROJECT_ID and PROBE_PORT_BASE for a separate stack)\n\nimport { assert, assertEquals } from 'jsr:@std/assert@1';\n\nconst realFetch = globalThis.fetch;\nconst env = (k: string) => {\n  const v = Deno.env.get(`PROBE_${k}`);\n  if (!v) throw new Error(`PROBE_${k} missing: run via ./run.sh`);\n  return v;\n};\nconst API_URL = env('API_URL');\nconst ANON_KEY = env('ANON_KEY');\nconst SERVICE_ROLE_KEY = env('SERVICE_ROLE_KEY');\n// Local stacks only (run.sh picks the port; default 59471).\nif (!/^http:\\/\\/(127\\.0\\.0\\.1|localhost):\\d{4,5}$/.test(API_URL)) {\n  throw new Error(`probe refuses to run against ${API_URL}`);\n}\n\nconst { captureServe, fetchLog, json, setRoutes, testEnv } = await import(\n  '../../functions/_shared/testHarness.ts'\n);\nconst { embeddingsResponse } = await import('../../functions/_shared/testEmbeddingFixtures.ts');\ntype FetchCall = import('../../functions/_shared/testHarness.ts').FetchCall;\n\ntestEnv.SUPABASE_URL = API_URL;\ntestEnv.SUPABASE_ANON_KEY = ANON_KEY;\ntestEnv.SUPABASE_SERVICE_ROLE_KEY = SERVICE_ROLE_KEY;\ntestEnv.SANITY_PROJECT_ID = 'testproject';\ntestEnv.SANITY_DATASET = 'production';\n\nconst takeHandler = captureServe();\nawait import('../../functions/rag-query/index.ts');\nconst handler = takeHandler();\n\nconst opts = { sanitizeOps: false, sanitizeResources: false };\nconst LOCAL = new URL(API_URL).origin;\nconst SIN_URL = 'https://www.canada.ca/en/employment-social-development/services/sin.html';\n\n// ---------------------------------------------------------------- local stack helpers\n\nasync function rest(\n  method: string,\n  path: string,\n  body?: unknown,\n  jwt = SERVICE_ROLE_KEY,\n  prefer = 'return=representation'\n): Promise<{ status: number; json: any }> {\n  const res = await realFetch(`${API_URL}${path}`, {\n    method,\n    headers: {\n      apikey: jwt === SERVICE_ROLE_KEY ? SERVICE_ROLE_KEY : ANON_KEY,\n      Authorization: `Bearer ${jwt}`,\n      'Content-Type': 'application/json',\n      Prefer: prefer,\n    },\n    body: body === undefined ? undefined : JSON.stringify(body),\n  });\n  const text = await res.text();\n  let parsed: any = text;\n  try {\n    parsed = text ? JSON.parse(text) : null;\n  } catch {\n    // keep text\n  }\n  return { status: res.status, json: parsed };\n}\n\n// ---------------------------------------------------------------- write attempts\n//\n// supabase/migrations/…_probe_write_audit.sql (probe only) records every\n// INSERT/UPDATE/DELETE statement on the profile, task, conversation and message\n// tables, including writes that leave rows unchanged or match no row.\n\ninterface WriteAttempt {\n  id: number;\n  table_name: string;\n  operation: string;\n  request_role: string | null;\n}\n\nasync function writeAttemptsAfter(id: number): Promise<WriteAttempt[]> {\n  const res = await realFetch(\n    `${API_URL}/rest/v1/write_attempts?select=id,table_name,operation,request_role&id=gt.${id}&order=id`,\n    { headers: { apikey: SERVICE_ROLE_KEY, Authorization: `Bearer ${SERVICE_ROLE_KEY}`, 'Accept-Profile': 'probe_audit' } }\n  );\n  const body = await res.json();\n  if (res.status !== 200 || !Array.isArray(body)) throw new Error(`write audit unreadable: ${res.status}`);\n  return body as WriteAttempt[];\n}\n\nasync function lastWriteAttempt(): Promise<number> {\n  const all = await writeAttemptsAfter(0);\n  return all.length ? all[all.length - 1].id : 0;\n}\n\n/** Every write attempt made while an answer was being produced, across this file. */\nconst writesDuringAnswers: Array<WriteAttempt & { prompt: string }> = [];\n\ninterface Account {\n  id: string;\n  jwt: string;\n  email: string;\n}\n\nlet counter = 0;\nasync function newAccount(label: string): Promise<Account> {\n  const email = `${label}-${Date.now()}-${counter++}@probe.invalid`;\n  const password = 'probe-password-1';\n  const created = await realFetch(`${API_URL}/auth/v1/admin/users`, {\n    method: 'POST',\n    headers: { apikey: SERVICE_ROLE_KEY, Authorization: `Bearer ${SERVICE_ROLE_KEY}`, 'Content-Type': 'application/json' },\n    body: JSON.stringify({ email, password, email_confirm: true }),\n  }).then(r => r.json());\n  const session = await realFetch(`${API_URL}/auth/v1/token?grant_type=password`, {\n    method: 'POST',\n    headers: { apikey: ANON_KEY, 'Content-Type': 'application/json' },\n    body: JSON.stringify({ email, password }),\n  }).then(r => r.json());\n  if (!created?.id || !session?.access_token) throw new Error('account setup failed');\n  return { id: created.id, jwt: session.access_token, email };\n}\n\nfunction inDays(days: number): string {\n  return new Date(Date.now() + days * 86_400_000).toISOString().slice(0, 10);\n}\n\n// ---------------------------------------------------------------- fixtures\n\nconst A = await newAccount('vancouver');\nconst B = await newAccount('toronto');\n\nasync function seed() {\n  await rest('POST', '/rest/v1/user_onboarding_profiles', [\n    { id: A.id, persona: 'other', city: 'Vancouver', province: 'British Columbia', arrival_date: inDays(6), stage: 0 },\n    { id: B.id, persona: 'skilled_worker', city: 'Toronto', province: 'Ontario', arrival_date: '2025-02-01', stage: 2 },\n  ]);\n  await rest('POST', '/rest/v1/user_tasks', [\n    { user_id: A.id, sanity_checklist_id: 'checklist-bank', completed: false },\n    { user_id: B.id, sanity_checklist_id: 'checklist-credit', completed: true },\n  ]);\n  await rest('POST', '/rest/v1/custom_checklist_tasks', [\n    { user_id: A.id, priority: 'Do now', title: 'Find a family doctor' },\n    { user_id: B.id, priority: 'Do now', title: 'B private task title' },\n  ]);\n  const conv = await rest('POST', '/rest/v1/conversations', [\n    { user_id: A.id, title: 'A' },\n    { user_id: B.id, title: 'B' },\n  ]);\n  const [convA, convB] = conv.json as Array<{ id: number; conversation_identifier: string }>;\n  await rest('POST', '/rest/v1/messages', [\n    { conversation_id: convB.id, role: 'user', content: 'B private message' },\n  ]);\n  return { convA, convB };\n}\nconst { convA, convB } = await seed();\n\nconst CONTENT: Record<string, unknown[]> = {\n  '\"not_arrived\"': [\n    { _id: 'checklist-sin', _rev: 'rev-sin-3', title: 'Get your SIN' },\n    { _id: 'checklist-bank', _rev: 'rev-bank-1', title: 'Open a bank account' },\n  ],\n  '\"months_3_12\"': [{ _id: 'checklist-credit', _rev: 'rev-credit-2', title: 'Build your credit history' }],\n};\n\nasync function passthrough(call: FetchCall): Promise<Response> {\n  const body =\n    call.method === 'GET' || call.method === 'HEAD' || call.body === undefined\n      ? undefined\n      : typeof call.body === 'string'\n        ? call.body\n        : JSON.stringify(call.body);\n  return await realFetch(call.url, { method: call.method, headers: call.headers, body });\n}\n\n/** Fault injection: the conversation ownership lookup answers 503. */\nlet conversationLookupFails = false;\n\nfunction routes(call: FetchCall): Response | undefined {\n  if (\n    conversationLookupFails &&\n    call.url.origin === LOCAL &&\n    call.url.pathname === '/rest/v1/conversations' &&\n    call.method === 'GET'\n  ) {\n    return json({ code: 'XX000', message: 'temporary database failure' }, 503);\n  }\n  if (call.url.origin === LOCAL) return passthrough(call) as unknown as Response;\n  if (call.url.hostname === 'testproject.apicdn.sanity.io') {\n    return json({ result: CONTENT[call.url.searchParams.get('$stage') ?? ''] ?? [] });\n  }\n  if (call.url.hostname === 'openrouter.ai') {\n    if (call.url.pathname.endsWith('/embeddings')) {\n      return embeddingsResponse((call.body as { input: unknown[] }).input.length);\n    }\n    if ((call.body as { plugins?: unknown }).plugins) {\n      return json({ choices: [{ message: { content: SIN_URL } }] });\n    }\n    return json({\n      choices: [{ message: { content: 'Answer.\\n[TOPIC]: settling_in' }, finish_reason: 'stop' }],\n      usage: { prompt_tokens: 1, completion_tokens: 1, total_tokens: 2 },\n      model: 'test/model',\n      provider: 'TestProvider',\n    });\n  }\n  if (call.url.href === SIN_URL) {\n    return new Response('<html><title>SIN</title><main><p>Apply for a SIN.</p></main></html>', {\n      status: 200,\n      headers: { 'Content-Type': 'text/html' },\n    });\n  }\n  if (call.url.hostname.endsWith('posthog.com')) return json({ status: 1 });\n  return undefined;\n}\n\nfunction req(who: Account | { jwt: string }, prompt: string, extra: Record<string, unknown> = {}): Request {\n  return new Request('http://localhost/rag-query', {\n    method: 'POST',\n    headers: { Authorization: `Bearer ${who.jwt}`, 'Content-Type': 'application/json' },\n    body: JSON.stringify({ prompt, messages: [], ...extra }),\n  });\n}\n\nasync function ask(who: Account | { jwt: string }, prompt: string, extra: Record<string, unknown> = {}) {\n  setRoutes(routes);\n  const mark = await lastWriteAttempt();\n  const res = await handler(req(who, prompt, extra));\n  const body = await res.json();\n  const writes = await writeAttemptsAfter(mark);\n  writesDuringAnswers.push(...writes.map(w => ({ ...w, prompt })));\n  const calls = [...fetchLog];\n  const answer = calls.find(\n    c => c.url.pathname.endsWith('/chat/completions') && !(c.body as { plugins?: unknown }).plugins\n  );\n  return { status: res.status, body, context: body.context as Record<string, any>, answer, calls, writes };\n}\n\nconst tasksOf = (context: Record<string, any>) =>\n  (context.items as Array<Record<string, any>>)\n    .filter(i => i.kind === 'checklist_task')\n    .map(i => `${i.id}|${i.title}|${i.state}`);\n\nconst QUESTION = 'I arrive in Vancouver next week. What should I do first?';\n\n// ---------------------------------------------------------------- tests\n\nDeno.test({\n  ...opts,\n  name: 'real RLS: each account reads only its own profile and Checklist, whatever userId the body claims',\n  fn: async () => {\n    const a = await ask(A, QUESTION, { conversationIdentifier: convA.conversation_identifier, userId: B.id });\n    assertEquals(a.status, 200);\n    const aTasks = tasksOf(a.context);\n    assertEquals(aTasks[0], 'sanity:checklist-sin|Get your SIN|not_started');\n    assertEquals(aTasks[1].startsWith('sanity:checklist-bank|Open a bank account|not_started'), true);\n    assertEquals(aTasks.length, 3);\n    assert(aTasks[2].startsWith('custom:') && aTasks[2].includes('Find a family doctor'));\n    const everything = JSON.stringify({ context: a.context, answer: a.answer?.body });\n    assert(!everything.includes('B private'), 'nothing of account B reaches A');\n    const profile = (a.context.items as Array<Record<string, any>>).find(i => i.kind === 'profile');\n    assertEquals(profile?.fields.find((f: Record<string, string>) => f.key === 'province').value, 'British Columbia');\n\n    const b = await ask(B, 'What should I do first to build credit?', {\n      conversationIdentifier: convB.conversation_identifier,\n    });\n    const bTasks = tasksOf(b.context);\n    assertEquals(bTasks.length, 2);\n    assert(/^custom:\\d+\\|B private task title\\|not_started$/.test(bTasks[0]), bTasks[0]);\n    assertEquals(bTasks[1], 'sanity:checklist-credit|Build your credit history|completed');\n    assert(!JSON.stringify(b.context).includes('Find a family doctor'));\n  },\n});\n\nDeno.test({\n  ...opts,\n  name: \"real RLS: another account's conversation id is denied and its history is not used\",\n  fn: async () => {\n    const a = await ask(A, QUESTION, {\n      conversationIdentifier: convB.conversation_identifier,\n      messages: [{ role: 'user', message: 'turn sent with the foreign conversation' }],\n    });\n    assertEquals(a.status, 200);\n    assertEquals(\n      a.context.reads.find((r: Record<string, string>) => r.capability === 'context.conversation').status,\n      'denied'\n    );\n    assert(!a.context.items.some((i: Record<string, unknown>) => i.kind === 'conversation'));\n    const sent = JSON.stringify((a.answer?.body as { messages: unknown }).messages);\n    assert(!sent.includes('turn sent with the foreign conversation'));\n    assert(!sent.includes('B private message'));\n  },\n});\n\nDeno.test({\n  ...opts,\n  name: 'real RLS: a conversation deleted on another device is denied on the next answer',\n  fn: async () => {\n    const created = await rest('POST', '/rest/v1/conversations', [{ user_id: A.id, title: 'temp' }], A.jwt);\n    assertEquals(created.status, 201);\n    const id = created.json[0].conversation_identifier;\n    const before = await ask(A, QUESTION, { conversationIdentifier: id });\n    assertEquals(before.context.items.find((i: Record<string, unknown>) => i.kind === 'conversation')?.id, id);\n    const deleted = await rest('DELETE', `/rest/v1/conversations?conversation_identifier=eq.${id}`, undefined, A.jwt);\n    assertEquals(deleted.status, 200);\n    const after = await ask(A, QUESTION, { conversationIdentifier: id });\n    assertEquals(\n      after.context.reads.find((r: Record<string, string>) => r.capability === 'context.conversation').status,\n      'denied'\n    );\n  },\n});\n\nDeno.test({\n  ...opts,\n  name: 'real auth: a deleted account and a signed-out session get 401 before any context read',\n  fn: async () => {\n    const gone = await newAccount('gone');\n    const del = await realFetch(`${API_URL}/auth/v1/admin/users/${gone.id}`, {\n      method: 'DELETE',\n      headers: { apikey: SERVICE_ROLE_KEY, Authorization: `Bearer ${SERVICE_ROLE_KEY}` },\n    });\n    await del.body?.cancel();\n    const deletedRes = await ask(gone, QUESTION);\n    assertEquals(deletedRes.status, 401);\n\n    const leaving = await newAccount('leaving');\n    const out = await realFetch(`${API_URL}/auth/v1/logout?scope=global`, {\n      method: 'POST',\n      headers: { apikey: ANON_KEY, Authorization: `Bearer ${leaving.jwt}` },\n    });\n    await out.body?.cancel();\n    const signedOut = await ask(leaving, QUESTION);\n    assertEquals(signedOut.status, 401);\n    for (const res of [deletedRes, signedOut]) {\n      assert(!res.calls.some(c => /\\/rest\\/v1\\/(user_onboarding_profiles|user_tasks|custom_checklist_tasks|conversations)/.test(c.url.pathname)));\n    }\n  },\n});\n\nDeno.test({\n  ...opts,\n  name: 'real RLS: simultaneous requests from two accounts stay isolated',\n  fn: async () => {\n    setRoutes(routes);\n    const mark = await lastWriteAttempt();\n    const results = await Promise.all(\n      Array.from({ length: 6 }, (_, i) =>\n        handler(\n          req(i % 2 === 0 ? A : B, i % 2 === 0 ? QUESTION : 'What should I do first to build credit?', {\n            conversationIdentifier: (i % 2 === 0 ? convA : convB).conversation_identifier,\n            ...(i === 0 ? { stream: true } : {}),\n          })\n        )\n      )\n    );\n    for (const [i, res] of results.entries()) {\n      assertEquals(res.status, 200);\n      let context: Record<string, any>;\n      if (i === 0) {\n        const meta = (await res.text()).split('\\n\\n').find(b => b.startsWith('event: metadata'))!;\n        context = JSON.parse(meta.split('\\n')[1].slice(6)).context;\n      } else {\n        context = (await res.json()).context;\n      }\n      const text = JSON.stringify(context);\n      if (i % 2 === 0) {\n        assert(text.includes('Find a family doctor') && !text.includes('B private'), `request ${i} is A's`);\n        assertEquals(context.items.find((c: Record<string, unknown>) => c.kind === 'conversation').id, convA.conversation_identifier);\n      } else {\n        assert(text.includes('B private task title') && !text.includes('Find a family doctor'), `request ${i} is B's`);\n        assertEquals(context.items.find((c: Record<string, unknown>) => c.kind === 'conversation').id, convB.conversation_identifier);\n      }\n    }\n    const writes = await writeAttemptsAfter(mark);\n    writesDuringAnswers.push(...writes.map(w => ({ ...w, prompt: 'simultaneous' })));\n    assertEquals(writes, [], 'simultaneous answers attempt no write');\n  },\n});\n\nDeno.test({\n  ...opts,\n  name: 'real database: answering with stated details writes nothing to the profile, tasks or messages',\n  fn: async () => {\n    const snapshot = async () => {\n      const tables = ['user_onboarding_profiles', 'user_tasks', 'custom_checklist_tasks', 'messages', 'conversations'];\n      const rows = await Promise.all(tables.map(t => rest('GET', `/rest/v1/${t}?select=*`)));\n      rows.forEach((r, i) => {\n        assertEquals(r.status, 200, tables[i]);\n        assert(Array.isArray(r.json) && r.json.length > 0, `${tables[i]} has rows to compare`);\n      });\n      return JSON.stringify(rows.map(r => (r.json as unknown[]).map(row => JSON.stringify(row)).sort()));\n    };\n    // Control: the audit sees a write that stores the value already there.\n    const mark = await lastWriteAttempt();\n    const same = await rest(\n      'PATCH',\n      `/rest/v1/user_onboarding_profiles?id=eq.${A.id}`,\n      { city: 'Vancouver' },\n      A.jwt\n    );\n    assertEquals(same.status, 200);\n    const control = await writeAttemptsAfter(mark);\n    assertEquals(control.map(w => `${w.table_name}:${w.operation}:${w.request_role}`), [\n      'user_onboarding_profiles:UPDATE:authenticated',\n    ]);\n\n    const before = await snapshot();\n    const res = await ask(A, 'I am moving to Toronto in 2 weeks, remember that. What should I do first?', {\n      conversationIdentifier: convA.conversation_identifier,\n    });\n    assertEquals(res.status, 200);\n    assertEquals(res.context.clarification?.kind, 'profile_conflict');\n    // No write attempt at all, not only unchanged rows.\n    assertEquals(res.writes, [], 'the answer attempted a write');\n    const after = await snapshot();\n    assertEquals(after, before);\n  },\n});\n\nDeno.test({\n  ...opts,\n  name: 'real migration: companion_context saves with the owner, stays private, rejects other shapes, and old clients are unaffected',\n  fn: async () => {\n    const { context } = await ask(A, QUESTION, { conversationIdentifier: convA.conversation_identifier });\n    const saved = await rest(\n      'POST',\n      '/rest/v1/messages',\n      { conversation_id: convA.id, role: 'assistant', content: 'Answer.', sources: null, companion_context: context },\n      A.jwt\n    );\n    assertEquals(saved.status, 201);\n    const id = saved.json[0].id;\n\n    const own = await rest('GET', `/rest/v1/messages?select=id,companion_context&id=eq.${id}`, undefined, A.jwt);\n    assertEquals(own.json[0].companion_context.version, 1);\n    assertEquals(own.json[0].companion_context.guidance.sources[0].url, SIN_URL);\n\n    const other = await rest('GET', `/rest/v1/messages?select=id,companion_context&id=eq.${id}`, undefined, B.jwt);\n    assertEquals(other.json, []);\n    const foreign = await rest(\n      'POST',\n      '/rest/v1/messages',\n      { conversation_id: convA.id, role: 'assistant', content: 'x', companion_context: context },\n      B.jwt\n    );\n    assertEquals(foreign.status, 403);\n\n    const badShape = await rest(\n      'POST',\n      '/rest/v1/messages',\n      { conversation_id: convA.id, role: 'assistant', content: 'x', companion_context: { version: 2 } },\n      A.jwt\n    );\n    assertEquals(badShape.status, 400);\n    const notObject = await rest(\n      'POST',\n      '/rest/v1/messages',\n      { conversation_id: convA.id, role: 'assistant', content: 'x', companion_context: ['x'] },\n      A.jwt\n    );\n    assertEquals(notObject.status, 400);\n\n    // An older client's insert and select (no companion_context) still work.\n    const legacy = await rest(\n      'POST',\n      '/rest/v1/messages',\n      { conversation_id: convA.id, role: 'assistant', content: 'legacy', sources: [{ document_id: 1, document_title: 'T', url: 'https://www.canada.ca/' }] },\n      A.jwt\n    );\n    assertEquals(legacy.status, 201);\n    const legacyRead = await rest(\n      'GET',\n      `/rest/v1/messages?select=id,role,content,sources,created_at,conversations!inner(conversation_identifier,user_id)&conversations.conversation_identifier=eq.${convA.conversation_identifier}`,\n      undefined,\n      A.jwt\n    );\n    assertEquals(legacyRead.status, 200);\n    assert(legacyRead.json.some((m: Record<string, unknown>) => m.content === 'legacy'));\n  },\n});\n\nDeno.test({\n  ...opts,\n  name: \"real JWT + injected lookup failure: another account's history is not used when access cannot be established\",\n  fn: async () => {\n    // Real RLS hides B's conversation from A before the fault.\n    const foreign = await rest(\n      'GET',\n      `/rest/v1/conversations?select=conversation_identifier&conversation_identifier=eq.${convB.conversation_identifier}`,\n      undefined,\n      A.jwt\n    );\n    assertEquals(foreign.json, []);\n    conversationLookupFails = true;\n    try {\n      const r = await ask(A, 'What should I do first?', {\n        conversationIdentifier: convB.conversation_identifier,\n        messages: [{ role: 'user', message: 'I am moving to Toronto tomorrow' }],\n      });\n      assertEquals(r.status, 200);\n      assert(r.context.reads.find((x: Record<string, string>) => x.capability === 'context.conversation').status !== 'ok');\n      assertEquals(r.context.items.filter((i: Record<string, unknown>) => i.kind === 'conversation_detail'), []);\n      const sent = JSON.stringify((r.answer?.body as { messages: unknown }).messages);\n      assert(!sent.includes('Toronto'), 'the unverified earlier turn reaches the model');\n    } finally {\n      conversationLookupFails = false;\n    }\n  },\n});\n\nDeno.test({\n  ...opts,\n  // Last: every ask() above recorded the write attempts made during its answer.\n  name: 'real database: no answer in this file attempted any write',\n  fn: () => {\n    assertEquals(writesDuringAnswers, []);\n  },\n});\n","usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/actions_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/boundary_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/command_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/compose_365_370_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/compose_367_370_rollback_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/compose_367_370_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/compose_rollback_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/create_rollback_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/create_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/details_language_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/details_rollback_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/details_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/edit_command_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/edit_published_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/edit_rollback_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/edit_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/edit_undo_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/planSupport.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/plan_access_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/plan_multiple_reviews_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/plan_recovery_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/plan_retry_review_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/plan_rollback_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/plan_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/plan_undo_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/receipt_history_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/remove_plan_race_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/remove_rollback_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/remove_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/rollback_test.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":77,"column":49,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":77,"endColumn":52,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5881,5884],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5881,5884],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// The production migration keeps the compatibility and rollback policy accepted in\n// #360 (mobile-app#361). Starts on the hosted-shape baseline: run.sh resets the\n// database before each file. Legacy client calls are the exact PostgREST shapes the\n// released mobile and web Checklist services send.\nimport { assert, assertEquals } from 'jsr:@std/assert@1';\nimport {\n  type Account, apply, migrate, migrationApplied, newAccount, openGate, read, setState, sql, status, taskOf, testOpts,\n  undo,\n} from './support.ts';\n\nconst iso = () => new Date().toISOString();\nconst strip = (row: Record<string, unknown> | null | undefined, keep: string[]) =>\n  row ? Object.fromEntries(keep.map(k => [k, row[k] ?? null])) : row;\nconst dbNow = async () => (await sql`select clock_timestamp() t`)[0].t.getTime() as number;\n\nasync function legacyScenario(a: Account) {\n  const out: Record<string, unknown> = {};\n  const done = (r: { error: { message: string } | null }) => r.error?.message ?? 'ok';\n  out.complete = done(await a.client.from('user_tasks').upsert({ user_id: a.id, task_id: null, sanity_checklist_id: 's1', completed: true, completed_at: iso() }, { onConflict: 'user_id,sanity_checklist_id' }));\n  out.uncheck = done(await a.client.from('user_tasks').update({ completed: false, completed_at: null }).eq('user_id', a.id).eq('sanity_checklist_id', 's1'));\n  out.dismiss = done(await a.client.from('user_tasks').upsert({ user_id: a.id, sanity_checklist_id: 's2', dismissed_at: iso() }, { onConflict: 'user_id,sanity_checklist_id' }));\n  out.undismiss = done(await a.client.from('user_tasks').upsert({ user_id: a.id, sanity_checklist_id: 's2', dismissed_at: null }, { onConflict: 'user_id,sanity_checklist_id' }));\n  out.ensure = done(await a.client.from('user_tasks').insert([{ user_id: a.id, task_id: null, sanity_checklist_id: 's3', completed: false }, { user_id: a.id, task_id: null, sanity_checklist_id: 's4', completed: false }]));\n  const tasks = await a.client.from('user_tasks').select(`user_task_id, user_id, task_id, sanity_checklist_id, completed, completed_at, dismissed_at,\n    task:personalized_checklist_tasks!user_tasks_task_id_fkey (id, persona, stage, priority, task_name, task_description, task_module)`).eq('user_id', a.id).order('sanity_checklist_id');\n  if (tasks.error) throw new Error(`getUserTasks shape failed: ${tasks.error.message}`);\n  out.userTasks = tasks.data?.map(r => strip(r, ['sanity_checklist_id', 'completed', 'dismissed_at']));\n  const created = await a.client.from('custom_checklist_tasks').insert({ user_id: a.id, priority: 'Do soon', title: 'Phone plan', description: '' }).select('*').single();\n  out.createCustom = created.error?.message ?? 'ok';\n  if (!created.data) return out;\n  const id = created.data.id;\n  out.customShape = strip(created.data, ['priority', 'title', 'description', 'completed', 'completed_at']);\n  out.customComplete = done(await a.client.from('custom_checklist_tasks').update({ completed: true, completed_at: iso() }).eq('id', id).eq('user_id', a.id));\n  out.customList = (await a.client.from('custom_checklist_tasks').select('*').eq('user_id', a.id)).data?.map(r => strip(r, ['title', 'completed']));\n  out.customUncheck = done(await a.client.from('custom_checklist_tasks').update({ completed: false, completed_at: null }).eq('id', id).eq('user_id', a.id));\n  out.customDelete = done(await a.client.from('custom_checklist_tasks').delete().eq('id', id).eq('user_id', a.id));\n  out.customAfterDelete = (await a.client.from('custom_checklist_tasks').select('id').eq('user_id', a.id)).data?.length;\n  out.order = done(await a.client.from('checklist_task_order').upsert({ user_id: a.id, priority: 'Do now', ordered_keys: ['sanity:s1'] }, { onConflict: 'user_id,priority' }));\n  return out;\n}\n\nasync function seeded(label: string) {\n  const a = await newAccount(label);\n  await sql`insert into user_tasks (user_id, sanity_checklist_id, completed, completed_at) values (${a.id}, 'seed-done', true, now()), (${a.id}, 'seed-open', false, null)`;\n  await sql`insert into custom_checklist_tasks (user_id, priority, title, completed, completed_at) values (${a.id}, 'Do now', 'seed custom done', true, now()), (${a.id}, 'Do soon', 'seed custom open', false, null)`;\n  return a;\n}\n\nasync function legacySnapshot(a: Account) {\n  const ut = await sql`select sanity_checklist_id, completed, completed_at is not null as has_completed_at, dismissed_at is not null as dismissed from user_tasks where user_id = ${a.id} order by user_task_id`;\n  const ct = await sql`select title, priority, completed, completed_at is not null as has_completed_at from custom_checklist_tasks where user_id = ${a.id} order by id`;\n  return { ut: ut.map(r => ({ ...r })), ct: ct.map(r => ({ ...r })) };\n}\n\nconst reminders = async (a: Account) =>\n  (await sql`select id, task_ref, status, cancelled_reason, cancelled_at from companion_task_reminders\n               where user_id = ${a.id} order by task_ref`).map(r => ({ ...r }));\n\nasync function roundTrip() {\n  await sql`update companion_feature_gate set enabled = false`;\n  await migrate('down');\n  await migrate('up');\n  await openGate();\n}\n\nDeno.test({ name: 'legacy Checklist calls and existing rows are identical on the baseline, after up, after down and after up again', ...testOpts, fn: async () => {\n  assert(!(await migrationApplied()), 'run.sh must reset to the baseline first');\n  const pre = await seeded('pre');\n  const baseline = await legacyScenario(await seeded('baseline'));\n  const beforeUp = await legacySnapshot(pre);\n  await migrate('up');\n  await openGate();\n  assertEquals(await legacySnapshot(pre), beforeUp, 'up changed a legacy column of an existing row');\n  assertEquals(await legacyScenario(await seeded('up')), baseline);\n  // Existing rows map onto the four states with no backfill.\n  const tasks = (await read(pre)).json.tasks;\n  const state = (ref: string) => tasks.find((t: any) => t.task_ref === ref)?.state;\n  assertEquals([state('sanity:seed-done'), state('sanity:seed-open')], ['completed', 'not_started']);\n\n  const w = await apply(pre, [setState('sanity:seed-open', 'waiting', 1, 'Letter')]);\n  assertEquals(w.status, 200, JSON.stringify(w.json));\n  await sql`update companion_feature_gate set enabled = false`;\n  await migrate('down');\n  assertEquals(await legacyScenario(await seeded('down')), baseline);\n  const [pol] = await sql`select qual from pg_policies where policyname = 'Users can read own custom checklist tasks'`;\n  assertEquals(pol.qual, '(auth.uid() = user_id)');\n  await migrate('up');\n  await openGate();\n  assertEquals(await legacyScenario(await seeded('upagain')), baseline);\n}});\n\nDeno.test({ name: 'the migration ships the feature off; API roles cannot execute the action SQL', ...testOpts, fn: async () => {\n  if (await migrationApplied()) await migrate('down');\n  await migrate('up');\n  const [g] = await sql`select enabled, min_contract_version, max_contract_version from companion_feature_gate`;\n  assertEquals([g.enabled, g.min_contract_version, g.max_contract_version], [false, 1, 1]);\n  const fns = await sql`\n    select p.proname, has_function_privilege('anon', p.oid, 'execute') anon,\n           has_function_privilege('authenticated', p.oid, 'execute') authed,\n           has_function_privilege('service_role', p.oid, 'execute') svc\n      from pg_proc p join pg_namespace n on n.oid = p.pronamespace\n     where n.nspname = 'public' and p.proname like 'companion\\\\_%'`;\n  assert(fns.length > 10);\n  for (const f of fns) assertEquals([f.proname, f.anon, f.authed], [f.proname, false, false]);\n  for (const name of ['companion_apply_actions', 'companion_undo_action', 'companion_action_status', 'companion_read_tasks']) {\n    assert(fns.find(f => f.proname === name)?.svc, `${name} must be executable by the service role`);\n  }\n  await openGate();\n}});\n\nDeno.test({ name: 'receipts, waiting reasons and Undo survive a rollback and re-application; held revisions go stale', ...testOpts, fn: async () => {\n  if (!(await migrationApplied())) await migrate('up');\n  await openGate();\n  const a = await newAccount('alice');\n  await sql`insert into user_tasks (user_id, sanity_checklist_id) values (${a.id}, 'sin')`;\n  const w = await apply(a, [setState('sanity:sin', 'waiting', 1, 'Letter from Service Canada')]);\n  assertEquals(w.status, 200);\n  await roundTrip();\n  const t = await taskOf(a, 'sanity:sin');\n  assertEquals([t.state, t.waiting_reason], ['waiting', 'Letter from Service Canada']);\n  assertEquals(t.revision, w.json.receipt.after_revision + 1, 'every revision held from before the rollback must be stale');\n  const s = await status(a, w.json.operation_id);\n  assertEquals(s.json.status, 'applied');\n  const retry = await apply(a, [setState('sanity:sin', 'waiting', 1, 'Letter from Service Canada')], { operation_id: w.json.operation_id });\n  assertEquals([retry.status, retry.json.replayed], [200, true]);\n  const [{ n }] = await sql`select count(*)::int n from companion_action_receipts where user_id = ${a.id}`;\n  assertEquals(n, 1);\n  // Undo of the pre-rollback receipt cannot apply blindly: it asks for review.\n  const u = await undo(a, w.json.operation_id);\n  assertEquals([u.status, u.json.error], [409, 'undo_conflict']);\n  assertEquals((await taskOf(a, 'sanity:sin')).state, 'waiting');\n}});\n\nDeno.test({ name: 'a full rollback stops every pending reminder; re-application restarts none; history stays exact', ...testOpts, fn: async () => {\n  if (!(await migrationApplied())) await migrate('up');\n  await openGate();\n  const a = await newAccount('policy');\n  // Reminders as the reminder slice will write them (service role).\n  const refs = ['sanity:untouched', 'sanity:reopened', 'sanity:done-before', 'sanity:sent-before'];\n  for (const ref of refs) await sql`insert into user_tasks (user_id, sanity_checklist_id) values (${a.id}, ${ref.slice(7)})`;\n  for (const ref of refs) {\n    await sql`insert into companion_task_reminders (user_id, task_ref, remind_at, time_zone)\n      values (${a.id}, ${ref}, now() + interval '1 day', 'America/Vancouver')`;\n  }\n  const doneRev = (await taskOf(a, 'sanity:done-before')).revision;\n  assertEquals((await apply(a, [setState('sanity:done-before', 'completed', doneRev)])).status, 200);\n  await sql`update companion_task_reminders set status = 'sent' where user_id = ${a.id} and task_ref = 'sanity:sent-before'`;\n  const history = Object.fromEntries((await reminders(a)).map(r => [r.task_ref, r]));\n  assertEquals([history['sanity:done-before'].status, history['sanity:done-before'].cancelled_reason], ['cancelled', 'task_completed']);\n\n  await sql`update companion_feature_gate set enabled = false`;\n  const downStart = await dbNow();\n  await migrate('down');\n  const downEnd = await dbNow();\n  // While rolled back, the archived rows already show every open reminder stopped.\n  const archived = Object.fromEntries((await sql`select row_data from companion_rollback_archive\n      where source = 'companion_task_reminders' and row_data->>'user_id' = ${a.id}`)\n    .map(r => [r.row_data.task_ref, [r.row_data.status, r.row_data.cancelled_reason]]));\n  assertEquals(archived['sanity:untouched'], ['cancelled', 'schema_rollback']);\n  assertEquals(archived['sanity:reopened'], ['cancelled', 'schema_rollback']);\n  assertEquals(archived['sanity:done-before'], ['cancelled', 'task_completed']);\n  assertEquals(archived['sanity:sent-before'], ['sent', null]);\n  // An old client completes and reopens a task while rolled back.\n  await a.client.from('user_tasks').update({ completed: true, completed_at: iso() }).eq('sanity_checklist_id', 'reopened');\n  await a.client.from('user_tasks').update({ completed: false, completed_at: null }).eq('sanity_checklist_id', 'reopened');\n  await migrate('up');\n  await openGate();\n\n  const rows = Object.fromEntries((await reminders(a)).map(r => [r.task_ref, r]));\n  for (const ref of ['sanity:untouched', 'sanity:reopened']) {\n    assertEquals([rows[ref].status, rows[ref].cancelled_reason], ['cancelled', 'schema_rollback'], ref);\n    const at = new Date(rows[ref].cancelled_at).getTime();\n    assert(at >= downStart && at <= downEnd, `${ref} stopped at ${rows[ref].cancelled_at}, not during the rollback`);\n  }\n  assertEquals(rows['sanity:done-before'], history['sanity:done-before'], 'stopped history was rewritten');\n  assertEquals(rows['sanity:sent-before'], history['sanity:sent-before'], 'a delivered reminder changed');\n  const snapshot = await reminders(a);\n  await roundTrip();\n  assertEquals(await reminders(a), snapshot, 'a second rollback cycle changed reminder history');\n}});\n\nDeno.test({ name: 'account deletion removes receipts and proposals with the account', ...testOpts, fn: async () => {\n  if (!(await migrationApplied())) await migrate('up');\n  await openGate();\n  const a = await newAccount('leaver');\n  await sql`insert into user_tasks (user_id, sanity_checklist_id) values (${a.id}, 'x')`;\n  const w = await apply(a, [setState('sanity:x', 'in_progress', 1)]);\n  await apply(a, [setState('sanity:x', 'waiting', w.json.receipt.after_revision)]);\n  assertEquals((await undo(a, w.json.operation_id)).status, 409);\n  const del = await a.client.rpc('delete_user');\n  assertEquals(del.error, null);\n  const [r] = await sql`select (select count(*) from companion_action_receipts where user_id = ${a.id})::int receipts,\n                               (select count(*) from companion_proposals where user_id = ${a.id})::int proposals`;\n  assertEquals([r.receipts, r.proposals], [0, 0]);\n}});\n\nDeno.test({ name: 'cleanup', ...testOpts, fn: async () => { await sql.end(); } });\n","usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/steps_context_race_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/steps_parent_race_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/steps_rollback_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/steps_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/support.ts","messages":[{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":85,"column":9,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":85,"endColumn":12,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5082,5085],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5082,5085],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":101,"column":13,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":101,"endColumn":16,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[5651,5654],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[5651,5654],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":387,"column":87,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":387,"endColumn":90,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20001,20004],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20001,20004],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]},{"ruleId":"@typescript-eslint/no-explicit-any","severity":2,"message":"Unexpected any. Specify a different type.","line":390,"column":32,"nodeType":"TSAnyKeyword","messageId":"unexpectedAny","endLine":390,"endColumn":35,"suggestions":[{"messageId":"suggestUnknown","fix":{"range":[20185,20188],"text":"unknown"},"desc":"Use `unknown` instead, this will force you to explicitly, and safely assert the type is correct."},{"messageId":"suggestNever","fix":{"range":[20185,20188],"text":"never"},"desc":"Use `never` instead, this is useful when instantiating generic type parameters that you don't need to know the type of."}]}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// Test support for the Companion task actions endpoint (mobile-app#361).\n// Talks to the local stack started by run.sh only. Every behavioral assertion in\n// the tests goes through the public HTTP boundary or the legacy client path\n// (PostgREST with the user's JWT). Direct SQL is used for fixtures, lock holding,\n// gate edits, migration up/down and row counts that no public path exposes.\nimport { createClient, type SupabaseClient } from 'npm:@supabase/supabase-js@2';\nimport postgres from 'npm:postgres@3';\n\nconst env = (k: string) => {\n  const v = Deno.env.get(`ACTIONS_${k}`);\n  if (!v) throw new Error(`ACTIONS_${k} missing: run via ./run.sh`);\n  return v;\n};\n\nexport const API_URL = env('API_URL');\nexport const ANON_KEY = env('ANON_KEY');\nexport const SERVICE_ROLE_KEY = env('SERVICE_ROLE_KEY');\nexport const DB_URL = env('DB_URL');\nif (!/^http:\\/\\/127\\.0\\.0\\.1:/.test(API_URL) || !/@127\\.0\\.0\\.1:/.test(DB_URL)) {\n  throw new Error('refusing to run against a non-local stack');\n}\n\n// ACTIONS_MIGRATION_FILE / ACTIONS_ROLLBACK_FILE (#361) and ACTIONS_MIGRATION_363_FILE /\n// ACTIONS_ROLLBACK_363_FILE (#363) substitute a deliberately broken copy (mutation_check.py).\nconst override = (k: string) => Deno.env.get(k) ? new URL(`file://${Deno.env.get(k)}`) : undefined;\nexport const MIGRATION = override('ACTIONS_MIGRATION_FILE') ??\n  new URL('../../migrations/20261025235536_companion_task_actions.sql', import.meta.url);\nexport const ROLLBACK = override('ACTIONS_ROLLBACK_FILE') ??\n  new URL('../../rollbacks/20261025235536_companion_task_actions.down.sql', import.meta.url);\nexport const MIGRATION_363 = override('ACTIONS_MIGRATION_363_FILE') ??\n  new URL('../../migrations/20261026165156_companion_task_create.sql', import.meta.url);\nexport const ROLLBACK_363 = override('ACTIONS_ROLLBACK_363_FILE') ??\n  new URL('../../rollbacks/20261026165156_companion_task_create.down.sql', import.meta.url);\n// #364 settlement plans; ACTIONS_MIGRATION_364_FILE / ACTIONS_ROLLBACK_364_FILE likewise.\nexport const MIGRATION_364 = override('ACTIONS_MIGRATION_364_FILE') ??\n  new URL('../../migrations/20261027183338_companion_settlement_plan.sql', import.meta.url);\nexport const ROLLBACK_364 = override('ACTIONS_ROLLBACK_364_FILE') ??\n  new URL('../../rollbacks/20261027183338_companion_settlement_plan.down.sql', import.meta.url);\n// #366 task steps (ACTIONS_MIGRATION_366_FILE / ACTIONS_ROLLBACK_366_FILE for mutation runs).\nexport const MIGRATION_366 = override('ACTIONS_MIGRATION_366_FILE') ??\n  new URL('../../migrations/20261027183644_companion_task_steps.sql', import.meta.url);\nexport const ROLLBACK_366 = override('ACTIONS_ROLLBACK_366_FILE') ??\n  new URL('../../rollbacks/20261027183644_companion_task_steps.down.sql', import.meta.url);\n// #365 task edits: ACTIONS_MIGRATION_365_FILE / ACTIONS_ROLLBACK_365_FILE likewise.\nexport const MIGRATION_365 = override('ACTIONS_MIGRATION_365_FILE') ??\n  new URL('../../migrations/20261028001530_companion_task_edit.sql', import.meta.url);\nexport const ROLLBACK_365 = override('ACTIONS_ROLLBACK_365_FILE') ??\n  new URL('../../rollbacks/20261028001530_companion_task_edit.down.sql', import.meta.url);\n// #370 saved personal details (ACTIONS_MIGRATION_370_FILE / ACTIONS_ROLLBACK_370_FILE for mutation runs).\nexport const MIGRATION_370 = override('ACTIONS_MIGRATION_370_FILE') ??\n  new URL('../../migrations/20261028004902_companion_saved_details.sql', import.meta.url);\nexport const ROLLBACK_370 = override('ACTIONS_ROLLBACK_370_FILE') ??\n  new URL('../../rollbacks/20261028004902_companion_saved_details.down.sql', import.meta.url);\n// #367 task removal (ACTIONS_MIGRATION_367_FILE / ACTIONS_ROLLBACK_367_FILE for mutation runs).\nexport const MIGRATION_367 = override('ACTIONS_MIGRATION_367_FILE') ??\n  new URL('../../migrations/20261028025026_companion_task_remove.sql', import.meta.url);\nexport const ROLLBACK_367 = override('ACTIONS_ROLLBACK_367_FILE') ??\n  new URL('../../rollbacks/20261028025026_companion_task_remove.down.sql', import.meta.url);\n\nexport const admin = createClient(API_URL, SERVICE_ROLE_KEY, { auth: { persistSession: false } });\nexport const sql = postgres(DB_URL, { max: 20, onnotice: () => {} });\n\nexport interface Account {\n  id: string;\n  email: string;\n  jwt: string;\n  client: SupabaseClient;\n}\n\nlet counter = 0;\n/** A synthetic account, created through the admin API and signed in with a password. */\nexport async function newAccount(label: string): Promise<Account> {\n  const email = `${label}-${Date.now()}-${counter++}@actions361.invalid`;\n  const password = 'actions-password-1';\n  const created = await admin.auth.admin.createUser({ email, password, email_confirm: true });\n  if (created.error) throw created.error;\n  const client = createClient(API_URL, ANON_KEY, { auth: { persistSession: false } });\n  const signedIn = await client.auth.signInWithPassword({ email, password });\n  if (signedIn.error || !signedIn.data.session) throw signedIn.error;\n  return { id: created.data.user.id, email, jwt: signedIn.data.session.access_token, client };\n}\n\nexport interface Reply {\n  status: number;\n  json: any;\n  headers: Headers;\n}\n\n/** The public request boundary: POST /functions/v1/companion-actions. */\nexport async function call(who: Account | null, body: unknown, bearer?: string): Promise<Reply> {\n  const res = await fetch(`${API_URL}/functions/v1/companion-actions`, {\n    method: 'POST',\n    headers: {\n      'content-type': 'application/json',\n      apikey: ANON_KEY,\n      authorization: `Bearer ${bearer ?? (who ? who.jwt : ANON_KEY)}`,\n    },\n    body: typeof body === 'string' ? body : JSON.stringify(body),\n  });\n  const text = await res.text();\n  let json: any = text;\n  try {\n    json = JSON.parse(text);\n  } catch { /* keep text */ }\n  return { status: res.status, json, headers: res.headers };\n}\n\nexport const uuid = () => crypto.randomUUID();\nexport const sleep = (ms: number) => new Promise<void>(r => setTimeout(r, ms));\n\nexport async function migrationApplied(): Promise<boolean> {\n  const [r] = await sql`select to_regclass('public.companion_action_receipts') is not null as applied`;\n  return r.applied;\n}\n\n/**\n * The full schema change: 'up' applies the production migrations in timestamp order\n * (#361, #363, #364, #366, #365, #367), each in one transaction; 'down' runs the rollback\n * scripts in reverse order.\n */\nexport async function migrate(which: 'up' | 'down'): Promise<void> {\n  if (which === 'up') {\n    await sql.begin(async tx => await tx.unsafe(await Deno.readTextFile(MIGRATION)));\n    await migrate363('up');\n    await migrate364('up');\n    await migrate366('up');\n    await migrate365('up');\n    await migrate370('up');\n    await migrate367('up');\n  } else {\n    if (await migration367Applied()) await migrate367('down');\n    if (await migration370Applied()) await migrate370('down');\n    if (await migration365Applied()) await migrate365('down');\n    if (await migration366Applied()) await migrate366('down');\n    if (await migration363Applied()) await migrate363('down');\n    await sql.begin(async tx => await tx.unsafe(await Deno.readTextFile(ROLLBACK)));\n    await waitForSchemaCache('down');\n  }\n}\n\n/**\n * Only the #363 migration or only its rollback script, in one transaction. Newer schema\n * on top (#365, then #364) is rolled back first, as the operator order requires.\n */\nexport async function migrate363(which: 'up' | 'down'): Promise<void> {\n  if (which === 'down' && await migration365Applied()) await migrate365('down');\n  if (which === 'down' && await migration364Applied()) await migrate364('down');\n  const text = await Deno.readTextFile(which === 'up' ? MIGRATION_363 : ROLLBACK_363);\n  await sql.begin(async tx => await tx.unsafe(text));\n  // Wait for what the file actually defines (a red run may use an empty placeholder).\n  await waitForSchemaCache(which === 'up' && text.includes('companion_prepare_proposal') ? 'up' : 'up361');\n}\n\n/**\n * Only the #364 migration or only its rollback script, in one transaction. The #365\n * rollback runs first when #365 is applied (it is the newest migration).\n */\nexport async function migrate364(which: 'up' | 'down'): Promise<void> {\n  if (which === 'down' && await migration365Applied()) await migrate365('down');\n  const text = await Deno.readTextFile(which === 'up' ? MIGRATION_364 : ROLLBACK_364);\n  await sql.begin(async tx => await tx.unsafe(text));\n  // Wait for what the file actually defines (a red run may use an empty placeholder).\n  // A down script that does not drop the plan functions (a red placeholder) leaves them.\n  const present = which === 'up' ? text.includes('companion_plan_prepare') : !text.includes('companion_plan_prepare');\n  await waitForSchemaCache(present && await migration364Applied() ? 'up364' : 'up');\n}\n\nexport async function migration364Applied(): Promise<boolean> {\n  const [r] = await sql`select to_regclass('public.companion_plan_proposals') is not null as applied`;\n  return r.applied;\n}\n\n/**\n * Only the #366 migration or only its rollback script, in one transaction. The #365\n * rollback (and before it #367) runs first when applied (rollback order: #367, #365,\n * #366, #364, #363, #361).\n */\nexport async function migrate366(which: 'up' | 'down'): Promise<void> {\n  if (which === 'down' && await migration365Applied()) await migrate365('down');\n  const text = await Deno.readTextFile(which === 'up' ? MIGRATION_366 : ROLLBACK_366);\n  await sql.begin(async tx => await tx.unsafe(text));\n  // After rollback, the step RPC must be absent and any #364 schema below must stay.\n  await waitForSchemaCache(\n    which === 'up' && text.includes('companion_read_steps') ? 'up366'\n      : await migration364Applied() ? 'down366WithPlans' : 'down366',\n  );\n}\n\n/**\n * Only the #365 migration or only its rollback script, in one transaction. The #370\n * rollback runs first when #370 is applied (it is the newest migration).\n */\nexport async function migrate365(which: 'up' | 'down'): Promise<void> {\n  if (which === 'down' && await migration370Applied()) await migrate370('down');\n  const text = await Deno.readTextFile(which === 'up' ? MIGRATION_365 : ROLLBACK_365);\n  await sql.begin(async tx => await tx.unsafe(text));\n  // Wait for what the file actually defines (a red run may use an empty placeholder).\n  const defines = text.includes('companion_prepare_edit');\n  await waitForSchemaCache(which === 'up' ? (defines ? 'up365' : 'up366') : (defines ? 'up366' : 'up365'));\n}\n\nexport async function migration365Applied(): Promise<boolean> {\n  const [r] = await sql`select to_regprocedure('public.companion_prepare_edit(uuid,jsonb,jsonb,text)') is not null as applied`;\n  return r.applied;\n}\n\n/** Only the #370 migration or only its rollback script, in one transaction. */\nexport async function migrate370(which: 'up' | 'down'): Promise<void> {\n  if (which === 'down' && await migration367Applied()) await migrate367('down');\n  const text = await Deno.readTextFile(which === 'up' ? MIGRATION_370 : ROLLBACK_370);\n  await sql.begin(async tx => await tx.unsafe(text));\n  // #370 builds on #365: its rollback returns to the #365 schema.\n  await waitForSchemaCache(which === 'up' && text.includes('companion_read_details') ? 'up370' : 'up365');\n}\n\nexport async function migration370Applied(): Promise<boolean> {\n  const [r] = await sql`select to_regprocedure('public.companion_read_details(uuid)') is not null as applied`;\n  return r.applied;\n}\n\n/**\n * Only the #367 migration or only its rollback script, in one transaction. It replaces\n * shared function bodies and adds no RPC name, so PostgREST needs no schema reload.\n * It is applied after #365 (timestamp order): an older schema gets #365 first.\n */\nexport async function migrate367(which: 'up' | 'down'): Promise<void> {\n  if (which === 'up' && !(await migration365Applied())) await migrate365('up');\n  if (which === 'up' && !(await migration370Applied())) await migrate370('up');\n  await sql.begin(async tx => await tx.unsafe(await Deno.readTextFile(which === 'up' ? MIGRATION_367 : ROLLBACK_367)));\n}\n\n/** The #367 marker: the removal-effects reader exists. */\nexport async function migration367Applied(): Promise<boolean> {\n  const [r] = await sql`select to_regprocedure('public.companion_remove_effects(uuid,text)') is not null as applied`;\n  return r.applied;\n}\n\nexport async function migration366Applied(): Promise<boolean> {\n  const [r] = await sql`select to_regprocedure('public.companion_read_steps(uuid)') is not null as applied`;\n  return r.applied;\n}\n\nexport async function migration363Applied(): Promise<boolean> {\n  const [r] = await sql`select to_regprocedure('public.companion_prepare_proposal(uuid,jsonb,jsonb)') is not null as applied`;\n  return r.applied;\n}\n\n/** PostgREST reloads its schema cache asynchronously after DDL; wait until it agrees. */\nexport async function waitForSchemaCache(which: 'up' | 'up364' | 'up361' | 'up366' | 'up365' | 'up370' | 'down366' | 'down366WithPlans' | 'down', timeoutMs = 15000): Promise<void> {\n  const deadline = Date.now() + timeoutMs;\n  while (Date.now() < deadline) {\n    const res = await fetch(`${API_URL}/rest/v1/`, {\n      headers: { apikey: SERVICE_ROLE_KEY, authorization: `Bearer ${SERVICE_ROLE_KEY}`, accept: 'application/openapi+json' },\n    });\n    const paths = Object.keys((await res.json()).paths ?? {});\n    const seen = paths.includes('/companion_feature_gate') && paths.includes('/rpc/companion_apply_actions');\n    const seen363 = paths.includes('/rpc/companion_prepare_proposal');\n    const seen364 = paths.includes('/rpc/companion_plan_prepare');\n    const seen365 = paths.includes('/rpc/companion_prepare_edit');\n    const seen366 = paths.includes('/rpc/companion_read_steps');\n    const seen370 = paths.includes('/rpc/companion_read_details') && paths.includes('/companion_saved_details');\n    if (which === 'up365' && seen && seen363 && seen366 && seen365 && !seen370) return;\n    if (which === 'up364' && seen && seen363 && seen364) return;\n    if (which === 'up' && seen && seen363 && !seen364 && !seen365) return;\n    if (which === 'up366' && seen && seen363 && seen366 && !seen365) return;\n    if ((which === 'down366' || which === 'down366WithPlans') && seen && seen363 && !seen366\n      && !seen365 && seen364 === (which === 'down366WithPlans')) return;\n    if (which === 'up370' && seen && seen363 && seen366 && seen365 && seen370) return;\n    if (which === 'up361' && seen && !seen363) return;\n    if (which === 'down' && !paths.some(p => p.includes('companion_') && !p.includes('rollback_archive'))) return;\n    await sleep(100);\n  }\n  throw new Error(`PostgREST schema cache did not reflect '${which}' within ${timeoutMs}ms`);\n}\n\n/** Turns the feature on (the migration ships it off). */\nexport async function openGate(patch: Record<string, unknown> = {}): Promise<void> {\n  await sql`update public.companion_feature_gate set enabled = true, min_contract_version = 1,\n    max_contract_version = 1, allowed_platforms = '{ios,android,web}'`;\n  if (Object.keys(patch).length) await sql`update public.companion_feature_gate set ${sql(patch)}`;\n}\n\n/** Brings the stack to \"migration applied, feature on\". */\nexport async function ready(): Promise<void> {\n  if (!(await migrationApplied())) await migrate('up');\n  else {\n    if (!(await migration363Applied())) await migrate363('up');\n    if (!(await migration364Applied())) await migrate364('up');\n    if (!(await migration366Applied())) await migrate366('up');\n    if (!(await migration365Applied())) await migrate365('up');\n    if (!(await migration370Applied())) await migrate370('up');\n    if (!(await migration367Applied())) await migrate367('up');\n  }\n  await openGate();\n}\n\nexport type Platform = 'ios' | 'android' | 'web';\nconst base = (platform: Platform = 'ios') => ({ contract_version: 1, client: { platform, app_version: '9.9.9' } });\n\nexport const read = (who: Account, platform?: Platform) => call(who, { ...base(platform), action: 'read' });\nexport const status = (who: Account, operation_id: string) =>\n  call(who, { ...base(), action: 'status', operation_id });\nexport const apply = (\n  who: Account | null,\n  operations: unknown[],\n  opts: { operation_id?: string; authorization?: unknown; platform?: Platform } = {},\n) =>\n  call(who, {\n    ...base(opts.platform),\n    action: 'apply',\n    operation_id: opts.operation_id ?? uuid(),\n    authorization: 'authorization' in opts ? opts.authorization : { kind: 'ui_control' },\n    operations,\n  });\nexport const undo = (\n  who: Account,\n  receipt_operation_id: string,\n  opts: { operation_id?: string; authorization?: unknown; platform?: Platform } = {},\n) =>\n  call(who, {\n    ...base(opts.platform),\n    action: 'undo',\n    operation_id: opts.operation_id ?? uuid(),\n    receipt_operation_id,\n    authorization: 'authorization' in opts ? opts.authorization : { kind: 'ui_control' },\n  });\n\nexport const prepare = (who: Account | null, operation: unknown, extra: Record<string, unknown> = {}, platform?: Platform) =>\n  call(who, { ...base(platform), action: 'prepare', operation, ...extra });\nexport const proposalOf = (who: Account, proposal_id: string) =>\n  call(who, { ...base(), action: 'proposal', proposal_id });\nexport const revise = (who: Account, proposal_id: string, proposal_revision: number, operation: unknown) =>\n  call(who, { ...base(), action: 'revise', proposal_id, proposal_revision, operation });\nexport const cancel = (who: Account, proposal_id: string, proposal_revision: number) =>\n  call(who, { ...base(), action: 'cancel', proposal_id, proposal_revision });\nexport const interpret = (who: Account, message_id: unknown) =>\n  call(who, { ...base(), action: 'interpret', message_id });\nexport const conversationActions = (who: Account, conversation_id: string) =>\n  call(who, { ...base(), action: 'conversation_actions', conversation_id });\n\nexport const createTask = (title: string, priority = 'Do soon') => ({ type: 'task.create_custom', title, priority });\n\n/** Approval evidence for a prepared proposal at the revision the user saw. */\nexport const approved = (p: { proposal_id: string; proposal_revision: number }) => ({\n  kind: 'approved_proposal',\n  proposal_id: p.proposal_id,\n  proposal_revision: p.proposal_revision,\n});\n\n/** The caller's live custom tasks, as today's Checklist reads them (user JWT, RLS). */\nexport async function checklistTitles(who: Account): Promise<string[]> {\n  const r = await who.client.from('custom_checklist_tasks').select('title').order('id');\n  if (r.error) throw r.error;\n  return (r.data ?? []).map(row => row.title as string);\n}\n\n/** A Companion conversation of `who` and one message in it, saved the way the clients do. */\nexport async function conversationWith(who: Account, role: 'user' | 'assistant', content: string) {\n  const c = await who.client.from('conversations').insert({ user_id: who.id, title: 't' })\n    .select('id, conversation_identifier').single();\n  if (c.error) throw c.error;\n  const message_id = await messageIn(who, c.data.id, role, content);\n  return { conversation_id: c.data.conversation_identifier as string, conversationRow: c.data.id as number, message_id };\n}\n\nexport async function messageIn(who: Account, conversationRow: number, role: 'user' | 'assistant', content: string): Promise<number> {\n  const m = await who.client.from('messages').insert({ conversation_id: conversationRow, role, content })\n    .select('id').single();\n  if (m.error) throw m.error;\n  return m.data.id as number;\n}\n\n/** The onboarding profile row, written the way the clients do (user JWT). */\nexport async function setProfile(who: Account, fields: Record<string, unknown>): Promise<void> {\n  const r = await who.client.from('user_onboarding_profiles').upsert({ id: who.id, ...fields });\n  if (r.error) throw r.error;\n}\n\nexport const setState = (task_ref: string, state: string, expected_revision: number, waiting_reason?: string) => ({\n  type: 'task.set_state',\n  task_ref,\n  state,\n  expected_revision,\n  ...(waiting_reason === undefined ? {} : { waiting_reason }),\n});\n\nexport async function taskOf(who: Account, ref: string, platform?: Platform): Promise<any | undefined> {\n  const r = await read(who, platform);\n  if (r.status !== 200) throw new Error(`read failed: ${r.status} ${JSON.stringify(r.json)}`);\n  return r.json.tasks.find((t: any) => t.task_ref === ref);\n}\n\n/** An existing custom task, created the way today's Checklist does (direct table insert). */\nexport async function existingCustomTask(who: Account, title = 'Get a phone plan'): Promise<{ ref: string; id: number }> {\n  const r = await who.client.from('custom_checklist_tasks')\n    .insert({ user_id: who.id, title, description: '', priority: 'Do soon' })\n    .select('id').single();\n  if (r.error) throw r.error;\n  return { ref: `custom:${r.data.id}`, id: r.data.id };\n}\n\n/** An existing content-backed task row, written the way today's Checklist does. */\nexport async function existingSanityTask(who: Account, sanityId: string, completed = false): Promise<string> {\n  const r = await who.client.from('user_tasks')\n    .upsert({ user_id: who.id, sanity_checklist_id: sanityId, completed, completed_at: completed ? new Date().toISOString() : null },\n      { onConflict: 'user_id,sanity_checklist_id' });\n  if (r.error) throw r.error;\n  return `sanity:${sanityId}`;\n}\n\n/** Waits until `n` other backends are blocked on a lock inside an action function. */\nexport async function waitForBlocked(n: number, pattern = '%companion_%', timeoutMs = 4000): Promise<number> {\n  const deadline = Date.now() + timeoutMs;\n  let count = 0;\n  while (Date.now() < deadline) {\n    const [r] = await sql`select count(*)::int n from pg_stat_activity\n      where pid <> pg_backend_pid() and wait_event_type = 'Lock' and query ilike ${pattern}`;\n    count = r.n;\n    if (count >= n) return count;\n    await sleep(50);\n  }\n  return count;\n}\n\n/** Holds the operation lock of (user, operation) from a separate connection until release(). */\nexport function holdOperationLock(userId: string, operationId: string): { ready: Promise<void>; release: () => Promise<void> } {\n  let release!: () => void;\n  const held = new Promise<void>(r => (release = r));\n  let markReady!: () => void;\n  const readyP = new Promise<void>(r => (markReady = r));\n  const tx = sql.begin(async t => {\n    await t`select pg_advisory_xact_lock(public.companion_op_lock_key(${userId}::uuid, ${operationId}::uuid))`;\n    markReady();\n    await held;\n  });\n  return { ready: readyP, release: async () => { release(); await tx; } };\n}\n\n/** Holds a task row lock from a separate connection until release(). */\nexport function holdTaskRow(table: 'user_tasks' | 'custom_checklist_tasks', where: { column: string; value: string | number }) {\n  let release!: () => void;\n  const held = new Promise<void>(r => (release = r));\n  let markReady!: () => void;\n  const readyP = new Promise<void>(r => (markReady = r));\n  const tx = sql.begin(async t => {\n    await t`select 1 from ${t('public.' + table)} where ${t(where.column)} = ${String(where.value)} for update`;\n    markReady();\n    await held;\n  });\n  return { ready: readyP, release: async () => { release(); await tx; } };\n}\n\nexport const testOpts = { sanitizeOps: false, sanitizeResources: false };\n\n// ------------------------------------------------------------ settlement plans (#364)\nexport const existingItem = (task_ref: string, label?: string) =>\n  ({ kind: 'existing', task_ref, ...(label === undefined ? {} : { label }) });\nexport const newItem = (title: string, extra: Record<string, unknown> = {}) => ({ kind: 'new', title, ...extra });\n\nexport const planPrepare = (who: Account | null, goal: string, items: unknown[], extra: Record<string, unknown> = {}, platform?: Platform) =>\n  call(who, { ...base(platform), action: 'plan_prepare', goal, items, ...extra });\nexport const planProposal = (who: Account, plan_proposal_id: string, platform?: Platform) =>\n  call(who, { ...base(platform), action: 'plan_proposal', plan_proposal_id });\nexport const planRevise = (who: Account, plan_proposal_id: string, proposal_revision: number, items: unknown[]) =>\n  call(who, { ...base(), action: 'plan_revise', plan_proposal_id, proposal_revision, items });\nexport const planCancel = (who: Account, plan_proposal_id: string, proposal_revision: number) =>\n  call(who, { ...base(), action: 'plan_cancel', plan_proposal_id, proposal_revision });\n/** Approval of a plan draft at the revision and exact items the user saw. */\nexport const planApply = (\n  who: Account | null,\n  draft: { plan_proposal_id: string; proposal_revision: number; items: unknown[] },\n  opts: { operation_id?: string; authorization?: unknown; items?: unknown[]; platform?: Platform } = {},\n) =>\n  call(who, {\n    ...base(opts.platform),\n    action: 'plan_apply',\n    operation_id: opts.operation_id ?? uuid(),\n    authorization: 'authorization' in opts ? opts.authorization : {\n      kind: 'approved_proposal', proposal_id: draft.plan_proposal_id, proposal_revision: draft.proposal_revision,\n    },\n    items: opts.items ?? draft.items,\n  });\nexport const planStatus = (who: Account, operation_id: string) =>\n  call(who, { ...base(), action: 'plan_status', operation_id });\nexport const planRetry = (who: Account, receipt_operation_id: string, opts: { operation_id?: string } = {}) =>\n  call(who, { ...base(), action: 'plan_retry', operation_id: opts.operation_id ?? uuid(), receipt_operation_id,\n    authorization: { kind: 'ui_control' } });\nexport const planUndo = (who: Account, receipt_operation_id: string, opts: { operation_id?: string; authorization?: unknown } = {}) =>\n  call(who, { ...base(), action: 'plan_undo', operation_id: opts.operation_id ?? uuid(), receipt_operation_id,\n    authorization: 'authorization' in opts ? opts.authorization : { kind: 'ui_control', removal_confirmed: true } });\nexport const plansOf = (who: Account, platform?: Platform) => call(who, { ...base(platform), action: 'plans' });\nexport const conversationPlans = (who: Account, conversation_id: string) =>\n  call(who, { ...base(), action: 'conversation_plans', conversation_id });\n\n/** Every custom task row of an account, removed ones included (no public read shows those). */\nexport async function customRows(userId: string): Promise<{ id: number; title: string; removed: boolean }[]> {\n  const rows = await sql`select id::int, title, removed_at is not null as removed from custom_checklist_tasks\n    where user_id = ${userId} order by id`;\n  return rows.map(r => ({ id: r.id as number, title: r.title as string, removed: r.removed as boolean }));\n}\n\n// ------------------------------------------------------------------ #366 task steps\nexport const stepCreate = (task_ref: string, titles: string[]) => ({ type: 'step.create', task_ref, titles });\nexport const stepUpdate = (step_id: string, title: string, expected_revision: number) =>\n  ({ type: 'step.update', step_id, title, expected_revision });\nexport const stepDone = (step_id: string, done: boolean, expected_revision: number) =>\n  ({ type: 'step.set_done', step_id, done, expected_revision });\nexport const stepRemove = (step_id: string, expected_revision: number) => ({ type: 'step.remove', step_id, expected_revision });\nexport const confirmedRemoval = { kind: 'ui_control', removal_confirmed: true };\n\nexport interface LiveStep {\n  step_id: string;\n  task_ref: string;\n  title: string;\n  done: boolean;\n  position: number;\n  revision: number;\n}\n\ninterface StoredStep {\n  id: string;\n  task_ref: string;\n  title: string;\n  completed: boolean;\n  removed: boolean;\n  revision: string;\n}\n\n/** The caller's live steps of one task, as the read action returns them, in order. */\nexport async function stepsOf(who: Account, ref: string, platform?: Platform): Promise<LiveStep[]> {\n  const r = await read(who, platform);\n  if (r.status !== 200) throw new Error(`read failed: ${r.status} ${JSON.stringify(r.json)}`);\n  if (!Array.isArray(r.json.steps)) throw new Error(`read returned no steps: ${JSON.stringify(r.json)}`);\n  return r.json.steps.filter((s: { task_ref: string }) => s.task_ref === ref);\n}\n\n/** Every step row of an account, removed ones included (no public path exposes those). */\nexport async function stepRows(userId: string): Promise<StoredStep[]> {\n  return [...await sql<StoredStep[]>`select id::text, task_ref, title, completed, removed_at is not null as removed, revision\n    from companion_task_steps where user_id = ${userId} order by position, created_at`];\n}\n\n/**\n * Stand-in for the published Checklist content read of the action service. The edge\n * runtime asks it whether a content-backed task exists (run.sh points\n * COMPANION_CONTENT_QUERY_URL here). `published` lists the existing document ids; `fail`\n * makes it answer 503. Counts every request.\n */\nexport const contentStub = { published: new Set<string>(['sin-number', 'bank-account']), fail: false, requests: 0 };\nlet contentServer: Deno.HttpServer | null = null;\nexport function startContentStub(): void {\n  if (contentServer) return;\n  const port = Number(Deno.env.get('ACTIONS_CONTENT_PORT') ?? '60675');\n  contentServer = Deno.serve({ hostname: '127.0.0.1', port, onListen: () => {} }, req => {\n    contentStub.requests++;\n    if (contentStub.fail) return new Response('unavailable', { status: 503 });\n    const url = new URL(req.url);\n    let id: unknown = null;\n    try {\n      id = JSON.parse(url.searchParams.get('$id') ?? 'null');\n    } catch { /* not a JSON parameter */ }\n    const found = typeof id === 'string' && contentStub.published.has(id) ? id : null;\n    return Response.json({ result: found });\n  });\n}\n\n// ------------------------------------------------------------------ #370 saved details\nexport const detailCreate = (text: string) => ({ type: 'detail.create', text });\nexport const detailUpdate = (detail_id: string, text: string, expected_revision: number) =>\n  ({ type: 'detail.update', detail_id, text, expected_revision });\nexport const detailRemove = (detail_id: string, expected_revision: number) =>\n  ({ type: 'detail.remove', detail_id, expected_revision });\nexport const command = (message_id: number) => ({ kind: 'direct_command', message_id });\n\n/** The caller's live saved details, as the read action returns them. */\nexport async function detailsOf(who: Account, platform?: Platform): Promise<Record<string, unknown>[]> {\n  const r = await read(who, platform);\n  if (r.status !== 200) throw new Error(`read failed: ${r.status} ${JSON.stringify(r.json)}`);\n  if (!Array.isArray(r.json.details)) throw new Error(`read returned no details: ${JSON.stringify(r.json)}`);\n  return r.json.details;\n}\n\n/** What a later Companion answer reads (rag-query reads with the user's own JWT and RLS). */\nexport async function contextDetails(who: Account): Promise<string[]> {\n  const r = await who.client.from('companion_saved_details').select('body').order('created_at');\n  if (r.error) throw r.error;\n  return (r.data ?? []).map(row => row.body as string);\n}\n\n/** Every detail row of an account, removed ones included (no public path exposes those). */\nexport async function detailRows(userId: string): Promise<Record<string, unknown>[]> {\n  return [...await sql`select id::text, body, revision::int as revision, removed_at is not null as removed, source\n    from companion_saved_details where user_id = ${userId} order by created_at`];\n}\n\n/** A user message that says one thing, saved the way the clients do; returns its ids. */\nexport async function said(who: Account, content: string) {\n  return await conversationWith(who, 'user', content);\n}\n\n/** Saves a detail through the user's own clear command and returns the receipt. */\nexport async function rememberedBy(who: Account, text: string) {\n  const m = await said(who, `Remember that ${text}`);\n  const w = await apply(who, [detailCreate(text)], { authorization: command(m.message_id) });\n  if (w.status !== 200) throw new Error(`remember failed: ${w.status} ${JSON.stringify(w.json)}`);\n  return { ...m, receipt: w.json.receipt, operation_id: w.json.operation_id as string };\n}\n\n// ------------------------------------------------------------------ #367 task removal\nexport const taskRemove = (task_ref: string, expected_revision: number) => ({ type: 'task.remove', task_ref, expected_revision });\n\n/** Approval evidence of a reviewed removal, with the user's confirmation. */\nexport const confirmedApproval = (p: { proposal_id: string; proposal_revision: number }) => ({\n  ...approved(p), removal_confirmed: true,\n});\n\n/** A pending reminder row (no reminder schedule exists in this slice; fixture only). */\nexport async function pendingReminder(userId: string, task_ref: string): Promise<string> {\n  const [r] = await sql`insert into companion_task_reminders (user_id, task_ref, remind_at, time_zone)\n    values (${userId}, ${task_ref}, now() + interval '2 days', 'America/Vancouver') returning id::text`;\n  return r.id as string;\n}\n\nexport async function reminderRow(id: string): Promise<{ status: string; cancelled_reason: string | null }> {\n  const [r] = await sql`select status, cancelled_reason from companion_task_reminders where id = ${id}::uuid`;\n  return { status: r.status as string, cancelled_reason: (r.cancelled_reason ?? null) as string | null };\n}\n\n/** Holds the parent lock (#366) of one task of one account from another connection. */\nexport function holdParentLock(userId: string, task_ref: string): { ready: Promise<void>; release: () => Promise<void> } {\n  let release!: () => void;\n  const held = new Promise<void>(r => (release = r));\n  let markReady!: () => void;\n  const readyP = new Promise<void>(r => (markReady = r));\n  const tx = sql.begin(async t => {\n    await t`select pg_advisory_xact_lock(hashtextextended(${userId + ':' + task_ref}, 366))`;\n    markReady();\n    await held;\n  });\n  return { ready: readyP, release: async () => { release(); await tx; } };\n}\n","usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/supabase/tests/companion-actions/undo_test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/private/tmp/unify-review-actions-361-web-r5-deno-base-9d05/types/coverLetter.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/pri