const CARD =
  "mt-2 flex items-center gap-3 rounded-xl border border-border-card bg-surface px-3 py-2.5";

function CardIcon() {
  return (
    <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-bg">
      <ListChecks className="h-4 w-4 text-ink-secondary" aria-hidden />
    </span>
  );
}

function CardButton({
  label,
  name,
  onClick,
  disabled = false,
}: {
  label: string;
  name: string;
  onClick: () => void;
  disabled?: boolean;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      aria-label={name}
      aria-disabled={disabled}
      className={cn(
        disabled && "cursor-not-allowed opacity-60",
        "press inline-flex min-h-11 shrink-0 cursor-pointer items-center rounded-lg border border-border-card px-3 text-sm font-semibold text-ink-secondary hover:bg-surface-gray focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary",
      )}
    >
      {label}
    </button>
  );
}

/**
 * #367: a removal request in the user's own message. It only opened a review; the card
 * says nothing is removed until the user confirms in the drawer. A task removed
 * elsewhere turns the card historical, with no control that could act on it.
 */
function RemovalCard({
  proposal,
  store,
  title,
  removedNow,
  onReview,
}: {
  proposal: RemovalProposal;
  store: TaskActionStore | null;
  title: string | null;
  removedNow: boolean;
  onReview: () => void;
}) {
  const { t } = useTranslation();
  const phase = useTaskActionPhase(store, proposal.operation.task_ref);
  const saved =
    phase.phase === "saved" && phase.receipt.operationType === "task.remove"
      ? phase.receipt
      : proposal.receipt;
  const name = title ?? t("taskRemove.unknownTask");
  const open = proposal.status === "draft" && !saved && !removedNow;
  const status = saved
    ? t("taskRemove.cardRemoved")
    : removedNow
      ? t("taskActions.removed")
      : isUnresolved(phase)
        ? t("taskActions.checking")
        : t("taskRemove.cardDraft");
  return (
    <article
      data-testid="task-removal-card"
      aria-label={t("taskRemove.cardEyebrow")}
      className={cn(CARD, open && "border-dashed")}
    >
      <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-primary-bg">
        <Trash2 className="h-4 w-4 text-ink-secondary" aria-hidden />
      </span>
      <div className="min-w-0 flex-1">
        <p className="text-xs font-medium text-ink-muted">
          {t("taskRemove.cardEyebrow")}
        </p>
        <p className="break-words text-sm font-semibold text-ink-secondary">
          {name}
        </p>
        <p
          role="status"
          className={cn(
            "text-xs text-ink-tertiary",
            !saved && isTransient(phase) && "loading-delayed",
          )}
        >
          {status}
        </p>
      </div>
      {(open || saved) && (
        <CardButton
          label={open ? t("taskRemove.cardReview") : t("taskCreate.view")}
          name={
            open
              ? t("taskRemove.cardReviewA11y", { title: name })
              : t("taskCreate.view")
          }
          onClick={onReview}
        />
      )}
    </article>
  );
}

/** #366: suggested steps for one task. Says it is not saved; opens the drawer for review. */
function StepDraftCard({
  proposal,
  store,
  taskTitle,
  onReview,
}: {
  proposal: StepProposal;
  store: TaskActionStore | null;
  taskTitle: string | null;
  onReview: () => void;
}) {
  const { t } = useTranslation();
  const phase = useTaskActionPhase(store, `proposal:${proposal.proposalId}`);
  const saved = phase.phase === "saved" ? phase.receipt : proposal.receipt;
  const draft = proposal.status === "draft" && !saved;
  const task = taskTitle ?? t("taskSteps.cardTitleUnknownTask");
  const heading = taskTitle
    ? t("taskSteps.cardTitle", { task: taskTitle })
    : t("taskSteps.cardTitleUnknownTask");
  const status = saved
    ? t("taskSteps.added", { count: saved.steps?.length ?? 0 })
    : proposal.status === "cancelled"
      ? t("taskSteps.closed")
      : isUnresolved(phase)
        ? t("taskActions.checking")
        : t("taskSteps.draftBadge");
  return (
    <article
      data-testid="step-draft-card"
      aria-label={heading}
      className={cn(CARD, draft && "border-dashed")}
    >
      <CardIcon />
      <div className="min-w-0 flex-1">
        <p className="text-xs font-medium text-ink-muted">
          {t("taskSteps.cardEyebrow")}
        </p>
        <p className="break-words text-sm font-semibold text-ink-secondary">
          {heading}
        </p>
        {draft && (
          <p className="text-xs text-ink-tertiary">
            {t("taskSteps.cardCount", {
              count: proposal.operation.titles.length,
            })}
          </p>
        )}
        <p
          role="status"
          className={cn(
            "text-xs text-ink-tertiary",
            !saved && isTransient(phase) && "loading-delayed",
          )}
        >
          {status}
        </p>
      </div>
      <CardButton
        label={draft ? t("taskSteps.review") : t("taskSteps.view")}
        name={draft ? t("taskSteps.reviewA11y", { task }) : t("taskSteps.view")}
        onClick={onReview}
      />
    </article>
  );
}

function DraftCard({
  proposal,
  store,
  onReview,
}: {
  proposal: Extract<TaskProposal, { kind: "task_create" }>;
  store: TaskActionStore | null;
  onReview: () => void;
}) {
  const { t } = useTranslation();
  const phase = useTaskActionPhase(store, `proposal:${proposal.proposalId}`);
  const title = proposal.operation.title;
  const saved = phase.phase === "saved" ? phase.receipt : proposal.receipt;
  const status = saved
    ? t("taskCreate.added", { title: saved.title ?? title })
    : proposal.status === "cancelled"
      ? t("taskCreate.closed")
      : isUnresolved(phase)
        ? t("taskActions.checking")
        : t("taskCreate.draftBadge");
  return (
    <article
      aria-label={t("taskCreate.cardA11y", { title })}
      className={cn(
        CARD,
        proposal.status === "draft" && !saved && "border-dashed",
      )}
    >
      <CardIcon />
      <div className="min-w-0 flex-1">
        <p className="text-xs font-medium text-ink-muted">
          {t("taskCreate.cardEyebrow")}
        </p>
        <p className="break-words text-sm font-semibold text-ink-secondary">
          {title}
        </p>
        <p
          className={cn(
            "text-xs text-ink-tertiary",
            !saved && isTransient(phase) && "loading-delayed",
          )}
        >
          {status}
        </p>
      </div>
      {/* One control that keeps its place when the draft is saved, so focus can return to it. */}
      <CardButton
        label={
          saved || proposal.status !== "draft"
            ? t("taskCreate.view")
            : t("taskCreate.review")
        }
        name={
          saved || proposal.status !== "draft"
            ? t("taskCreate.view")
            : t("taskCreate.reviewA11y", { title })
        }
        onClick={onReview}
      />
    </article>
  );
}

/** A suggested change to an existing task (#365): what it changes, not yet saved. */
function EditDraftCard({
  proposal,
  store,
  title,
  onReview,
}: {
  proposal: Extract<TaskProposal, { kind: "task_edit" }>;
  store: TaskActionStore | null;
  title: string | null;
  onReview: () => void;
}) {
  const { t } = useTranslation();
  const phase = useTaskActionPhase(store, `proposal:${proposal.proposalId}`);
  const saved = phase.phase === "saved" ? phase.receipt : proposal.receipt;
  const draft = proposal.status === "draft" && !saved;
  const name = title ?? t("taskEdit.unknownTask");
  const summary = changeLines(t as never, proposal.operation, proposal.task)
    .map((line) => `${line.label}: ${line.to}`)
    .join(" · ");
  const status = saved
    ? t("taskEdit.saved")
    : proposal.status === "cancelled"
      ? t("taskEdit.closed")
      : isUnresolved(phase)
        ? t("taskActions.checking")
        : t("taskEdit.draftBadge");
  return (
    <article
      aria-label={`${t("taskEdit.cardEyebrow")}: ${name}`}
      className={cn(CARD, draft && "border-dashed")}
    >
      <CardIcon />
      <div className="min-w-0 flex-1">
        <p className="text-xs font-medium text-ink-muted">
          {t("taskEdit.cardEyebrow")}
        </p>
        <p className="break-words text-sm font-semibold text-ink-secondary">
          {name}
        </p>
        <p className="break-words text-xs text-ink-tertiary">{summary}</p>
        <p
          className={cn(
            "text-xs text-ink-tertiary",
            !saved && isTransient(phase) && "loading-delayed",
          )}
        >
          {status}
        </p>
      </div>
      <CardButton
        label={draft ? t("taskEdit.review") : t("taskEdit.view")}
        name={
          draft ? t("taskEdit.reviewA11y", { title: name }) : t("taskEdit.view")
        }
        onClick={onReview}
      />
    </article>
  );
}

/** #370: a detail the answer suggested saving. Says it is not saved; opens the review. */
function DetailDraftCard({
  proposal,
  store,
  onReview,
}: {
  proposal: DetailProposal;
  store: TaskActionStore | null;
  onReview: () => void;
}) {
  const { t } = useTranslation();
  const phase = useTaskActionPhase(store, `proposal:${proposal.proposalId}`);
  const saved = phase.phase === "saved" ? phase.receipt : proposal.receipt;
  const draft = proposal.status === "draft" && !saved;
  const text = proposal.operation.text;
  const status = saved
    ? detailReceiptText(t, saved)
    : proposal.status === "cancelled"
      ? t("savedDetails.notSaved")
      : isUnresolved(phase)
        ? t("taskActions.checking")
        : t("savedDetails.draftBadge");
  return (
    <article
      data-testid="detail-draft-card"
      aria-label={t("savedDetails.draftEyebrow")}
      className={cn(CARD, draft && "border-dashed")}
    >
      <CardIcon />
      <div className="min-w-0 flex-1">
        <p className="text-xs font-medium text-ink-muted">
          {t("savedDetails.draftEyebrow")}
        </p>
        <p className="break-words text-sm font-semibold text-ink-secondary">
          {text}
        </p>
        <p
          className={cn(
            "text-xs text-ink-tertiary",
            isTransient(phase) && "loading-delayed",
          )}
          role="status"
        >
          {status}
        </p>
      </div>
      <CardButton
        label={draft ? t("savedDetails.review") : t("taskCreate.view")}
        name={
          draft
            ? t("savedDetails.reviewA11y", { text })
            : t("savedDetails.view")
        }
        onClick={onReview}
      />
    </article>
  );
}

/** #370: the result of a remember command: the receipt's own text, its Undo, the details. */
function DetailCommandResult({
  receipt,
  storeKey,
  store,
  onViewDetails,
}: {
  receipt: TaskReceipt;
  storeKey: string;
  store: TaskActionStore | null;
  onViewDetails?: () => void;
}) {
  const { t } = useTranslation();
  const view = useTaskProgress();
  return (
    <article
      data-testid="detail-command-card"
      aria-label={t("savedDetails.entryTitle")}
      className={cn(CARD, "items-start")}
    >
      <CardIcon />
      <div className="min-w-0 flex-1">
        <DetailReceipt
          receipt={receipt}
          storeKey={storeKey}
          store={store}
          view={view}
        />
      </div>
      {onViewDetails && (
        <CardButton
          label={t("savedDetails.view")}
          name={t("savedDetails.view")}
          onClick={onViewDetails}
        />
      )}
    </article>
  );
}
function commandText(
  t: (k: string, o?: Record<string, unknown>) => string,
  phase: TaskActionPhase,
  titleFor: (taskRef: string) => string | null,
): string | null {
  switch (phase.phase) {
    case "saving":
    case "checking": {
      const op = phase.write.operation;
      if (op?.type === "detail.create")
        return t("savedDetails.commandSaving", { text: op.text });
      if (op && op.type !== "task.create_custom") {
        return t("taskEdit.commandSaving", {
          title:
            ("task_ref" in op ? titleFor(op.task_ref) : null) ??
            t("taskEdit.unknownTask"),
        });
      }
      return t("taskCreate.commandAdding", {
        title: op?.type === "task.create_custom" ? op.title : "",
      });
    }
    case "conflict":
      return t("taskEdit.commandConflict");
    case "pending":
      return t("taskActions.pending");
    case "lookup_failed":
      return t("taskActions.lookupFailed");
    case "not_applied":
      return t("taskActions.notApplied");
    case "command_used":
      return t("taskCreate.commandUsed");
    case "needs_clarification":
      return t("taskCreate.needsClarification");
    case "detail_exists":
      return t("savedDetails.exists");
    case "refused":
      return phase.reason === "profile_fact"
        ? t("savedDetails.profileFact")
        : t("taskActions.refused");
    case "unavailable":
      return t("taskActions.unavailable");
    case "signed_out":
      return t("taskActions.signedOut");
    default:
      return null;
  }
}

function CommandCard({
  messageId,
  saved,
  store,
  canWrite,
  onViewTask,
  titleFor,
  onViewDetails,
}: {
  messageId: number;
  saved: TaskReceipt | null;
  store: TaskActionStore | null;
  canWrite: boolean;
  onViewTask: (taskRef: string) => void;
  titleFor: (taskRef: string) => string | null;
  onViewDetails?: () => void;
}) {
  const { t } = useTranslation();
  const key = `command:${messageId}`;
  const phase = useTaskActionPhase(store, key);
  const receipt = phase.phase === "saved"
    ? saved?.operationId === phase.receipt.operationId
      ? {
          ...phase.receipt,
          current: saved.current,
          undoable: saved.undoable,
          undoneBy: saved.undoneBy,
        }
      : phase.receipt
    : saved;
  // #370: a remember command's receipt (and its Undo) is a saved-detail receipt.
  const detailReceipt = receipt?.detail
    ? receipt
    : phase.phase === "undo_review" || phase.phase === "already_undone"
      ? saved
      : null;
  if (detailReceipt?.detail) {
    return (
      <DetailCommandResult
        receipt={detailReceipt}
        storeKey={key}
        store={store}
        onViewDetails={onViewDetails}
      />
    );
  }
  if (
    receipt &&
    (receipt.operationType === "task.edit_details" ||
      receipt.operationType === "task.set_state")
  ) {
    // #365: a clear edit command's saved change, named field by field.
    const title =
      receipt.title ?? titleFor(receipt.taskRef) ?? t("taskEdit.unknownTask");
    return (
      <article
        aria-label={editReceiptText(t as never, receipt, title)}
        className={CARD}
      >
        <CardIcon />
        <div className="min-w-0 flex-1" role="status">
          <p className="break-words text-sm text-ink-secondary">
            {editReceiptText(t as never, receipt, title)}
          </p>
          {receiptChanges(receipt).map((change) => (
            <p
              key={change.field}
              className="break-words text-xs text-ink-tertiary"
            >
              {receiptChangeText(t as never, change)}
            </p>
          ))}
          {!receipt.current && (
            <p className="text-xs text-ink-muted">
              {t("taskActions.receiptHistorical")}
            </p>
          )}
        </div>
        <CardButton
          label={t("taskCreate.view")}
          name={t("taskEdit.viewA11y", { title })}
          onClick={() => onViewTask(receipt.taskRef)}
        />
      </article>
    );
  }
  if (receipt) {
    const title = receipt.title ?? "";
    return (
      <article
        aria-label={t("taskCreate.addedCardA11y", { title })}
        className={CARD}
      >
        <CardIcon />
        <p
          className="min-w-0 flex-1 break-words text-sm text-ink-secondary"
          role="status"
        >
          {receipt.operationType === "task.remove_created"
            ? t("taskCreate.removed", { title })
            : t("taskCreate.added", { title })}
        </p>
        <CardButton
          label={t("taskCreate.view")}
          name={t("taskCreate.view")}
          onClick={() => onViewTask(receipt.taskRef)}
        />
      </article>
    );
  }
  const text = commandText(t as never, phase, titleFor);
  if (!text) return null;
  return (
    <div
      className={cn(CARD, isTransient(phase) && "loading-delayed")}
      role="status"
    >
      <CardIcon />
      <p className="min-w-0 flex-1 break-words text-sm text-ink-tertiary">
        {text}
      </p>
      {(phase.phase === "pending" || phase.phase === "lookup_failed") && (
        <CardButton
          label={t("taskActions.checkAgain")}
          name={t("taskActions.checkAgain")}
          onClick={() => void store?.checkAgain(key)}
        />
      )}
      {phase.phase === "not_applied" && (
        <CardButton
          label={t("taskActions.retry")}
          name={t("taskActions.retry")}
          disabled={!canWrite}
          onClick={() => canWrite && void store?.retry(key)}
        />
      )}
    </div>
  );
}
